+#define WINMASK_BG0    (1 << 0)
+#define WINMASK_BG1    (1 << 1)
+#define WINMASK_BG2    (1 << 2)
+#define WINMASK_BG3    (1 << 3)
+#define WINMASK_OBJ    (1 << 4)
