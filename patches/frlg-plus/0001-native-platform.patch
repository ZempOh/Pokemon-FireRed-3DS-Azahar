+            case 0x40:  // half
+                gb.Vol[2] = gb.VolI[2] = 2;
+            break;
+            case 0x60:  // quarter
+                gb.Vol[2] = gb.VolI[2] = 1;
+            break;
+            case 0x80:  // 3 quarters
