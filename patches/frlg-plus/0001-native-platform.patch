+// chosen, an opponent still standing faints. EXP and prize money as usual.
+// Not in link, Safari, ghost, the old man's or the Pokedude's battles.
+static bool8 TryCheatFaintOpponent(void)
+{
+    u8 battler;
+
+    if (!CtrExtras_Get("instant_victory") || gBattleControllerExecFlags
+     || (gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_SAFARI | BATTLE_TYPE_OLD_MAN_TUTORIAL
+                             | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_GHOST)))
+        return FALSE;
+    for (battler = 0; battler < gBattlersCount; battler++)
+    {
+        if (gBattleCommunication[battler] != STATE_BEFORE_ACTION_CHOSEN)
+            return FALSE;
+    }
+    for (battler = 0; battler < gBattlersCount; battler++)
