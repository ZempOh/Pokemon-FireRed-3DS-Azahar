+// Parts of this code heavily borrowed from NanoboyAdvance.
+#ifdef PORT_BRIDGE
+// The UI layer's pass over the 3D field: only the screen's sprites, those not
+// under the map (DrawFrame).
+extern bool8 gPortOamScreen[128];
+static bool8 sScreenObjOnly;
+static u8 sScreenObjMaxPriority;
+#endif
+
+// The frame's sprites, by priority (highest index first, the drawing
+// order), each with the lines it covers: a line looks only at those, not at
+// all 128 entries four times over - most of them the game's hidden dummies.
+// Built from OAM when a frame starts (BuildSpriteLists): the game writes OAM
+// in VBlank, never between the lines.
+static u8 sObjList[4][128];
+static u8 sObjCount[4];
+static s16 sObjTop[128], sObjBottom[128];
+
+static void BuildSpriteLists(void)
+{
+    sObjCount[0] = sObjCount[1] = sObjCount[2] = sObjCount[3] = 0;
+    for (int i = 127; i >= 0; i--)
+    {
+        struct OamData *oam = &((struct OamData *)OAM)[i];
+        int height, y;
+
+        if (oam->objMode == 2 || oam->shape == 3)
+            continue;
+        if (!(oam->affineMode & 1) && (oam->affineMode & 2))
+            continue;               // a non-affine sprite with bit 9: hidden
+        height = oam->shape == 0 ? (8 << oam->size)
+               : oam->shape == 1 ? spriteSizes[oam->size][0] : spriteSizes[oam->size][1];
+        if ((oam->affineMode & 1) && (oam->affineMode & 2))
+            height *= 2;            // an affine sprite's double size
+        y = oam->y;
+        if (y >= DISPLAY_HEIGHT)
+            y -= 256;
+        if (y + height <= 0 || y >= DISPLAY_HEIGHT)
+            continue;
+        sObjTop[i] = y;
+        sObjBottom[i] = y + height;
+        sObjList[oam->priority][sObjCount[oam->priority]++] = i;
+    }
+}
+
+static void DrawSprites(struct scanlineData* scanline, uint16_t vcount, bool windowsEnabled, uint8_t priority, uint16_t* pixels, bool IsInsideWinIn)
+{
+    int SpriteIndex;
+    
+    if (windowsEnabled == true && IsInsideWinIn == false)
+    {
+        if (!(REG_WINOUT & WINOUT_WIN01_OBJ))
+            return;
+    }
+
+    if (!(REG_DISPCNT & (1 << 6)))
+    {
+        puts("2-D OBJ Character mapping not supported.");
+    }
+
+    for (int n = 0; n < sObjCount[priority]; n++)
+    {
+        struct OamData *oam;
+
+        SpriteIndex = sObjList[priority][n];
+        if (vcount < sObjTop[SpriteIndex] || vcount >= sObjBottom[SpriteIndex])
+            continue;
+        oam = &((struct OamData *)OAM)[SpriteIndex];
+#ifdef PORT_BRIDGE
+        if (sScreenObjOnly && (!gPortOamScreen[SpriteIndex] || oam->priority > sScreenObjMaxPriority))
+            continue;
+#endif
+        
+        if (oam->affineMode & 1 || oam->bpp & 1 || oam->mosaic == 1)
+            DrawAffineSprite(SpriteIndex, scanline, vcount, windowsEnabled, pixels, IsInsideWinIn);
+        else
+            DrawNonAffineSprite(SpriteIndex, scanline, vcount, windowsEnabled, pixels, IsInsideWinIn);
+    }
+}
+
+static void DrawScanline(uint16_t *pixels, uint16_t vcount)
+{
+    unsigned int mode = REG_DISPCNT & 3;
+    unsigned char numOfBgs = (mode == 0 ? 4 : 3);
+    int bgnum, prnum;
+    struct scanlineData scanline;
+    unsigned int blendMode = (REG_BLDCNT >> 6) & 3;
+    unsigned int xpos;
+
+
+    //initialize all priority bookkeeping data
+    memset(scanline.prioritySortedBgsCount, 0, sizeof(scanline.prioritySortedBgsCount));
+    
+    //windows code!!!
+    bool windowsEnabled = false;
+    bool IsInsideWinIn;
+    uint16_t WIN0bottom, WIN0top, WIN0right, WIN0left;
+    uint16_t WIN1bottom, WIN1top, WIN1right, WIN1left;
+    bool WIN0enable, WIN1enable;
+    WIN0enable = false;
+    WIN1enable = false;
+
+    //figure out if WIN0 masks on this scanline
+    if (REG_DISPCNT & DISPCNT_WIN0_ON)
+    {
+        //acquire the window coordinates
+        WIN0bottom = (REG_WIN0V & 0xFF); //y2;
+        WIN0top = (REG_WIN0V & 0xFF00) >> 8; //y1;
+        WIN0right = (REG_WIN0H & 0xFF); //x2
+        WIN0left = (REG_WIN0H & 0xFF00) >> 8; //x1
+        
+        //figure out WIN Y wraparound and check bounds accordingly
+        if (WIN0top > WIN0bottom) {
+            if (vcount >= WIN0top || vcount < WIN0bottom)
+                WIN0enable = true;
+        } else {
+            if (vcount >= WIN0top && vcount < WIN0bottom)
+                WIN0enable = true;
+        }
+        
+        windowsEnabled = true;
+    }
+    //figure out if WIN1 masks on this scanline
+    if (REG_DISPCNT & DISPCNT_WIN1_ON)
+    {
+        // WIN1's own registers (this read WIN0's, which hid every scene
+        // that opens its picture through window 1)
+        WIN1bottom = (REG_WIN1V & 0xFF); //y2;
+        WIN1top = (REG_WIN1V & 0xFF00) >> 8; //y1;
+        WIN1right = (REG_WIN1H & 0xFF); //x2
+        WIN1left = (REG_WIN1H & 0xFF00) >> 8; //x1
+        
+        if (WIN1top > WIN1bottom) {
+            if (vcount >= WIN1top || vcount < WIN1bottom)
+                WIN1enable = true;
+        } else {
+            if (vcount >= WIN1top && vcount < WIN1bottom)
+                WIN1enable = true;
+        }
+        
+        windowsEnabled = true;
+    }
+    //enable windows if OBJwin is enabled
+    if (REG_DISPCNT & DISPCNT_OBJWIN_ON && REG_DISPCNT & DISPCNT_OBJ_ON)
+        windowsEnabled = true;
+    
+    IsInsideWinIn = (WIN0enable || WIN1enable || (REG_DISPCNT & DISPCNT_OBJWIN_ON && REG_DISPCNT & DISPCNT_OBJ_ON));
+    
+    
+    //draw to pixel mask
+    if (IsInsideWinIn)
+    {
+        for (xpos = 0; xpos < DISPLAY_WIDTH; xpos++)
+        {
+            //win0 checks
+            if (WIN0enable && winCheckHorizontalBounds(WIN0left, WIN0right, xpos))
+                scanline.winMask[xpos] = REG_WININ & 0x3F;
+            //win1 checks
+            else if (WIN1enable && winCheckHorizontalBounds(WIN1left, WIN1right, xpos))
+                scanline.winMask[xpos] = (REG_WININ >> 8) & 0x3F;
+            else
+                scanline.winMask[xpos] = (REG_WINOUT & 0x3F) | WINMASK_WINOUT;
+        }
+    }
+    
+    //draw to window mask if OBJwin is enabled
+    if (REG_DISPCNT & DISPCNT_OBJWIN_ON && REG_DISPCNT & DISPCNT_OBJ_ON)
+        DrawSpritesWinMask(&scanline, vcount);
+    
+    //init bgmask for alpha blending
+    for (int i = 0; i < DISPLAY_WIDTH; i++)
+    {
+        scanline.bgMask[i] = 0x20; //backdrop bit
+    }
+
+    for (bgnum = 0; bgnum < numOfBgs; bgnum++)
+    {
+        uint16_t bgcnt = *(uint16_t*)(REG_ADDR_BG0CNT + bgnum * 2);
+        uint16_t priority;
+        scanline.bgcnts[bgnum] = bgcnt;
+        scanline.bgtoprio[bgnum] = priority = (bgcnt & 3);
+        
+        char priorityCount = scanline.prioritySortedBgsCount[priority];
+        scanline.prioritySortedBgs[priority][priorityCount] = bgnum;
+        scanline.prioritySortedBgsCount[priority]++;
+    }
+    
+    switch (mode)
+    {
+    case 0:
+        for (prnum = 3; prnum >= 0; prnum--)
+        {
+            for (char prsub = scanline.prioritySortedBgsCount[prnum] - 1; prsub >= 0; prsub--)
+            {
+                bgnum = scanline.prioritySortedBgs[prnum][prsub];
+                if (isbgEnabled(bgnum))
+                {
+                    uint16_t bghoffs = *(uint16_t *)(REG_ADDR_BG0HOFS + bgnum * 4);
+                    uint16_t bgvoffs = *(uint16_t *)(REG_ADDR_BG0VOFS + bgnum * 4);
+                    bool doesBGblend = (blendMode != 0 && REG_BLDCNT & (1 << bgnum));
+                    
+                    if (scanline.bgcnts[bgnum] & BGCNT_256COLOR)
+                        RenderBGScanline8bpp(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels,
+                                             &scanline, windowsEnabled, IsInsideWinIn, doesBGblend);
+                    else if (IsInsideWinIn)
+                    {
+                        //blending check
+                        if (doesBGblend)
+                            RenderBGScanlineWinBlend(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                        else
+                            RenderBGScanlineWin(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                        
+                    } else {
+                        
+                        if (doesBGblend && (windowsEnabled == false || (REG_WINOUT & WINOUT_WIN01_CLR)) )
+                            RenderBGScanlineBlend(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                        else
+                            RenderBGScanlineNoEffect(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                    }
+                
+                }
+            }
+            if (REG_DISPCNT & DISPCNT_OBJ_ON)
+                DrawSprites(&scanline, vcount, windowsEnabled, prnum, pixels, IsInsideWinIn);
+        }
+        
+        break;
+    case 1:
+        for (prnum = 3; prnum >= 0; prnum--)
+        {
+            for (char prsub = scanline.prioritySortedBgsCount[prnum] - 1; prsub >= 0; prsub--)
+            {
+                bgnum = scanline.prioritySortedBgs[prnum][prsub];
+                if (isbgEnabled(bgnum))
+                {
+                    uint16_t bghoffs = *(uint16_t *)(REG_ADDR_BG0HOFS + bgnum * 4);
+                    uint16_t bgvoffs = *(uint16_t *)(REG_ADDR_BG0VOFS + bgnum * 4);
+                    bool doesBGblend = (blendMode != 0 && REG_BLDCNT & (1 << bgnum));
+                    
+                    
+                    if (bgnum != 2)
+                    {
+                        if (scanline.bgcnts[bgnum] & BGCNT_256COLOR)
+                            RenderBGScanline8bpp(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels,
+                                                 &scanline, windowsEnabled, IsInsideWinIn, doesBGblend);
+                        else if (IsInsideWinIn)
+                        {
+                            //blending check
+                            if (doesBGblend)
+                                RenderBGScanlineWinBlend(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                            else
+                                RenderBGScanlineWin(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                            
+                        } else {
+                            
+                            if (doesBGblend)
+                                RenderBGScanlineBlend(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                            else
+                                RenderBGScanlineNoEffect(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                        }
+                    }
+                    else
+                    {
+                        if (IsInsideWinIn)
+                        {
+                            //blending check
+                            if (doesBGblend)
+                                RenderRotScaleBGScanlineWinBlend(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                            else
+                                RenderRotScaleBGScanlineWin(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                            
+                        } else {
+                            
+                            if (doesBGblend && (windowsEnabled == false || (REG_WINOUT & WINOUT_WIN01_CLR)))
+                                RenderRotScaleBGScanlineBlend(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                            else
+                                RenderRotScaleBGScanlineNoEffect(bgnum, scanline.bgcnts[bgnum], bghoffs, bgvoffs, vcount, pixels, &scanline, windowsEnabled);
+                        }
+                    }
+                }
+            }
+            if (REG_DISPCNT & DISPCNT_OBJ_ON)
+                DrawSprites(&scanline, vcount, windowsEnabled, prnum, pixels, IsInsideWinIn);
+        }
+        break;
+    default:
+        DBGPRINTF("Video mode %u is unsupported.\n", mode);
+        break;
+    }
+}
+
+uint16_t *memsetu16(uint16_t *dst, uint16_t fill, size_t count)
+{
+    for (int i = 0; i < count; i++)
+    {
+        *dst++ = fill;
+    }
+}
+
+unsigned int frameskipcounter = 0;
+
+#ifdef PORT_BRIDGE
+// The 3DS port's voxel overworld draws the map in 3D: alongside each line it
+// asks for the layers that go over the world (the message box on BG0) alone,
+// where a pixel no layer drew is left without bit 15, see-through.
+uint16_t *gPortUiPixels;
+uint16_t gPortUiLayers = DISPCNT_BG0_ON;
+// Whether a UI layer under the map's priority is left out (the field); the
+// 3D battle asks for its layers whole (gPortUiLayers: all but the scenery).
+bool8 gPortUiTrim = TRUE;
+// Sprites go over the world too, where a window shows them (a field move's
+// banner, its Pokemon in it): outside the windows the world draws its own.
+bool8 gPortUiObjInWindows = FALSE;
+// Sprites on the screen (gPortOamScreen, sprite.c: a message's picture, the
+// rain) go over the world everywhere, those not under the map's layers: the
+// field's own are drawn in 3D.
+bool8 gPortUiScreenObj = FALSE;
+// Which pictures the lines are drawn into this frame: none for a frame fast
+// forward does not show, the UI layer alone when the 3D world stands in for
+// the picture. The lines' interrupts and HBlank DMA run either way.
+#define PORT_DRAW_FRAME 1
+#define PORT_DRAW_UI 2
+u8 gPortDrawLines = PORT_DRAW_FRAME | PORT_DRAW_UI;
+#endif
+
+#ifdef PORT_BRIDGE
+// Whether the field's UI layer has nothing to draw this frame: BG0 off,
+// under the map or all blank tiles, and no sprite going over the world. Then
+// its lines are not drawn: it is cleared once and stays clear - most of the
+// time in the field, out of a message, the pass was most of the lines' work.
+static bool8 sUiBlank;
+
+static bool8 UiHasNothing(void)
+{
+    uint16_t display = REG_DISPCNT, bgcnt = REG_BG0CNT;
+    unsigned mapPriority = 3, entries;
+    const uint16_t *map;
+    const uint32_t *chars;
+    unsigned words, last = 0xFFFF;
+
+    if (!gPortUiTrim || gPortUiLayers != DISPCNT_BG0_ON)
+        return FALSE;
+    if (gPortUiObjInWindows && (display & (DISPCNT_WIN0_ON | DISPCNT_WIN1_ON)))
+        return FALSE;
+    if (gPortUiScreenObj)
+        for (int p = 0; p < 4; p++)
+            for (int n = 0; n < sObjCount[p]; n++)
+                if (gPortOamScreen[sObjList[p][n]])
+                    return FALSE;
+    if (!(display & DISPCNT_BG0_ON))
+        return TRUE;
+    for (int bg = 1; bg < 4; bg++)
+        if ((display & (DISPCNT_BG0_ON << bg)) && (*(vu16 *)(REG_ADDR_BG0CNT + bg * 2) & 3) < mapPriority)
+            mapPriority = *(vu16 *)(REG_ADDR_BG0CNT + bg * 2) & 3;
+    if ((bgcnt & 3) > mapPriority)
+        return TRUE;
+    map = (const uint16_t *)BG_SCREEN_ADDR((bgcnt >> 8) & 0x1F);
+    chars = (const uint32_t *)BG_CHAR_ADDR((bgcnt >> 2) & 3);
+    entries = 1024u * (bgcnt >> 14 == 0 ? 1 : bgcnt >> 14 == 3 ? 4 : 2);
+    words = (bgcnt & BGCNT_256COLOR) ? 16 : 8;
+    for (unsigned e = 0; e < entries; e++)
+    {
+        unsigned tile = map[e] & 0x3FF;
+
+        if (tile == last)
+            continue;
+        for (unsigned w = 0; w < words; w++)
+            if (chars[tile * words + w] != 0)
+                return FALSE;
+        last = tile;
+    }
+    return TRUE;
+}
+#endif
+
+void DrawFrame(uint16_t *pixels)
+{
+    int i;
+    int j;
+    
+    //memsetu16(pixels, *(uint16_t *)PLTT, DISPLAY_WIDTH * DISPLAY_HEIGHT);
+
+    BuildSpriteLists();
+#ifdef PORT_BRIDGE
+    {
+        bool8 blank = gPortUiPixels != NULL && (gPortDrawLines & PORT_DRAW_UI) && UiHasNothing();
+
+        if (blank && !sUiBlank)
+            memset(gPortUiPixels, 0, DISPLAY_WIDTH * DISPLAY_HEIGHT * sizeof(uint16_t));
+        sUiBlank = blank;
+    }
+#endif
+    for (i = 0; i < DISPLAY_HEIGHT; i++)
+    {
+        REG_VCOUNT = i;
+        if(((REG_DISPSTAT >> 8) & 0xFF) == REG_VCOUNT)
+        {
+            REG_DISPSTAT |= INTR_FLAG_VCOUNT;
+            if(REG_DISPSTAT & DISPSTAT_VCOUNT_INTR)
+                    gIntrTable[0]();
+        }
+        
+        // backdrop color brightness effects
+        unsigned int blendMode = (REG_BLDCNT >> 6) & 3;
+        uint16_t backdropColor = *(uint16_t *)PLTT;
+        if (REG_BLDCNT & BLDCNT_TGT1_BD)
+        {
+            switch (blendMode)
+            {
+            case 2:
+                backdropColor = alphaBrightnessIncrease(backdropColor);
+                break;
+            case 3:
+                backdropColor = alphaBrightnessDecrease(backdropColor);
+                break;
+            }
+        }
+        
+#ifdef PORT_BRIDGE
+        if (gPortDrawLines & PORT_DRAW_FRAME)
+#endif
+        {
+            memsetu16(&pixels[i*DISPLAY_WIDTH], backdropColor, DISPLAY_WIDTH);
+            DrawScanline(&pixels[i*DISPLAY_WIDTH], i);
+        }
+#ifdef PORT_BRIDGE
+        if (gPortUiPixels != NULL && (gPortDrawLines & PORT_DRAW_UI) && !sUiBlank)
+        {
+            uint16_t display = REG_DISPCNT, layers = gPortUiLayers;
+            unsigned mapPriority = 3;
+
+            // A UI background goes over the world only where it is over the
+            // map on the GBA too: interiors keep a black BG0 behind the map.
+            for (int bg = 1; bg < 4 && gPortUiTrim; bg++)
+                if ((display & (DISPCNT_BG0_ON << bg)) && (*(vu16 *)(REG_ADDR_BG0CNT + bg * 2) & 3) < mapPriority)
+                    mapPriority = *(vu16 *)(REG_ADDR_BG0CNT + bg * 2) & 3;
+            for (int bg = 0; bg < 4 && gPortUiTrim; bg++)
+                if ((layers & (DISPCNT_BG0_ON << bg)) && (*(vu16 *)(REG_ADDR_BG0CNT + bg * 2) & 3) > mapPriority)
+                    layers &= ~(DISPCNT_BG0_ON << bg);
+            uint16_t winout = REG_WINOUT;
+
+            if (gPortUiObjInWindows && (display & (DISPCNT_WIN0_ON | DISPCNT_WIN1_ON)))
+            {
+                layers |= DISPCNT_OBJ_ON;
+                REG_WINOUT = winout & ~WINOUT_WIN01_OBJ;
+            }
+            else if (gPortUiScreenObj)
+            {
+                layers |= DISPCNT_OBJ_ON;
+                sScreenObjOnly = TRUE;
+                sScreenObjMaxPriority = mapPriority;
+            }
+            REG_DISPCNT = (display & ~(DISPCNT_BG_ALL_ON | DISPCNT_OBJ_ON)) | (display & layers);
+            memsetu16(&gPortUiPixels[i * DISPLAY_WIDTH], 0, DISPLAY_WIDTH);
+            DrawScanline(&gPortUiPixels[i * DISPLAY_WIDTH], i);
+            REG_DISPCNT = display;
+            REG_WINOUT = winout;
+            sScreenObjOnly = FALSE;
+        }
+#endif
+        
+        REG_DISPSTAT |= INTR_FLAG_HBLANK;
+
+        RunDMAs(DMA_HBLANK);
+        
+        if (REG_DISPSTAT & DISPSTAT_HBLANK_INTR)
+            gIntrTable[3]();
+
+        REG_DISPSTAT &= ~INTR_FLAG_HBLANK;
+        REG_DISPSTAT &= ~INTR_FLAG_VCOUNT;
+    }
+}
+#endif
