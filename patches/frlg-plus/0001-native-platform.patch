+#define getGreenChannel(x) ((x >>  5) & 0x1F)
+#define getBlueChannel(x) ((x >>  10) & 0x1F)
+#define isbgEnabled(x) ((REG_DISPCNT >> 8) & 0xF) & (1 << x)
