+#ifdef PLATFORM_3DS
+extern u8 __ctr_gamedata[], __ctr_gamedata_end[];
+
+static bool8 IsInWildGameData(const void *ptr, size_t size)
+{
+    uintptr_t address = (uintptr_t)ptr;
+    uintptr_t start = (uintptr_t)__ctr_gamedata;
+    uintptr_t end = (uintptr_t)__ctr_gamedata_end;
+    return address >= start && address <= end && size <= end - address;
+}
+
+static bool8 IsValidWildCryTable(const struct WildPokemonInfo *info, size_t count)
+{
+    return (uintptr_t)info % _Alignof(struct WildPokemonInfo) == 0
+        && IsInWildGameData(info, sizeof(*info))
+        && (uintptr_t)info->wildPokemon % _Alignof(struct WildPokemon) == 0
+        && IsInWildGameData(info->wildPokemon, count * sizeof(*info->wildPokemon));
+}
+#endif
