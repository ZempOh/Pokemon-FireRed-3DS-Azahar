+#ifdef PLATFORM_3DS
+//------------------------------------------------------------------------------
+//  Touch on the BUY screen, on the 3DS bottom screen (CTR_CENTRED_SHOP), as
+//  the bag's (item_menu.c): 3ds_bottom_ui.c hands over the touches in pixels
