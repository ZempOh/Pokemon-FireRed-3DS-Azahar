+++ b/gamedata/gen3/hacks/pokeclassic.toml
@@ -0,0 +1,33 @@
+# Classic v1.5.1, DaniRainbow/pokeclassic at 02be0b670d9548b3d12c769faa051853df7fe19d.
+# All addresses are from the ELF that rebuilt SHA-1 7e27a7878d6aeb3b798757f98e60d1064d762dbb.
+# The 100-byte party layout and 8-byte BagPocket stride are preserved. The gBagPockets
+# order follows Classic's include/constants/item.h. Treasures use the generic Items group.
+[config.pokeclassic_v1_5_1]
+base = 'emerald'
+gameCode = 'POKECLASSIC'
+playerParty = 0x02023628
+playerPartyCount = 0x02023625
+battleMons = 0x020230F8
+battlerPositions = 0x020230EA
+battlersCount = 0x020230E0
+battleTypeFlags = 0x02023060
+gMain = 0x030022C0
+saveBlock1Ptr = 0x03005D8C
+saveBlock2Ptr = 0x03005D90
+objectEvents = 0x02035D58
+mapHeader = 0x02035CA0
+bagPockets = 0x02038830
+bagPocketCount = 8
+bagPocketOrder = 'POKECLASSIC_BAG_POCKET_ORDER'
+monIconTable = 0x088E473C
+monIconPaletteIndices = 0x088E4E60
+monIconPaletteTable = 0x088E502C
+itemIconTable = 0x0898D908
+itemDescs = { preset = 'vanilla', base = 0x088ED5A0, count = 430 }
+battlerControllerFuncs = 0
+handleInputChooseAction = 0
+handleInputChooseMove = 0
+completeWhenChoseItem = 0
+waitForMonSelection = 0
+handleInputChooseTarget = 0
+eggSpecies = 429
