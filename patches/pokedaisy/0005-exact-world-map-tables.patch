+    /** Classic v1.5.1 keeps a single Emerald-format region map with its own cursor grid and names. */
+    private fun readClassic(rom: Rom): Parsed? {
+        // sRegionMapBg_GfxLZ, sRegionMapBg_TilemapLZ, sRegionMapBg_Pal, sRegionMap_MapSectionLayout.
+        val tiles = lz(rom, 0x910460)?.takeIf { it.size % 64 == 0 } ?: return null
+        val map = lz(rom, 0x910DAC)?.takeIf { it.size == 64 * 64 } ?: return null
+        val palette = RomArt.palette(rom.read(0x910420, 0x40)).takeIf { it.size == 32 } ?: return null
+        val grid = rom.read(0x9110C8, 28 * 15).takeIf { it.size == 28 * 15 } ?: return null
+        val entries = 0x912174 // gRegionMapEntries, {u8 x, y, width, height; const u8 *name}
+        val sections = buildMap {
+            for (mapsec in 0 until HACK_MAPSEC_NONE) {
+                val off = entries + mapsec * 8
+                val namePtr = ptr(rom, off + 4) ?: continue
+                val name = titleCase(Gen3Text.decode(rom.read(namePtr, 32)))
+                if (name.isEmpty()) continue
+                val bounds = rom.read(off, 4)
+                val x = (bounds[0].toInt() and 0xFF) + 1
+                val y = (bounds[1].toInt() and 0xFF) + 2
+                val w = bounds[2].toInt() and 0xFF
+                val h = bounds[3].toInt() and 0xFF
+                val visible = grid.any { (it.toInt() and 0xFF) == mapsec } && x + w <= 30 && y + h <= 20
+                put(mapsec, if (visible) MapSecInfo(name, 0, x, y, w, h) else MapSecInfo(name, 0, 0, 0, 0, 0))
+            }
+        }
+        val image = RomArt.emeraldRegionMap(tiles, palette, map)
+        val layout = RegionLayout(1, 2, 28, 15, HACK_MAPSEC_NONE, listOf(grid))
+        return Parsed(listOf(image), sections, listOf(layout))
+    }
