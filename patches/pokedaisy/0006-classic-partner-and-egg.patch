+package com.pokedaisy.app.companion.data
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PokeClassicPartyTest {
+    @Test
+    fun partnerAndEggUseClassicSpeciesIds() {
+        val previousGame = activeGame
+        val previousCode = romGameCode
+        val partner = Mon(412, 5, 18, 21, 0, intArrayOf(), intArrayOf())
+        try {
+            activeGame = GameKind.EMERALD
+            romGameCode = "POKECLASSIC"
+            val view = partyMonView(partner)
+            assertEquals("PIKACHU", view.name)
+            assertFalse(view.isEgg)
+            assertEquals(18 to 21, view.hp to view.maxHp)
+            assertTrue(partyMonView(partner.copy(species = 429)).isEgg)
+            assertTrue(partyMonView(partner.copy(species = 25, isEgg = true)).isEgg)
+
+            romGameCode = ""
+            assertTrue(partyMonView(partner).isEgg)
+        } finally {
+            romGameCode = previousCode
+            activeGame = previousGame
+        }
+    }
+}
