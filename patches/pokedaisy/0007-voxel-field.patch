+    if ((unsigned) x < (unsigned) s->vw && (unsigned) y < (unsigned) s->vh) {
+        int layer = s->vmap[y * s->vw + x] >> 12;
+        if (layer > 0 && layer < 15) elevation = layer;
+    }
+    int z = 4 * (elevation - 1);
+    return z > VOXEL_MAX_RISE ? VOXEL_MAX_RISE : z;
+}
