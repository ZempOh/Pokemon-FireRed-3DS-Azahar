diff --git a/app/src/main/cpp/pk_wide_voxel.h b/app/src/main/cpp/pk_wide_voxel.h
new file mode 100644
index 0000000..ccc2d8e
--- /dev/null
+++ b/app/src/main/cpp/pk_wide_voxel.h
@@ -0,0 +1,113 @@
+// Private software renderer for the live GBA field view in pk_wide.c.
+#pragma once
+
+#include <stdint.h>
+
+#define VOXEL_TILE 16
+#define VOXEL_MAX_RISE 20
+#define VOXEL_MAX_W 480
+#define VOXEL_MAX_H 400
+
+struct VoxelView {
+    uint32_t* out;
+    uint16_t* depth;
+    const uint32_t* texture;
+    int width, height;
+    int centreX, centreY;
+    int left, top, cols, rows, stride;
+    const uint8_t* rises;
+};
+
+static int voxelFloor(int n, int d) {
+    return n >= 0 ? n / d : (n + 1) / d - 1;
+}
+
+static int voxelX(const struct VoxelView* v, int x, int y) {
+    return v->width / 2 + x - v->centreX + voxelFloor(y - v->centreY, 4);
+}
+
+static int voxelY(const struct VoxelView* v, int y, int z) {
+    return v->height / 2 + voxelFloor(3 * (y - v->centreY), 4) - z;
+}
+
+static int voxelWorldY(const struct VoxelView* v, int y, int z) {
+    return v->centreY + voxelFloor(4 * (y - v->height / 2 + z) + 3, 3);
+}
+
+static int voxelRise(const struct VoxelView* v, int col, int row) {
+    if ((unsigned) col >= (unsigned) v->cols || (unsigned) row >= (unsigned) v->rows) return 0;
+    return v->rises[row * v->cols + col];
+}
+
+static int voxelRiseAt(const struct VoxelView* v, int x, int y) {
+    return voxelRise(v, voxelFloor(x - v->left, VOXEL_TILE), voxelFloor(y - v->top, VOXEL_TILE));
+}
+
+static void voxelPixel(const struct VoxelView* v, int x, int y, int worldY, uint32_t color) {
+    if ((unsigned) x >= (unsigned) v->width || (unsigned) y >= (unsigned) v->height) return;
+    int i = y * v->width + x;
+    int depth = worldY - v->top + 1;
+    if (depth < v->depth[i]) return;
+    v->out[i] = color;
+    v->depth[i] = (uint16_t) depth;
+}
+
+static uint32_t voxelShade(uint32_t color, unsigned strength) {
+    uint32_t rb = ((color & 0x00FF00FFu) * strength >> 8) & 0x00FF00FFu;
+    uint32_t g = ((color & 0x0000FF00u) * strength >> 8) & 0x0000FF00u;
+    return (color & 0xFF000000u) | rb | g;
+}
+
+static void voxelTerrain(const struct VoxelView* v) {
+    // The floor fills the output. The projection bounds in pk_wide.c include every sample.
+    for (int y = 0; y < v->height; y++) {
+        int worldY = voxelWorldY(v, y, 0);
+        int worldX = v->centreX - v->width / 2 - voxelFloor(worldY - v->centreY, 4);
+        int at = y * v->width;
+        const uint32_t* src = v->texture + (worldY - v->top) * v->stride + worldX - v->left;
+        for (int x = 0; x < v->width; x++) {
+            v->out[at + x] = src[x];
+            v->depth[at + x] = (uint16_t) (worldY - v->top + 1);
+        }
+    }
+
+    for (int row = 0; row < v->rows; row++) {
+        int y0 = v->top + row * VOXEL_TILE, y1 = y0 + VOXEL_TILE;
+        for (int col = v->cols - 1; col >= 0; col--) {
+            int rise = voxelRise(v, col, row);
+            if (!rise) continue;
+            int x0 = v->left + col * VOXEL_TILE;
+            int left = voxelRise(v, col - 1, row), front = voxelRise(v, col, row + 1);
+            int base = voxelY(v, y0, rise);
+            // West wall, seen along the slanted grid lines.
+            if (rise > left) {
+                int xStart = voxelX(v, x0, y0), xEnd = voxelX(v, x0, y1 - 1);
+                for (int x = xStart; x <= xEnd; x++) {
+                    int first = v->centreY + 4 * (x - (v->width / 2 + x0 - v->centreX));
+                    int worldY = first + 3 < y1 ? first + 3 : y1 - 1;
+                    int top = voxelY(v, first > y0 ? first : y0, rise);
+                    int bottom = voxelY(v, worldY, left);
+                    uint32_t color = v->texture[(worldY - v->top) * v->stride + col * VOXEL_TILE];
+                    color = voxelShade(color, 155);
+                    for (int y = top; y <= bottom; y++) voxelPixel(v, x, y, worldY, color);
+                }
+            }
+            // South wall, continuing the color of the live texture's front edge.
+            if (rise > front) {
+                int x = voxelX(v, x0, y1), top = voxelY(v, y1, rise);
+                const uint32_t* src = v->texture + (row * VOXEL_TILE + VOXEL_TILE - 1) * v->stride + col * VOXEL_TILE;
+                for (int i = 0; i < VOXEL_TILE; i++) {
+                    uint32_t color = voxelShade(src[i], 192);
+                    for (int y = top; y < top + rise - front; y++) voxelPixel(v, x + i, y, y1, color);
+                }
+            }
+            // The top uses nearest-neighbor texels, including the engine's animated palette and tile data.
+            for (int y = base; y < voxelY(v, y1, rise); y++) {
+                int worldY = voxelWorldY(v, y, rise);
+                int x = voxelX(v, x0, worldY);
+                const uint32_t* src = v->texture + (worldY - v->top) * v->stride + col * VOXEL_TILE;
+                for (int i = 0; i < VOXEL_TILE; i++) voxelPixel(v, x + i, y, worldY, src[i]);
+            }
+        }
+    }
+}
