+    int top = voxelFloor(cy + v.y - margin - VOXEL_TILE, VOXEL_TILE) * VOXEL_TILE - cy;
+    int bottom = voxelFloor(cy + v.y + v.h + margin + 2 * VOXEL_MAX_RISE + VOXEL_TILE - 1, VOXEL_TILE)
