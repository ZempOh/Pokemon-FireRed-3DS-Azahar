+// Cosmetic presentation only. No game-memory writes or save-format changes.
+#pragma once
+#include <stdint.h>
+#include <time.h>
+#include <string.h>
+struct VoxelClimate { int config, season, weather; unsigned blend; uint64_t lastMs; };
+static struct VoxelClimate voxelClimate;
+static uint32_t climateMix(uint32_t a, uint32_t b, unsigned f) {
+    unsigned r = ((a & 255) * (256-f) + (b & 255) * f) >> 8;
+    unsigned g = (((a>>8)&255) * (256-f) + ((b>>8)&255) * f) >> 8;
+    unsigned bl = (((a>>16)&255) * (256-f) + ((b>>16)&255) * f) >> 8;
+    return (a & 0xff000000u) | r | (g<<8) | (bl<<16);
+}
+static uint64_t climateMs(void) {
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000 + ts.tv_nsec/1000000;
+}
+static void climateUpdate(int outdoor, int nativeWeather) {
+    uint64_t now = climateMs();
+    unsigned dt = voxelClimate.lastMs ? (unsigned)(now-voxelClimate.lastMs) : 0;
+    voxelClimate.lastMs = now;
+    if (dt > 100) dt = 100;
+    int mode = voxelClimate.config & 3;
+    int season = (voxelClimate.config>>2)&3, weather = (voxelClimate.config>>4)&7;
+    if (mode == 1) {
+        time_t t = time(NULL); struct tm tm;
+        localtime_r(&t, &tm);
+        season = ((tm.tm_mon + 10) % 12) / 3; // Mar-May spring, Dec-Feb winter.
+        weather = tm.tm_yday % 5 ? 1 : season == 3 ? 3 : 2;
+    }
+    if (weather > 4) weather = 0;
+    // Change the preset only at zero opacity; never interpolate through unrelated palettes.
+    int eligible = outdoor && !nativeWeather && mode != 0 && mode != 3;
+    int match = voxelClimate.season == season && voxelClimate.weather == weather;
+    unsigned step = (dt * 256 + 999)/1000;
+    if (!eligible || !match) {
+        voxelClimate.blend = voxelClimate.blend > step ? voxelClimate.blend-step : 0;
+        if (!voxelClimate.blend) { voxelClimate.season=season; voxelClimate.weather=weather; }
+    } else {
+        voxelClimate.blend += step;
+        if (voxelClimate.blend > 256) voxelClimate.blend=256;
+    }
+    // No residual weather or recoloring is carried into interiors or scripted effects.
+    if (!outdoor || nativeWeather) voxelClimate.blend=0;
+}
+static uint32_t climateTerrain(uint32_t c) {
+    if (!voxelClimate.blend) return c;
+    unsigned r=c&255, g=(c>>8)&255, b=(c>>16)&255;
+    // Select foliage hues only; protect water, stone, signs, paths and original sprite art.
+    if (g <= r+8 || g <= b+8) return c;
+    uint32_t target=c;
+    switch (voxelClimate.season) {
+    case 0: target=(c&0xff000000u) | ((r+18>255?255:r+18)) | ((g+10>255?255:g+10)<<8) | (b<<16); break;
+    case 1: return c;
+    case 2: target=(c&0xff000000u) | ((g*9/10)<<0) | ((g*3/4)<<8) | ((b/2)<<16); break;
+    case 3: target=climateMix(c,0x00e9dfd7u,150); break;
+    }
+    return climateMix(c,target,voxelClimate.blend);
+}
+static void climateAtmosphere(uint32_t* out, const uint32_t* depth, int w, int h) {
+    unsigned f=voxelClimate.blend;
+    if (!f) return;
+    int weather=voxelClimate.weather;
+    if (weather==4) {
+        for(int y=0;y<h;y++) for(int x=0;x<w;x++) {
+            int at=y*w+x;
+            if (depth[at]!=UINT32_MAX) out[at]=climateMix(out[at],0x00ddd8d0u,f*(unsigned)(h-y)/(unsigned)(h*5));
+        }
+    } else if(weather==2 || weather==3) {
+        unsigned tick=(unsigned)(voxelClimate.lastMs/(weather==2?24:70));
+        int count=(voxelClimate.config&128)?48:20;
+        for(int i=0;i<count;i++) {
+            unsigned seed=(unsigned)i*2654435761u;
+            int x=(int)((seed+tick*(weather==2?1:0))%(unsigned)w);
+            int y=(int)(((seed>>9)+tick*(weather==2?4:1))%(unsigned)h);
+            int len=weather==2?4:1;
+            for(int j=0;j<len && y+j<h;j++) {
+                int at=(y+j)*w+x;
+                if(depth[at]!=UINT32_MAX) out[at]=climateMix(out[at],weather==2?0x00dfcbaeu:0x00fff5edu,f*3/4);
+            }
+        }
+    }
+}
