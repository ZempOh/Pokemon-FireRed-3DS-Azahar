diff --git a/app/src/main/kotlin/com/pokedaisy/app/VoxelFrameClock.kt b/app/src/main/kotlin/com/pokedaisy/app/VoxelFrameClock.kt
new file mode 100644
index 0000000..8a7e5a6
--- /dev/null
+++ b/app/src/main/kotlin/com/pokedaisy/app/VoxelFrameClock.kt
@@ -0,0 +1,16 @@
+package com.pokedaisy.app
+
+/** A GBA frame is 280896 cycles of its 16777216 Hz clock, independent of Android's refresh. */
+internal object VoxelFrameClock {
+    const val FRAME_NANOS = 280896L * 1_000_000_000L / 16777216L
+
+    /** Caller holds the pending-frame monitor; wait at most one cartridge frame. */
+    fun awaitPresentation(monitor: Object, pending: () -> Boolean) {
+        val end = System.nanoTime() + FRAME_NANOS
+        while (pending()) {
+            val left = end - System.nanoTime()
+            if (left <= 0) return
+            monitor.wait(left / 1_000_000L, (left % 1_000_000L).toInt())
+        }
+    }
+}
diff --git a/app/src/test/kotlin/com/pokedaisy/app/VoxelFrameClockTest.kt b/app/src/test/kotlin/com/pokedaisy/app/VoxelFrameClockTest.kt
new file mode 100644
index 0000000..f2d16a6
--- /dev/null
+++ b/app/src/test/kotlin/com/pokedaisy/app/VoxelFrameClockTest.kt
@@ -0,0 +1,45 @@
+package com.pokedaisy.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+class VoxelFrameClockTest {
+    @Test fun presentationWaitReleasesTheMonitorForTheConsumer() {
+        val monitor = Object()
+        var pending = true
+        val published = CountDownLatch(1)
+        val consumed = CountDownLatch(1)
+        val consumer = Thread {
+            published.await()
+            synchronized(monitor) { pending = false; monitor.notifyAll() }
+            consumed.countDown()
+        }
+        consumer.start()
+        synchronized(monitor) {
+            published.countDown()
+            VoxelFrameClock.awaitPresentation(monitor) { pending }
+        }
+        assertTrue(consumed.await(2, TimeUnit.SECONDS))
+        consumer.join()
+    }
+
+    @Test(timeout = 2000) fun missingRendererCannotStallTheCore() {
+        val monitor = Object()
+        val start = System.nanoTime()
+        synchronized(monitor) { VoxelFrameClock.awaitPresentation(monitor) { true } }
+        assertTrue(System.nanoTime() - start >= VoxelFrameClock.FRAME_NANOS)
+    }
+
+    @Test fun tenMinutesStayOnTheCartridgeClock() {
+        val frames = 35836L
+        val actualSeconds = frames * VoxelFrameClock.FRAME_NANOS / 1e9
+        val cartridgeSeconds = frames * 280896.0 / 16777216.0
+        assertEquals(cartridgeSeconds, actualSeconds, 0.00004)
+        // The old 118 Hz / 2 pacing loses more than seven seconds over this run.
+        assertTrue(frames / 59.0 - actualSeconds > 7.0)
+        assertTrue(1e9 / VoxelFrameClock.FRAME_NANOS in 59.72..59.73)
+    }
+}
