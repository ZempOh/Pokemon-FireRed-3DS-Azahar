diff --git a/app/src/main/kotlin/com/pokedaisy/app/VoxelFrameClock.kt b/app/src/main/kotlin/com/pokedaisy/app/VoxelFrameClock.kt
new file mode 100644
index 0000000..6839619
--- /dev/null
+++ b/app/src/main/kotlin/com/pokedaisy/app/VoxelFrameClock.kt
@@ -0,0 +1,6 @@
+package com.pokedaisy.app
+
+/** A GBA frame is 280896 cycles of its 16777216 Hz clock, independent of Android's refresh. */
+internal object VoxelFrameClock {
+    const val FRAME_NANOS = 280896L * 1_000_000_000L / 16777216L
+}
diff --git a/app/src/test/kotlin/com/pokedaisy/app/VoxelFrameClockTest.kt b/app/src/test/kotlin/com/pokedaisy/app/VoxelFrameClockTest.kt
new file mode 100644
index 0000000..68f02c3
--- /dev/null
+++ b/app/src/test/kotlin/com/pokedaisy/app/VoxelFrameClockTest.kt
@@ -0,0 +1,17 @@
+package com.pokedaisy.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class VoxelFrameClockTest {
+    @Test fun tenMinutesStayOnTheCartridgeClock() {
+        val frames = 35836L
+        val actualSeconds = frames * VoxelFrameClock.FRAME_NANOS / 1e9
+        val cartridgeSeconds = frames * 280896.0 / 16777216.0
+        assertEquals(cartridgeSeconds, actualSeconds, 0.00004)
+        // The old 118 Hz / 2 pacing loses more than seven seconds over this run.
+        assertTrue(frames / 59.0 - actualSeconds > 7.0)
+        assertTrue(1e9 / VoxelFrameClock.FRAME_NANOS in 59.72..59.73)
+    }
+}
