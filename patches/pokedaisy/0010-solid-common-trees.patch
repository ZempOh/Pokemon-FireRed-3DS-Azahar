+// Profiles are tied to verified ROM CRC + primary tileset, never to green pixels.
+// Unknown trees/tilesets retain the original art. Dynamic cut trees are not replaced.
+static int solidTreesPrepare(const struct Snap* s, struct VoxelView* v, int cx, int cy,
+                             uint32_t* texture, struct SolidTree* trees, int cap, uint32_t alpha) {
+    int snow = solidRom == 0x4b3d4957 && s->primary == 0x08725ab4;
