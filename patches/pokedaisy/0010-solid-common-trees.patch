+static int solidPropsPrepare(const struct Snap* s,struct VoxelView* v,int cx,int cy,
+                             uint32_t* texture,struct SolidProp* props,int cap,uint32_t alpha) {
+    int letsgo=solidRom==0x25c3d89f && s->primary==0x082d4a94;
+    int radical=solidRom==0xfba55dd8 && s->primary==0x082d4a94;
+    int snow=solidRom==0x4b3d4957 && s->primary==0x08725ab4;
+    if(!letsgo&&!radical&&!snow)return 0;
+    int count=0,cellX=(cx+v->left)/16,cellY=(cy+v->top)/16;
+    for(int row=0;row<v->rows;row++)for(int col=0;col<v->cols;col++) {
+        int conn,id=blockIn(s,cellX+col,cellY+row,&conn,false),kind=0,ground=8;
+        if(conn>=0 && s->conn[conn].primary!=s->primary)continue;
+        if(snow) {
+            ground=0;
+            if(id==0x24||id==0x53||id==0xe8||id==0xf1||id==0xfc||id==0x158||id==0x159||id==0x15f)kind=3;
+        } else {
+            ground=letsgo?8:1;
+            if((letsgo&&id==1)||(radical&&(id==0x12||id==0x1a)))kind=1;
+            else if(id==4)kind=letsgo?2:5;
+            else if(id==5||id==0xfa||id==0xfb)kind=4;
+            else if(id==0x9f)kind=3;
+            else if(id==0xaf||id==0xb7){kind=3;ground=0x115;}
+        }
+        if(!kind||count==cap)continue;
+        struct SolidProp* p=&props[count++];p->kind=kind;
+        struct SolidTree* t=&p->surface;
+        t->x=v->left+col*16;t->y=v->top+row*16;t->rise=voxelRise(v,col,row);
+        for(int y=0;y<48;y++)for(int x=0;x<32;x++)
+            t->art[y*32+x]=texture[(row*16+(y/3))*v->stride+col*16+(x&15)];
+        // Replace the original flat drawing with its matching ground material.
+        const uint8_t* vram=(const uint8_t*)G->video.vram;
+        for(int y=0;y<16;y++)for(int x=0;x<16;x++) {
+            uint16_t rgb=P[0];
+            for(int i=0;i<3;i++) {
+                int b=order3[i];uint16_t e=metatile(s,ground,b)[(y/8)*2+x/8];
+                int px=x&7,py=y&7;if(e&0x400)px=7-px;if(e&0x800)py=7-py;
+                unsigned off=bgChar[b]+(e&1023)*32+py*4+px/2;if(off>=0x10000)continue;
+                int ci=(vram[off]>>(px&1?4:0))&15;
+                if(ci){rgb=P[(e>>12)*16+ci];break;}
+            }
+            uint32_t c=color(rgb,alpha);if(voxelClimate.blend)c=climateTerrain(c);
+            texture[(row*16+y)*v->stride+col*16+x]=c;
+        }
+    }
+    return count;
+}
