+    for(int row=0;row+2<v->rows;row++) for(int col=0;col+1<v->cols;col++) {
+        int ids[6],ok=1;
+        for(int y=0;y<3;y++)for(int x=0;x<2;x++) {
+            int conn;
+            ids[y*2+x]=blockIn(s,cellX+col+x,cellY+row+y,&conn,false);
+            if(conn>=0 && s->conn[conn].primary!=s->primary)ok=0;
+        }
+        if(snow) ok=ok && (ids[2]==10||ids[2]==0x184) && ids[3]==11 && ids[4]==18 && ids[5]==19;
+        else ok=ok && (ids[0]==14||ids[0]==20||ids[0]==22) && (ids[1]==15||ids[1]==21||ids[1]==23) &&
+            (ids[2]==28||ids[2]==30) && (ids[3]==29||ids[3]==31) &&
+            (ids[4]==20||ids[4]==22||ids[4]==36||ids[4]==38) &&
+            (ids[5]==21||ids[5]==23||ids[5]==37||ids[5]==39);
+        if(!ok || n==cap)continue;
+        struct SolidTree* t=&trees[n++];
+        t->x=v->left+col*16;t->y=v->top+row*16;
+        t->rise=voxelRise(v,col,row+2);
+        for(int y=0;y<48;y++) memcpy(t->art+y*32,texture+(row*16+y)*v->stride+col*16,32*sizeof(uint32_t));
+        for(int y=8;y<24;y++) memcpy(t->art+y*32,texture+(row*16+y+8)*v->stride+col*16,32*sizeof(uint32_t));
+    }
+    // Reconstruct the verified ground metatile under the card before projecting it.
+    // Capture every tree first: densely packed rows may share a canopy strip.
+    uint32_t ground[256];
+    const uint8_t* vram=(const uint8_t*)G->video.vram;
+    for(int y=0;y<16;y++)for(int x=0;x<16;x++) {
+        uint16_t rgb=P[0];
+        for(int i=0;i<3;i++) {
+            int b=order3[i]; uint16_t e=metatile(s,snow?0:(solidRom==0x25c3d89f?8:1),b)[(y/8)*2+x/8];
+            int px=x&7,py=y&7;if(e&0x400)px=7-px;if(e&0x800)py=7-py;
+            unsigned off=bgChar[b]+(e&1023)*32+py*4+px/2;
+            if(off>=0x10000)continue;
+            int ci=(vram[off]>>(px&1?4:0))&15;
+            if(ci){rgb=P[(e>>12)*16+ci];break;}
+        }
+        ground[y*16+x]=color(rgb,alpha);
+        if(voxelClimate.blend)ground[y*16+x]=climateTerrain(ground[y*16+x]);
+    }
+    for(int i=0;i<n;i++)for(int y=snow?16:0;y<48;y++)for(int x=0;x<32;x++)
+        texture[(trees[i].y-v->top+y)*v->stride+trees[i].x-v->left+x]=ground[(y&15)*16+(x&15)];
+    if(snow) for(int i=0;i<n;i++) {
+        int tx=(trees[i].x-v->left)/16,ty=(trees[i].y-v->top)/16+1;
+        for(int side=0;side<2;side++) {
+            int col=tx+(side?2:-1);
+            if(col<0||col>=v->cols)continue;
+            int conn,mid=blockIn(s,cellX+col,cellY+ty,&conn,false);
+            if(mid!=(side?0x179:0x178))continue;
+            if(conn>=0&&s->conn[conn].primary!=s->primary)continue;
+            for(int y=0;y<16;y++)memcpy(texture+(ty*16+y)*v->stride+col*16,ground+y*16,16*sizeof(uint32_t));
+        }
+    }
+    return n;
+}
