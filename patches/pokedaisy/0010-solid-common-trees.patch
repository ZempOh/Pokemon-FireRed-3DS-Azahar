index 0000000..047098b
--- /dev/null
+++ b/app/src/main/cpp/pk_wide_solid.h
@@ -0,0 +1,68 @@
+// Solid common trees, textured from the current ROM frame (including palette fades).
+#pragma once
+#include <math.h>
+
+struct SolidTree {
+    int x, y, rise;
+    uint32_t art[32 * 48];
+};
+struct SolidVertex { float x, y, z, u, v; };
+
+static void solidTriangle(const struct VoxelView* view, const struct SolidTree* tree,
+                          struct SolidVertex a, struct SolidVertex b, struct SolidVertex c,
+                          unsigned shade, int bark) {
+    struct SolidVertex p[3] = {a,b,c};
+    float sx[3], sy[3];
+    for (int i=0;i<3;i++) {
+        sx[i]=view->width*.5f+p[i].x-view->centreX+(p[i].y-view->centreY)*.25f;
+        sy[i]=view->height*.5f+(p[i].y-view->centreY)*.75f-p[i].z;
+    }
+    float den=(sy[1]-sy[2])*(sx[0]-sx[2])+(sx[2]-sx[1])*(sy[0]-sy[2]);
+    if (fabsf(den)<.001f) return;
+    int x0=(int)floorf(fminf(sx[0],fminf(sx[1],sx[2]))), x1=(int)ceilf(fmaxf(sx[0],fmaxf(sx[1],sx[2])));
+    int y0=(int)floorf(fminf(sy[0],fminf(sy[1],sy[2]))), y1=(int)ceilf(fmaxf(sy[0],fmaxf(sy[1],sy[2])));
+    if(x0<0)x0=0;
+    if(y0<0)y0=0;
+    if(x1>=view->width)x1=view->width-1;
+    if(y1>=view->height)y1=view->height-1;
+    for(int y=y0;y<=y1;y++) for(int x=x0;x<=x1;x++) {
+        float wa=((sy[1]-sy[2])*(x+.5f-sx[2])+(sx[2]-sx[1])*(y+.5f-sy[2]))/den;
+        float wb=((sy[2]-sy[0])*(x+.5f-sx[2])+(sx[0]-sx[2])*(y+.5f-sy[2]))/den;
+        float wc=1-wa-wb;
+        if(wa<-.0001f||wb<-.0001f||wc<-.0001f)continue;
+        int u=(int)(wa*a.u+wb*b.u+wc*c.u), v=(int)(wa*a.v+wb*b.v+wc*c.v);
+        if(u<0)u=0;
+        if(u>31)u=31;
+        if(v<0)v=0;
+        if(v>47)v=47;
+        uint32_t color=tree->art[(bark?43:v)*32+(bark?15:u)];
+        voxelPixel(view,x,y,(int)floorf(wa*a.y+wb*b.y+wc*c.y),voxelShade(color,shade));
+    }
+}
+
+static void solidTreeDraw(const struct VoxelView* view,const struct SolidTree* t) {
+    static const float dx[8]={1,.70710678f,0,-.70710678f,-1,-.70710678f,0,.70710678f};
+    static const float dy[8]={0,.70710678f,1,.70710678f,0,-.70710678f,-1,-.70710678f};
+    static const float radius[5]={8.32f,15.36f,13.60f,6.72f,0};
+    static const float height[5]={8.8f,14.4f,24,31.68f,33.92f};
+    float cx=t->x+16, cy=t->y+42;
+    // Shadow is placed on the real terrain, with the same depth rule as other geometry.
+    for(int y=-9;y<=9;y++) for(int x=-15;x<=15;x++) {
+        if(x*x*81+y*y*225>18225)continue;
+        int px=voxelX(view,(int)cx+x,(int)cy+y), py=voxelY(view,(int)cy+y,t->rise);
+        if((unsigned)px>=(unsigned)view->width||(unsigned)py>=(unsigned)view->height)continue;
+        voxelPixel(view,px,py,(int)cy+y,voxelShade(view->out[py*view->width+px],224));
+    }
+    for(int k=-1;k<4;k++) for(int i=0;i<8;i++) {
+        int j=(i+1)&7;
+        float r0=k<0?2.56f:radius[k],r1=k<0?2.56f:radius[k+1];
+        float h0=k<0?.16f:height[k],h1=k<0?12.8f:height[k+1];
+        struct SolidVertex a={cx+dx[i]*r0,cy+dy[i]*r0,t->rise+h0,8,24};
+        struct SolidVertex b={cx+dx[j]*r0,cy+dy[j]*r0,t->rise+h0,24,24};
+        struct SolidVertex c={cx+dx[j]*r1,cy+dy[j]*r1,t->rise+h1,24,8};
+        struct SolidVertex d={cx+dx[i]*r1,cy+dy[i]*r1,t->rise+h1,8,8};
+        unsigned shade=(unsigned)(216-24*dx[i]-12*dy[i]+(k==3?12:0));
+        solidTriangle(view,t,a,b,c,shade,k<0);
+        solidTriangle(view,t,a,c,d,shade,k<0);
+    }
+}
