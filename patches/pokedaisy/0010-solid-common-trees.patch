index 0000000..ca31f3f
--- /dev/null
+++ b/app/src/main/cpp/pk_wide_props.h
@@ -0,0 +1,99 @@
+// Closed low-poly field props; source colors remain tied to the live ROM palette.
+// Coordinates and depth use the same world space as terrain, actors and trees.
+#pragma once
+struct SolidProp { struct SolidTree surface; int kind; };
+
+static void propFace(const struct VoxelView* v,const struct SolidTree* t,
+                     struct SolidVertex a,struct SolidVertex b,struct SolidVertex c,
+                     struct SolidVertex d,unsigned shade) {
+    solidTriangle(v,t,a,b,c,shade,0); solidTriangle(v,t,a,c,d,shade,0);
+}
+
+static void propMound(const struct VoxelView* v,const struct SolidTree* t,
+                      float x,float y,float z,float radius,float height,int rock,int inkX,int inkY) {
+    static const float dx[8]={1,.707107f,0,-.707107f,-1,-.707107f,0,.707107f};
+    static const float dy[8]={0,.707107f,1,.707107f,0,-.707107f,-1,-.707107f};
+    const float rr[4]={.72f,1,.68f,0},hh[4]={0,.32f,.78f,1};
+    for(int band=0;band<3;band++)for(int e=0;e<8;e++) {
+        int j=(e+1)&7;
+        float ra=radius*rr[band],rb=radius*rr[band+1];
+        float skew=rock?(e%3==0?.88f:1):1,skewj=rock?(j%3==0?.88f:1):1;
+        struct SolidVertex a={x+dx[e]*ra*skew,y+dy[e]*ra,z+hh[band]*height,8+dx[e]*6,16+dy[e]*6};
+        struct SolidVertex b={x+dx[j]*ra*skewj,y+dy[j]*ra,z+hh[band]*height,8+dx[j]*6,16+dy[j]*6};
+        struct SolidVertex c={x+dx[j]*rb*skewj,y+dy[j]*rb,z+hh[band+1]*height,8+dx[j]*4,12+dy[j]*4};
+        struct SolidVertex d={x+dx[e]*rb*skew,y+dy[e]*rb,z+hh[band+1]*height,8+dx[e]*4,12+dy[e]*4};
+        if(inkX>=0){a.u=b.u=c.u=d.u=inkX;a.v=b.v=c.v=d.v=inkY;}
+        propFace(v,t,a,b,c,d,170+band*22+(e<4?15:0));
+    }
+}
+
+// Four-sided tapered stalks, with a leaned tip: volume remains visible from
+// either side instead of rotating a single textured rectangle toward the camera.
+static void propBlade(const struct VoxelView* v,const struct SolidTree* t,
+                      float x,float y,float z,float h,float lean,int colorX,int colorY) {
+    const float dx[4]={-1,0,1,0},dy[4]={0,-.65f,0,.65f};
+    struct SolidVertex tip={x+lean,y+.6f,z+h,colorX,colorY};
+    for(int i=0;i<4;i++) {
+        int j=(i+1)&3;
+        struct SolidVertex a={x+dx[i],y+dy[i],z,colorX,colorY};
+        struct SolidVertex b={x+dx[j],y+dy[j],z,colorX,colorY};
+        solidTriangle(v,t,a,b,tip,180+i*20,0);
+    }
+}
+
+static void solidPropDraw(const struct VoxelView* v,const struct SolidProp* p) {
+    const struct SolidTree* t=&p->surface;
+    float x=t->x+8,y=t->y+9,z=t->rise;
+    if(p->kind==6) {
+        // Berry palms are live event objects. Their stems and broad, thick
+        // fronds share the object's foot and disappear with its visibility.
+        const float dx[4]={-1,1,1,-1},dy[4]={-1,-1,1,1};
+        for(int e=0;e<4;e++) {
+            int j=(e+1)&3;
+            struct SolidVertex a={x+dx[e]*1.8f,y+dy[e]*1.8f,z,15,43};
+            struct SolidVertex b={x+dx[j]*1.8f,y+dy[j]*1.8f,z,15,43};
+            struct SolidVertex c={x+dx[j]*1.3f,y+dy[j]*1.3f,z+19,15,43};
+            struct SolidVertex d={x+dx[e]*1.3f,y+dy[e]*1.3f,z+19,15,43};
+            propFace(v,t,a,b,c,d,185+e*15);
+        }
+        for(int leaf=0;leaf<7;leaf++) {
+            float angle=leaf*.897598f,dx=cosf(angle),dy=sinf(angle);
+            struct SolidVertex root={x,y,z+19,8,12};
+            struct SolidVertex left={x+dx*6-dy*3,y+dy*6+dx*3,z+23,8,12};
+            struct SolidVertex tip={x+dx*14,y+dy*14,z+13,8,12};
+            struct SolidVertex right={x+dx*6+dy*3,y+dy*6-dx*3,z+23,8,12};
+            struct SolidVertex ridge={x+dx*6,y+dy*6,z+25,8,12};
+            struct SolidVertex under={x+dx*6,y+dy*6,z+21,8,12};
+            struct SolidVertex rim[4]={root,left,tip,right};
+            for(int e=0;e<4;e++) {
+                solidTriangle(v,t,rim[e],rim[(e+1)&3],ridge,220+e*8,0);
+                solidTriangle(v,t,rim[(e+1)&3],rim[e],under,165+e*8,0);
+            }
+        }
+        return;
+    }
+    for(int dy=-4;dy<=4;dy++)for(int dx=-7;dx<=7;dx++) {
+        if(dx*dx*16+dy*dy*49>784)continue;
+        int px=voxelX(v,(int)x+dx,(int)y+dy),py=voxelY(v,(int)y+dy,(int)z);
+        if((unsigned)px<(unsigned)v->width&&(unsigned)py<(unsigned)v->height)
+            voxelPixel(v,px,py,(int)y+dy,voxelShade(v->out[py*v->width+px],225));
+    }
+    if(p->kind==3) { propMound(v,t,x,y,z,7.2f,10.5f,1,-1,0); return; }
+    if(p->kind==4) { propMound(v,t,x,y,z,6.2f,12,0,-1,0); return; }
+    for(int i=0;i<7;i++) {
+        float px=x+(i%3-1)*3.5f,py=y+(i/3-1)*3;
+        propBlade(v,t,px,py,z,6.5f+(i%3)*1.3f,(i&1)?1.5f:-1.5f,5+(i%3)*3,36);
+    }
+    if(p->kind==2||p->kind==5) {
+        // Petals are flattened closed mounds above stems, never a floor decal.
+        for(int i=0;i<2;i++) {
+            float px=x+(i?4:-4),py=y+(i?2:-2);
+            propBlade(v,t,px,py,z,7,0,8,18);
+            for(int petal=0;petal<5;petal++) {
+                float angle=petal*1.256637f;
+                propMound(v,t,px+cosf(angle)*2.2f,py+sinf(angle)*2.2f,z+7,1.8f,1.4f,0,p->kind==5?6:(i?4:2),p->kind==5?12:(i?9:6));
+            }
+            propMound(v,t,px,py,z+7.7f,1.4f,1.2f,0,i?2:4,i?6:9);
+        }
+    }
+}
