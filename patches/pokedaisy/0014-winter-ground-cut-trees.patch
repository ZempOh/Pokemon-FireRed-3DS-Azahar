+static int climateKantoPath(int id) {
+    return (id>=0xd3 && id<=0xd5) || (id>=0xdb && id<=0xdd)
+        || (id>=0xe3 && id<=0xe5) || (id>=0x102 && id<=0x105);
+}
+static uint32_t climateGround(uint32_t c,int path) {
+    if(voxelClimate.season!=3 || !voxelClimate.seasonBlend)return climateTerrain(c);
+    unsigned r=c&255,g=(c>>8)&255,b=(c>>16)&255;
+    int grass=g>r+8 && g>b+8;
+    int earth=path && r>=g && g>b+16 && r>72;
+    if(!grass&&!earth)return c;
+    unsigned lum=(r+2*g+b)/4;
+    unsigned nr=184+lum/5,ng=192+lum/5,nb=200+lum/5;
+    unsigned f=voxelClimate.seasonBlend;
+    if(earth)f=f*3/4;
+    return climateMix(c,(c&0xff000000u)|nr|(ng<<8)|(nb<<16),f);
+}
