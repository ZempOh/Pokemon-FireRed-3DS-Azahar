+        /** Prime real samples before play(), preserving a frame that straddles the buffer end. */
+        private fun writeNativeAudio(track: AudioTrack, n: Int): Int {
+            if (track.playState == AudioTrack.PLAYSTATE_PLAYING) {
+                return track.write(scratch, 0, n, if (trackStarted) AudioTrack.WRITE_NON_BLOCKING else AudioTrack.WRITE_BLOCKING)
+            }
+            // Reserve half the capacity for the mixer's burst-sized reads once playback
+            // starts. Priming the entire capacity left no headroom for the next frame.
+            val primeFrames = if (android.os.Build.VERSION.SDK_INT >= 31) {
+                if (framesWritten == 0L) track.startThresholdInFrames = bufferFrames / 2
+                track.startThresholdInFrames
+            } else bufferFrames
+            val first = track.write(scratch, 0, n, AudioTrack.WRITE_NON_BLOCKING)
+            if (first < 0) return first
+            if (framesWritten + first / 2 >= primeFrames || first < n) {
+                track.play()
+                Log.i("pokedaisy", "audio: native playback starts with ${framesWritten + first / 2}/$primeFrames real frames queued (capacity $bufferFrames)")
+                if (first < n) {
+                    val tail = track.write(scratch, first, n - first, AudioTrack.WRITE_BLOCKING)
+                    return first + tail.coerceAtLeast(0)
+                }
+            }
+            return first
         }
 
