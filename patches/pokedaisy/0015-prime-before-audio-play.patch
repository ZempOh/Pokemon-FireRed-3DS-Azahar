new file mode 100644
--- /dev/null
+++ b/app/src/main/kotlin/com/pokedaisy/app/NativeAudioQueue.kt
@@ -0,0 +1,28 @@
+package com.pokedaisy.app
+
+/** Retains real PCM when a nonblocking device write accepts only part of a frame. */
+internal class NativeAudioQueue(capacity: Int) {
+    private val samples = ShortArray(capacity)
+    var size = 0
+        private set
+
+    fun append(source: ShortArray, count: Int): Boolean {
+        require(count in 0..source.size)
+        if (count > samples.size - size) return false
+        source.copyInto(samples, size, 0, count)
+        size += count
+        return true
+    }
+
+    fun drain(write: (ShortArray, Int) -> Int): Int {
+        if (size == 0) return 0
+        val accepted = write(samples, size)
+        if (accepted <= 0) return accepted
+        check(accepted <= size)
+        samples.copyInto(samples, 0, accepted, size)
+        size -= accepted
+        return accepted
+    }
+
+    fun clear() { size = 0 }
+}
diff --git a/app/src/test/kotlin/com/pokedaisy/app/NativeAudioQueueTest.kt b/app/src/test/kotlin/com/pokedaisy/app/NativeAudioQueueTest.kt
new file mode 100644
--- /dev/null
+++ b/app/src/test/kotlin/com/pokedaisy/app/NativeAudioQueueTest.kt
@@ -0,0 +1,35 @@
+package com.pokedaisy.app
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class NativeAudioQueueTest {
+    @Test fun partialAndZeroWritesPreserveOrderAcrossFrames() {
+        val queue = NativeAudioQueue(12)
+        val received = mutableListOf<Short>()
+        assertTrue(queue.append(shortArrayOf(1, 2, 3, 4), 4))
+        assertEquals(2, queue.drain { data, _ -> received.addAll(data.take(2)); 2 })
+        assertEquals(0, queue.drain { _, _ -> 0 })
+        assertTrue(queue.append(shortArrayOf(5, 6, 7, 8), 4))
+        assertEquals(6, queue.drain { data, count -> received.addAll(data.take(count)); count })
+        assertEquals((1..8).map { it.toShort() }, received)
+        assertEquals(0, queue.size)
+    }
+
+    @Test fun failedWriteAndCapacityRejectionDoNotEraseQueuedSamples() {
+        val queue = NativeAudioQueue(4)
+        assertTrue(queue.append(shortArrayOf(10, 20, 30, 40), 4))
+        assertEquals(-6, queue.drain { _, _ -> -6 })
+        assertFalse(queue.append(shortArrayOf(50, 60), 2))
+        queue.drain { data, count -> assertArrayEquals(shortArrayOf(10, 20, 30, 40), data.copyOf(count)); count }
+        assertEquals(0, queue.size)
+    }
+
+    @Test fun flushDoesNotReplayPrePauseAudio() {
+        val queue = NativeAudioQueue(4)
+        queue.append(shortArrayOf(1, 2), 2)
+        queue.clear()
+        queue.append(shortArrayOf(3, 4), 2)
+        queue.drain { data, count -> assertArrayEquals(shortArrayOf(3, 4), data.copyOf(count)); count }
+    }
+}
