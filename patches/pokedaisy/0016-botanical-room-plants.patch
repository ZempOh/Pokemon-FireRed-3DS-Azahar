+    {0xfba55dd8,0x082d4bb4,0x47,0x4f,0,28,16,16,32,{7,4,7,5,7,4,5,24,6,24,3,24}},
+    {0xfba55dd8,0x082d4bb4,0x57,0x5f,0,28,16,16,32,{7,4,7,5,7,4,5,24,6,24,3,24}},
+    {0x4b3d4957,0x082d4bb4,0x5d,0x5f,1,30,14,16,32,{6,5,7,3,7,2,3,24,3,25,2,24}},
+    {0x4b3d4957,0x082d4bb4,0x8b,0x93,1,30,14,16,32,{6,5,7,3,7,2,3,24,3,25,2,24}},
+    {0x4b3d4957,0x082d4bb4,0x8c,0x94,1,30,14,16,32,{6,5,7,3,7,2,3,24,3,25,2,24}},
+    {0x4b3d4957,0x082d4bb4,0xf5,0xfd,1,30,14,16,32,{6,5,7,3,7,2,3,24,3,25,2,24}},
+    {0x4b3d4957,0x082d4bb4,0xf6,0xfe,1,30,14,16,32,{6,5,7,3,7,2,3,24,3,25,2,24}},
+};
+static int solidPlantProfile(uint32_t rom,uint32_t primary,int top,int bottom) {
+    for(unsigned i=0;i<sizeof(solidPlantProfiles)/sizeof(solidPlantProfiles[0]);i++) {
+        const struct SolidPlantProfile *p=&solidPlantProfiles[i];
+        if(p->rom==rom&&p->primary==primary&&p->top==top&&p->bottom==bottom)return (int)i;
+    }
+    return -1;
+}
