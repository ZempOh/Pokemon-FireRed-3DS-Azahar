+// Exact revisions only. Candidate capabilities are not Thor qualification.
+#pragma once
+#include <stdint.h>
+static int sceneryCandidate(uint32_t crc) {
+    switch(crc) {
+    case 0x25c3d89f: case 0xfba55dd8: case 0x4b3d4957:
+    case 0x63478921: case 0xb9465c5a: case 0xf2d16ebd: case 0x6c5ee1b2:
+        return 1;
+    default:return 0;
+    }
+}
+static int sceneryKanto(uint32_t crc,uint32_t primary) {
+    return primary==0x082d4a94 && (crc==0x25c3d89f || crc==0xfba55dd8 ||
+        crc==0x4b3d4957 || crc==0xf2d16ebd);
+}
+static int sceneryRadicalProps(uint32_t crc,uint32_t primary) {
+    return primary==0x082d4a94 && (crc==0xfba55dd8 || crc==0xf2d16ebd);
+}
