+// UI visibility follows transparent pixels, not a game's chosen blank tile ID.
+#pragma once
+#include <stdint.h>
+static int sceneryUiTileHasInk(const uint8_t *vram,uint16_t control,unsigned tile) {
+    unsigned bytes=(control&0x80)?64:32;
+    unsigned offset=((control>>2)&3)*0x4000+(tile&1023)*bytes;
+    if(offset+bytes>0x10000)return 0;
+    for(unsigned i=0;i<bytes;i++)if(vram[offset+i])return 1;
+    return 0;
+}
