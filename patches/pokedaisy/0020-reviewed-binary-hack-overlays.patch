+#!/usr/bin/env python3
+"""Generate a HackText overlay from a hash-locked, reviewed local-ROM profile.
+
+No ROM download or automatic engine approval. Table locations/counts must be
+reviewed separately; validation rejects foreign ROMs, invalid types and charts.
+Usage: gen_binary_hack_overlay.py PROFILE.json LOCAL_ROM OUTPUT.kt
+"""
+import argparse, hashlib, json, struct
+from pathlib import Path
+from gen_firered_hack_tables import text, kstr, B
+
+def generate(profile, data):
+    assert hashlib.sha256(data).hexdigest() == profile['sha256'], 'ROM hash mismatch'
+    p={k:int(v,0) for k,v in profile['tables'].items()}
+    def read(address,size):
+        offset=address-B
+        assert 0<=offset<=len(data)-size, 'Table outside ROM'
+        return data[offset:offset+size]
+    def name(address,size):
+        raw=read(address,size)
+        assert 255 in raw, 'Unterminated name'
+        return text(data,address,size)
+    def mapping(label, values):
+        return '        '+label+' = mapOf(\n'+''.join(f'            {k} to {v},\n' for k,v in values)+'        ),\n'
+    species=[];types=[];gender=[];growth=[]
+    for i in range(profile['species_count']):
+        row=read(p['base_stats']+28*i,28)
+        assert max(row[6:8])<profile['type_count']
+        gender.append(row[16]);growth.append(row[19])
+        assert row[19]<6
+        if i:
+            n=name(p['species_names']+11*i,11)
+            if n:species.append((i,kstr(n)))
+            types.append((i,f'SpeciesTypes({row[6]}, {row[7]})'))
+    moves=[];stats=[]
+    shift=profile.get('move_effect_bytes',1)-1
+    assert shift in (0,1)
+    for i in range(profile['moves_count']):
+        row=read(p['battle_moves']+12*i,12);n=name(p['move_names']+13*i,13)
+        power,typ,accuracy,pp,chance=row[1+shift:6+shift]
+        assert typ<profile['type_count'] and accuracy<=100 and pp<=64, (i,n,row.hex())
+        if i:
+            assert n, f'Missing move {i}'
+            moves.append((i,f'MoveInfo({kstr(n)}, {typ}, {power})'))
+        # Custom effect routines are not inferred from a retail effect ID.
+        stats.append(f'            MoveStats("UNKNOWN", {accuracy}, {pp}, {chance}, {struct.unpack("b",row[7+shift:8+shift])[0]}),\n')
+    items=[]
+    for i in range(1,profile['items_count']):
+        row=read(p['items']+44*i,44);n=name(p['items']+44*i,14)
+        if n:
+            expected=profile.get('item_id_aliases',{}).get(str(i),i)
+            assert struct.unpack_from('<H',row,14)[0]==expected, (i,n,struct.unpack_from('<H',row,14)[0])
+            items.append((i,kstr(n)))
+    names=[]
+    for i in range(profile['type_count']):
+        n=name(p['type_names']+7*i,7)
+        if n:names.append((i,kstr({'FIGHT':'Fighting','ELECTR':'Electric','PSYCHC':'Psychic'}.get(n.upper(),n.title()))))
+    chart={}
+    for i in range(2048):
+        attack,defend,mult=read(p['type_chart']+3*i,3)
+        if attack==255:break
+        if attack==254:continue
+        assert max(attack,defend)<profile['type_count'] and mult in (0,5,10,20)
+        chart[attack*100+defend]=mult*10
+    else:raise AssertionError('Unterminated type chart')
+    assert chart
+    return ('package com.pokedaisy.app.companion.data\n\n'
+        '// GENERATED by scripts/gen_binary_hack_overlay.py from a hash-checked local ROM.\n'
+        f'internal val {profile["symbol"]}: HackText by lazy {{\n    HackText(\n'
+        +mapping('species',species)+mapping('types',types)+mapping('moves',moves)+mapping('items',items)
+        +'        mapSecs = emptyMap(),\n'+mapping('typeNames',names)+mapping('typeChart',chart.items())
+        +f'        genderRatios = unhexRatios("{bytes(gender).hex()}"),\n'
+        +f'        growthRates = unhexBytes("{bytes(growth).hex()}"),\n'
+        +'        moveStats = listOf(\n'+''.join(stats)+'        ),\n        ownCase = true,\n    )\n}\n')
+
+if __name__=='__main__':
