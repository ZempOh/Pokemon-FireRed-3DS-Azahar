+import hashlib,struct,unittest
+from gen_binary_hack_overlay import generate
+from gen_firered_hack_tables import CH,B
+
+class OverlayValidation(unittest.TestCase):
+    def fixture(self,wide=False):
+        d=bytearray(1024);tables={'species_names':B,'base_stats':B+32,'move_names':B+100,'battle_moves':B+132,'items':B+200,'type_names':B+300,'type_chart':B+400}
+        encode={v:k for k,v in CH.items()}
+        for offset,s in [(11,'TEST'),(100,'NONE'),(113,'POUND'),(244,'POTION'),(300,'NORMAL')]:
+            raw=bytes(encode[c] for c in s)+b'\xff';d[offset:offset+len(raw)]=raw
+        struct.pack_into('<H',d,258,1)
+        row=bytearray(12);shift=int(wide);row[1+shift]=40;row[3+shift]=100;row[4+shift]=35;d[144:156]=row
+        d[400:406]=bytes([0,0,5,255,255,0])
+        p=dict(sha256=hashlib.sha256(d).hexdigest(),tables={k:hex(v) for k,v in tables.items()},species_count=2,moves_count=2,items_count=2,type_count=1,symbol='test',move_effect_bytes=1+shift)
+        return p,d
+    def test_both_move_layouts_preserve_power_pp(self):
+        for wide in (False,True):
+            p,d=self.fixture(wide);s=generate(p,d)
+            self.assertIn('MoveInfo("POUND", 0, 40)',s)
+            self.assertIn('MoveStats("UNKNOWN", 100, 35, 0, 0)',s)
+    def test_foreign_rom_rejected(self):
+        p,d=self.fixture();d[-1]=1
+        with self.assertRaisesRegex(AssertionError,'ROM hash'):generate(p,d)
+    def test_unterminated_chart_rejected(self):
+        p,d=self.fixture();d[403:]=bytes(len(d)-403);p['sha256']=hashlib.sha256(d).hexdigest()
+        with self.assertRaises(AssertionError):generate(p,d)
+    def test_invalid_type_rejected(self):
+        p,d=self.fixture();d[32+28+6]=5;p['sha256']=hashlib.sha256(d).hexdigest()
+        with self.assertRaises(AssertionError):generate(p,d)
+
+if __name__=='__main__':unittest.main()
