 import org.junit.Test
 
 class WideCameraTest {
+    @Test(timeout = 15000) fun concurrentResetsKeepEveryWindowVisible() {
+        val cam = thor()
+        val start = java.util.concurrent.CountDownLatch(1)
+        val done = java.util.concurrent.atomic.AtomicBoolean(false)
+        val resetter = Thread {
+            start.await()
+            while (!done.get()) { cam.reset(); Thread.yield() }
+        }
+        resetter.start()
+        try {
+            start.countDown()
+            repeat(100_000) { i ->
+                cam.level = i % 4
+                val window = cam.frame(if (i % 5 == 0) WideCamera.SCENE_TEXT else WideCamera.SCENE_FIELD,
+                    1L + i * 16_666_667L)!!
+                assertTrue("Invalid camera scale at frame $i: $window", window.scale.isFinite() && window.scale > 0)
+                assertTrue(window.offX.isFinite() && window.offY.isFinite())
+                assertTrue(window.w in 1..WideCamera.MAX_W && window.h in 1..WideCamera.MAX_H)
+            }
+        } finally {
+            done.set(true)
+            resetter.join(2000)
+        }
+        assertTrue("Reset worker must finish", !resetter.isAlive)
+    }
+
     private fun thor() = WideCamera().apply { viewW = 1920; viewH = 1080 }
 
     /** Runs [seconds] of frames at 60 Hz; returns the last window. */
