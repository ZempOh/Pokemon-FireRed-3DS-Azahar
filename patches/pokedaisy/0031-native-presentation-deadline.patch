     const val FRAME_NANOS = 280896L * 1_000_000_000L / 16777216L
+
+    /** Publish on the cartridge deadline, not at a scene-dependent render finish.
+     * The clock and sleeper are injectable so work transitions and early wakes can
+     * be checked without depending on the host scheduler. Late frames never wait.
+     */
+    fun awaitDeadline(deadline: Long, now: () -> Long = System::nanoTime,
+                      park: (Long) -> Unit = java.util.concurrent.locks.LockSupport::parkNanos) {
+        while (!Thread.currentThread().isInterrupted) {
+            val left = deadline - now()
+            if (left <= 0L) return
+            park(left)
+        }
+    }
 
