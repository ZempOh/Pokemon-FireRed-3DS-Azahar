 import org.junit.Test
 
 class NativeAudioQueueTest {
+    @Test fun fullTrackPrimingRetainsThePartialLastFrame() {
+        val trackCapacity = 7688 * 2 // stereo samples; not a whole cartridge frame
+        val queue = NativeAudioQueue(4096)
+        val produced = mutableListOf<Short>()
+        val played = mutableListOf<Short>()
+        var written = 0
+        repeat(10) { frame ->
+            val pcm = ShortArray(1608) { (frame * 1608 + it).toShort() }
+            produced.addAll(pcm.toList())
+            assertTrue(queue.append(pcm, pcm.size))
+            written += queue.drain { data, count ->
+                val accepted = minOf(count, trackCapacity - written)
+                played.addAll(data.take(accepted))
+                accepted
+            }
+        }
+        assertEquals(trackCapacity, written)
+        assertEquals(produced.size - trackCapacity, queue.size)
+        assertTrue(queue.size > 0)
+        assertEquals(0, queue.drain { _, _ -> 0 })
+        // Once the full track begins playing, its retained PCM tail comes next.
+        queue.drain { data, count -> played.addAll(data.take(count)); count }
+        assertEquals(produced, played)
+    }
