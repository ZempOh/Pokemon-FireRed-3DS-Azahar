+static int solidBuildingMargin(const struct Snap* s) {
+    int margin=0;
+    for(unsigned i=0;i<sizeof(sceneryBuildings)/sizeof(sceneryBuildings[0]);i++) {
+        const struct SceneryBuildingProfile* p=&sceneryBuildings[i];
+        if(p->crc!=solidRom || p->primary!=s->primary)continue;
+        int match=p->secondary==s->secondary;
+        for(int c=0;c<s->nconn && !match;c++)match=p->primary==s->conn[c].primary && p->secondary==s->conn[c].secondary;
+        if(!match)continue;
+        int size=(p->width>p->height?p->width:p->height)*16;
+        if(size>margin)margin=size;
+    }
+    return margin>96?96:margin;
+}
