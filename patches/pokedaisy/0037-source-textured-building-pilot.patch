+/* Source-textured building volume; no ROM artwork is compiled into the APK. */
+#pragma once
+#include <math.h>
+#include "scenery_building_geometry.h"
+#include "pk_scenery_buildings.h"
+#define SOLID_BUILDING_MAX_W 320
+#define SOLID_BUILDING_MAX_H 160
+#define SOLID_BUILDING_CAP 12
+struct SolidBuilding {
+    const struct SceneryBuildingProfile* profile;
+    int x,y,rise;
+    uint32_t art[SOLID_BUILDING_MAX_W*SOLID_BUILDING_MAX_H];
+};
+struct SolidBuildingContext { const struct VoxelView* view; const struct SolidBuilding* building; };
+static void solidBuildingTriangle(void* opaque,const SceneryBuildingVertex* a,
+        const SceneryBuildingVertex* b,const SceneryBuildingVertex* c,unsigned shade) {
+    if(a->y==0 && b->y==0 && c->y==0)return; /* Closed model underside is never visible from this camera. */
+    const struct SolidBuildingContext* ctx=opaque;
+    const struct VoxelView* view=ctx->view;const struct SolidBuilding* building=ctx->building;
+    const SceneryBuildingVertex* p[3]={a,b,c};float sx[3],sy[3],wy[3];
+    for(int i=0;i<3;i++) {
+        float wx=building->x+p[i]->x;wy[i]=building->y+p[i]->z;
+        sx[i]=view->width*.5f+wx-view->centreX+(wy[i]-view->centreY)*.25f;
+        sy[i]=view->height*.5f+(wy[i]-view->centreY)*.75f-building->rise-p[i]->y;
+    }
+    float den=(sy[1]-sy[2])*(sx[0]-sx[2])+(sx[2]-sx[1])*(sy[0]-sy[2]);
+    if(fabsf(den)<.001f)return;
+    int x0=(int)floorf(fminf(sx[0],fminf(sx[1],sx[2]))),x1=(int)ceilf(fmaxf(sx[0],fmaxf(sx[1],sx[2])));
+    int y0=(int)floorf(fminf(sy[0],fminf(sy[1],sy[2]))),y1=(int)ceilf(fmaxf(sy[0],fmaxf(sy[1],sy[2])));
+    if(x0<0)x0=0;
+    if(y0<0)y0=0;
+    if(x1>=view->width)x1=view->width-1;
+    if(y1>=view->height)y1=view->height-1;
+    int width=building->profile->width*16,height=building->profile->height*16;
+    for(int y=y0;y<=y1;y++)for(int x=x0;x<=x1;x++) {
+        float wa=((sy[1]-sy[2])*(x+.5f-sx[2])+(sx[2]-sx[1])*(y+.5f-sy[2]))/den;
+        float wb=((sy[2]-sy[0])*(x+.5f-sx[2])+(sx[0]-sx[2])*(y+.5f-sy[2]))/den;
+        float wc=1-wa-wb;if(wa<-.0001f||wb<-.0001f||wc<-.0001f)continue;
+        int u=(int)(wa*a->u+wb*b->u+wc*c->u),v=(int)(wa*a->v+wb*b->v+wc*c->v);
+        if(u<0)u=0;
+        if(v<0)v=0;
+        if(u>=width)u=width-1;
+        if(v>=height)v=height-1;
+        uint32_t color=building->art[v*width+u];
+        voxelPixel(view,x,y,(int)floorf(wa*wy[0]+wb*wy[1]+wc*wy[2]),voxelShade(color,shade));
+    }
+}
+static void solidBuildingDraw(const struct VoxelView* view,const struct SolidBuilding* building) {
+    const struct SceneryBuildingProfile* p=building->profile;
+    int width=p->width*16,front=p->height*16;
+    for(int y=(int)p->shape.back+3;y<front+8;y++)for(int x=3;x<width+9;x++) {
+        if(x<width && y<front)continue;
+        int wx=building->x+x,wy=building->y+y;
+        int px=voxelX(view,wx,wy),py=voxelY(view,wy,building->rise);
+        if((unsigned)px<(unsigned)view->width && (unsigned)py<(unsigned)view->height)
+            voxelPixel(view,px,py,wy,voxelShade(view->out[py*view->width+px],224));
+    }
+    struct SolidBuildingContext ctx={view,building};
+    SceneryBuilding_Emit(&ctx,solidBuildingTriangle,&p->shape);
+}
