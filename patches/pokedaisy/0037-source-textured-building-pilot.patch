+static int solidBuildingsPrepare(const struct Snap* s,struct VoxelView* v,int cx,int cy,
+        uint32_t* texture,struct SolidBuilding* buildings,uint32_t alpha) {
+    unsigned char occupied[((BUF_W+15)/16)*((BUF_H+15)/16)];
+    memset(occupied,0,sizeof(occupied));
