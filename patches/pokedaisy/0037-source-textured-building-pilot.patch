+    for(int row=0;row<v->rows;row++)for(int col=0;col<v->cols;col++) {
+        if(occupied[row*v->cols+col])continue;
+        int conn,id=blockIn(s,cellX+col,cellY+row,&conn,false);
+        uint32_t primary=conn<0?s->primary:s->conn[conn].primary;
+        uint32_t secondary=conn<0?s->secondary:s->conn[conn].secondary;
+        if(primary!=s->primary)continue; /* Ground uses the shared live primary palette. */
+        for(unsigned i=0;i<sizeof(sceneryBuildings)/sizeof(sceneryBuildings[0]);i++) {
+            const struct SceneryBuildingProfile* p=&sceneryBuildings[i];
+            if(p->crc!=solidRom || p->primary!=primary || p->secondary!=secondary || p->cells[0]!=id)continue;
+            if(col+p->width>v->cols || row+p->height>v->rows || count==SOLID_BUILDING_CAP)continue;
+            int match=1;
+            for(int y=0;y<p->height && match;y++)for(int x=0;x<p->width;x++) {
+                int c,mid=blockIn(s,cellX+col+x,cellY+row+y,&c,false);
+                if(c!=conn || mid!=p->cells[y*p->width+x] || occupied[(row+y)*v->cols+col+x]){match=0;break;}
+            }
+            if(!match)continue;
+            struct SolidBuilding* b=&buildings[count++];b->profile=p;
+            b->x=v->left+col*16;b->y=v->top+row*16;b->rise=voxelRise(v,col,row+p->height-1);
+            int width=p->width*16,height=p->height*16;
+            for(int y=0;y<height;y++)memcpy(b->art+y*width,texture+(row*16+y)*v->stride+col*16,width*sizeof(uint32_t));
+            uint32_t ground[256];
+            for(int y=0;y<16;y++)for(int x=0;x<16;x++) {
+                uint32_t ink=solidMaterialPixel(s,p->ground,x,y,alpha);
+                ground[y*16+x]=voxelClimate.season==3?climateGround(ink,2):ink;
+            }
+            for(int y=0;y<height;y++)for(int x=0;x<width;x++)texture[(row*16+y)*v->stride+col*16+x]=ground[(y&15)*16+(x&15)];
+            for(int y=0;y<p->height;y++)for(int x=0;x<p->width;x++)occupied[(row+y)*v->cols+col+x]=1;
+            break;
+        }
+    }
+    return count;
+}
