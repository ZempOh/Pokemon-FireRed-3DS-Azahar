+
+    @Test fun `whole cart scans do not allocate another cart per pass`() = withFile { f ->
+        val allocation = java.lang.management.ManagementFactory.getThreadMXBean() as? com.sun.management.ThreadMXBean
+        org.junit.Assume.assumeTrue(allocation?.isThreadAllocatedMemorySupported == true)
+        val counter = allocation!!
+        counter.isThreadAllocatedMemoryEnabled = true
+        f.writeBytes(ByteArray(4 * 1024 * 1024) { (it xor (it ushr 8)).toByte() })
+        withRomFile(f.toOkioPath()) { h ->
+            val reader = FileLittleEndian(h)
+            fun scan(): Long {
+                var sum = 0L
+                var offset = 0
+                while (offset <= reader.limit() - 4) {
+                    sum += reader.getInt(offset)
+                    offset += 4
+                }
+                return sum
+            }
+            val expected = scan() // Warm file/JVM paths outside the allocation budget.
+            val thread = Thread.currentThread().id
+            val before = counter.getThreadAllocatedBytes(thread)
+            var total = 0L
+            repeat(4) { total += scan() }
+            val allocated = counter.getThreadAllocatedBytes(thread) - before
+            assertEquals(expected * 4, total)
+            // Old window copying allocates over 16 MiB; allow ample bookkeeping
+            // without making this a machine-speed-dependent timing assertion.
+            assertTrue("Scanner allocated $allocated bytes", allocated < 4 * 1024 * 1024)
+        }
+    }
