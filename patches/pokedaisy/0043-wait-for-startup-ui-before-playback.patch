 /** A GBA frame is 280896 cycles of its 16777216 Hz clock, independent of Android's refresh. */
 internal object VoxelFrameClock {
     const val FRAME_NANOS = 280896L * 1_000_000_000L / 16777216L
+
+    /** Initial UI/scanner loading is not gameplay. Require a quiet UI interval
+     * after the initial loading reserve; a stalled callback never counts as quiet.
+     * The Android caller bounds the wait and cancels callbacks when it exits. */
+    class StartupReadiness(private val started: Long) {
+        private var last = started
+        private var quietSince = started
+        fun frame(now: Long): Boolean {
+            if (now - last > 40_000_000L || now < last) quietSince = now
+            last = now
+            return now - started >= 3_000_000_000L && now - quietSince >= 1_000_000_000L
+        }
+    }
 
