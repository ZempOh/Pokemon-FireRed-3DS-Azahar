         p,d=self.fixture();d[32+28+6]=5;p['sha256']=hashlib.sha256(d).hexdigest()
         with self.assertRaises(AssertionError):generate(p,d)
 
+    def section_fixture(self):
+        p,d=self.fixture();p['tables']['map_sections']=hex(B+500);p['map_section_count']=2
+        struct.pack_into('<I',d,504,B+600);struct.pack_into('<I',d,512,B+620)
+        encode={v:k for k,v in CH.items()}
+        for offset,label in [(600,'ROUTE 212'),(620,'NEW TOWN')]:
+            raw=bytes(encode[c] for c in label)+b'\xff';d[offset:offset+len(raw)]=raw
+        p['sha256']=hashlib.sha256(d).hexdigest();return p,d
+
+    def test_own_map_names_replace_retail_labels(self):
+        p,d=self.section_fixture();s=generate(p,d)
+        self.assertIn('0 to "ROUTE 212"',s);self.assertIn('1 to "NEW TOWN"',s)
+
+    def test_foreign_map_pointer_rejected(self):
+        p,d=self.section_fixture();struct.pack_into('<I',d,504,B+len(d))
+        p['sha256']=hashlib.sha256(d).hexdigest()
+        with self.assertRaisesRegex(AssertionError,'Table outside ROM'):generate(p,d)
+
+    def test_reviewed_damaged_section_does_not_show_dialogue(self):
+        p,d=self.section_fixture();p['unknown_map_sections']={'1':'Reviewed unused entry points into dialogue'}
+        s=generate(p,d);self.assertIn('1 to "Unknown area"',s);self.assertNotIn('NEW TOWN',s)
+
 if __name__=='__main__':unittest.main()
