--- /dev/null
+++ b/app/src/main/cpp/pk_red_voxel_pilot.h
@@ -0,0 +1,98 @@
+// Reviewed Pallet material cells for the exact US/EU Red cartridge.
+// Units are 16 source pixels; the live map has a three-block border.
+enum RedMaterial { RED_FIELD, RED_TREE, RED_ROOF, RED_WALL, RED_FLOWER, RED_POST, RED_WATER };
+static enum RedMaterial redMaterialAt(int cx, int cy) {
+    if ((unsigned)cx >= 20 || (unsigned)cy >= 18) return RED_FIELD;
+    if ((cy == 1 && cx != 9) || (cy == 0 && (cx == 3 || cx == 8 || cx == 10 || cx == 17)) ||
+        ((cx == 0 || cx == 19) && cy >= 2) ||
+        (cy == 17 && (cx == 1 || cx >= 8))) return RED_TREE;
+    bool home = (cx >= 4 && cx < 8) || (cx >= 12 && cx < 16);
+    if (home && (cy == 3 || cy == 4)) return RED_ROOF;
+    if (home && cy == 5) return RED_WALL;
+    if (cx >= 10 && cx < 16 && (cy == 8 || cy == 9)) return RED_ROOF;
+    if (cx >= 10 && cx < 16 && (cy == 10 || cy == 11)) return RED_WALL;
+    if ((cy == 9 && cx >= 4 && cx <= 7) || (cy == 13 && cx >= 11 && cx <= 15)) return RED_POST;
+    if ((cy == 10 && cx >= 4 && cx <= 7) || (cy == 14 && cx >= 11 && cx <= 14)) return RED_FLOWER;
+    if (cy >= 14 && cx >= 4 && cx <= 7) return RED_WATER;
+    return RED_FIELD;
+}
+
+static const struct RedMaterialStyle {
+    uint8_t rise, r, g, b;
+} redStyles[] = {
+    [RED_FIELD]  = {0, 155, 181, 123},
+    [RED_TREE]   = {16, 117, 164, 106},
+    [RED_ROOF]   = {17, 196, 125, 105},
+    [RED_WALL]   = {6, 216, 191, 148},
+    [RED_FLOWER] = {2, 199, 131, 136},
+    [RED_POST]   = {4, 179, 148, 108},
+    [RED_WATER]  = {0, 108, 173, 180},
+};
+
+static uint32_t redTint(uint32_t color, const struct RedMaterialStyle* style) {
+    unsigned luminance = ((color & 255) + 2 * ((color >> 8) & 255) + ((color >> 16) & 255)) / 4;
+    unsigned shade = 112 + luminance / 2;
+    return (color & 0xff000000u) | (style->r * shade >> 8)
+        | ((style->g * shade >> 8) << 8) | ((style->b * shade >> 8) << 16);
+}
+
+static void redVoxelActors(const struct VoxelView* view, int ox, int oy, uint32_t alpha) {
+    for (int k = 0; k < gbNObjs; ++k) {
+        const struct GbObj* o = &gbObjs[k];
+        bool tall = (gbLcdc & 4) != 0;
+        int wx = ox + o->x;
+        int foot = oy + o->y + (tall && !(o->attr & 0x100) ? 16 : 8);
+        if (foot < view->top || foot >= view->top + view->rows * VOXEL_TILE) continue;
+        int x0 = voxelX(view, wx, foot);
+        int y0 = voxelY(view, foot, foot - oy - o->y);
+        uint32_t base = (uint32_t)(o->tile & 255) * 16;
+        if (gbCgb && (o->attr & 8)) base += 0x2000;
+        if (tall && (o->attr & 0x40)) base ^= 16;
+        for (int yy = 0; yy < 8; ++yy) {
+            int row = (o->attr & 0x40) ? 7 - yy : yy;
+            for (int xx = 0; xx < 8; ++xx) {
+                int col = (o->attr & 0x20) ? 7 - xx : xx;
+                int idx = gbTilePixel(base, col, row);
+                if (gbObjectRomTiles[k]) {
+                    const uint8_t* tile = gbObjectRomTiles[k] + row * 2;
+                    idx = ((tile[0] >> (7-col)) & 1) | (((tile[1] >> (7-col)) & 1) << 1);
+                }
+                if (idx) voxelSpritePixel(view, x0+xx, y0+yy, foot, k, gbObjColor((uint8_t)o->attr, idx, alpha));
+            }
+        }
+    }
+}
+
+static bool redVoxelDraw(const struct GbSnap* snap, int ox, int oy, struct PkWideView v, uint32_t alpha) {
+    if (gbRam(0xD35E) != 0 || snap->tileset != 0 || snap->blockset != 0x645e0 ||
+        snap->w != 10 || snap->h != 9 || !voxelViewportFits(v.w, v.h)) return false;
+    struct VoxelSourceWindow window = voxelSourceWindow(ox, oy, v.x, v.y, v.w, v.h, 0);
+    int w = window.right - window.left, h = window.bottom - window.top;
+    if (w <= 0 || h <= 0 || w > PK_WIDE_MAX_VIEW_W || h > PK_WIDE_MAX_VIEW_H) return false;
+    static uint32_t art[GB_BUF], floor[GB_BUF], depth[VOXEL_MAX_W*VOXEL_MAX_H];
+    static uint8_t rises[GB_BUF/(VOXEL_TILE*VOXEL_TILE)];
+    gbDraw(snap, ox, oy, window.left, window.top, w, h, art, w, alpha, false, true);
+    int cols = w / VOXEL_TILE, rows = h / VOXEL_TILE;
+    struct VoxelView view = {
+        gbRaw, depth, art, v.w, v.h, ox+v.x+v.w/2, oy+v.y+v.h/2,
+        ox+window.left, oy+window.top, cols, rows, w, rises
+    };
+    for (int y = 0; y < rows; ++y) {
+        for (int x = 0; x < cols; ++x) {
+            enum RedMaterial material = redMaterialAt((view.left/16)+x-6, (view.top/16)+y-6);
+            const struct RedMaterialStyle* style = &redStyles[material];
+            rises[y*cols+x] = style->rise;
+            for (int dy = 0; dy < VOXEL_TILE; ++dy) {
+                int at = (y*VOXEL_TILE+dy)*w + x*VOXEL_TILE;
+                for (int dx = 0; dx < VOXEL_TILE; ++dx) {
+                    uint32_t color = art[at+dx];
+                    art[at+dx] = redTint(color, style);
+                    floor[at+dx] = style->rise ? redTint(alpha|0x00eeeeeeu, &redStyles[RED_FIELD]) : art[at+dx];
+                }
+            }
+        }
+    }
+    voxelTerrainWithFloor(&view, floor);
+    redVoxelActors(&view, ox, oy, alpha);
+    return true;
+}
