+/* Draw the lit surfaces of an axis-aligned solid through the same depth
+ * buffer as the shared ground projection and the game's live actors. */
+static void redBox(const struct VoxelView* v, int x, int y, int w, int h, int z, int height,
+                   uint32_t tone) {
+    int front = y+h;
+    int top = z+height;
+    if (front < v->top || y >= v->top+v->rows*VOXEL_TILE) return;
+    for (int yy=y; yy<front; ++yy) {
+        int left = voxelX(v,x,yy), sy = voxelY(v,yy,top);
+        for (int dx=0; dx<w; ++dx) voxelPixel(v,left+dx,sy,yy,tone);
+        for (int dz=z; dz<top; ++dz)
+            voxelPixel(v,left,voxelY(v,yy,dz),yy,voxelShade(tone,165));
+    }
+    int left = voxelX(v,x,front);
+    for (int dz=z; dz<top; ++dz) {
+        int sy=voxelY(v,front,dz);
+        for (int dx=0; dx<w; ++dx) voxelPixel(v,left+dx,sy,front,voxelShade(tone,200));
+    }
+}
+
+#define RED_COLOR(r,g,b) ((r) | ((g)<<8) | ((b)<<16))
+
+static void redHouse(const struct VoxelView* v, const uint32_t* art, int x, int y,
+                     int w, int h, int height, uint32_t alpha) {
+    int front=y+h;
+    if (front < v->top || y >= v->top+v->rows*VOXEL_TILE) return;
+    redBox(v,x,y,w,h,0,height,alpha|RED_COLOR(218,191,149));
+    int left=voxelX(v,x,front);
+    for (int dz=0; dz<height; ++dz) {
+        int wy=front-1-dz*16/height;
+        if (wy < v->top || wy >= v->top+v->rows*VOXEL_TILE) continue;
+        for (int dx=0; dx<w; ++dx) {
+            int sx=x+dx-v->left;
+            if ((unsigned)sx >= (unsigned)v->stride) continue;
+            uint32_t ink=art[(wy-v->top)*v->stride+sx];
+            voxelPixel(v,left+dx,voxelY(v,front,dz),front,
+                       redTint(ink,&redStyles[RED_WALL]));
+        }
+    }
+    uint32_t roof=alpha|(w>70 ? RED_COLOR(104,143,156) : RED_COLOR(195,110,93));
+    for (int step=0; step<5; ++step) {
+        int inset=step*3;
+        redBox(v,x-2+step,y-2+inset,w+4-2*step,h+4-2*inset,height+step*2,2,
+               voxelShade(roof,228+step*7));
+    }
+}
+
+static void redTree(const struct VoxelView* v, int x, int y, uint32_t alpha) {
+    redBox(v,x-2,y-2,4,4,0,11,alpha|RED_COLOR(122,90,67));
+    redBox(v,x-6,y-6,12,12,7,5,alpha|RED_COLOR(83,133,92));
+    redBox(v,x-7,y-7,14,14,11,5,alpha|RED_COLOR(106,153,103));
+    redBox(v,x-5,y-5,10,10,15,5,alpha|RED_COLOR(126,173,115));
+    redBox(v,x-3,y-3,6,6,19,4,alpha|RED_COLOR(154,192,133));
+}
