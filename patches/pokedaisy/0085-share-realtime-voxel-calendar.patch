+// Shared civil-date seasons and absolute weather slots for voxel rendering.
+#pragma once
+#include <stdint.h>
+#include <time.h>
+
+enum { CLIMATE_TRANSITION_DAYS = 14, CLIMATE_FRONT_SECONDS = 10800,
+       CLIMATE_FRONT_FADE_SECONDS = 900 };
+
+struct VoxelCalendarSample {
+    int valid;
+    int season;   // Spring, summer, autumn, winter.
+    unsigned previousSeasonBlend;
+    int weather;  // Clear, rain, snow, fog are 1 through 4.
+    unsigned weatherBlend;
+};
+
+/* Stable pseudo-random fronts. Equivalent to the FireRed pilot's hash,
+ * but with the three-hour slot passed directly. No gameplay RNG is used. */
+static int voxelCalendarWeather(uint64_t slot, int season) {
+    uint32_t x = (uint32_t)slot ^ 0x6d2b79f5u;
+    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15;
+    x *= 0x846ca68bu; x ^= x >> 16;
+    unsigned roll = x % 100u;
+    static const unsigned clear[4] = {50, 70, 45, 45};
+    if (season < 0 || season > 3) season = 0;
+    if (roll < clear[season]) return 1;
+    if (roll >= 90) return 4;
+    return season == 3 ? 3 : 2;
+}
+
+/* Civil dates advance the palette fade once per day. Absolute time advances
+ * weather so repeated local hours and map reloads do not reroll a front. */
+static struct VoxelCalendarSample voxelCalendarAt(time_t now, const struct tm* local) {
+    struct VoxelCalendarSample sample = {0};
+    if (now < 0 || !local || (unsigned)local->tm_mon >= 12 ||
+        local->tm_mday < 1 || local->tm_mday > 31) return sample;
+
+    sample.valid = 1;
+    unsigned month = (unsigned)(local->tm_mon + 10) % 12u;
+    sample.season = (int)(month / 3u);
+    if (month % 3u == 0 && local->tm_mday <= CLIMATE_TRANSITION_DAYS) {
+        unsigned days = (unsigned)(local->tm_mday - 1);
+        sample.previousSeasonBlend = 256u - days * 256u / CLIMATE_TRANSITION_DAYS;
+    }
+
+    uint64_t seconds = (uint64_t)now;
+    sample.weather = voxelCalendarWeather(seconds / CLIMATE_FRONT_SECONDS, sample.season);
+    unsigned phase = (unsigned)(seconds % CLIMATE_FRONT_SECONDS);
+    unsigned end = CLIMATE_FRONT_SECONDS - phase;
+    unsigned edge = phase < end ? phase : end;
+    sample.weatherBlend = edge < CLIMATE_FRONT_FADE_SECONDS
+        ? edge * 256u / CLIMATE_FRONT_FADE_SECONDS : 256u;
+    return sample;
+}
+
+static struct VoxelCalendarSample voxelCalendarNow(void) {
+    time_t now = time(NULL);
+    struct tm local;
+    return voxelCalendarAt(now, now >= 0 && localtime_r(&now, &local) ? &local : NULL);
+}
