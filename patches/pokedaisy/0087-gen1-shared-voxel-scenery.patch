+static enum RedMaterial gbVoxelMaterial(const struct GbSnap* s, int cx, int cy,
+                                       bool classicTiles, bool pallet) {
+    int x=cx-6, y=cy-6;
+    if (pallet && (unsigned)x<20 && (unsigned)y<18) return redMaterialAt(x,y);
+    if (!classicTiles) return RED_NATIVE;
+    switch(gbVoxelSignature(s,cx,cy)) {
+    case 0x3b3a2b2au: return RED_TREE;
+    case 0x55550e0eu: return RED_POST;
+    case 0x57564746u: return RED_SIGN;
+    case 0x2c032c2cu: case 0x032c2c2cu:
+    case 0x2c2c032cu: case 0x2c2c2c03u: return RED_FLOWER;
+    case 0x14141414u: case 0x54141414u: case 0x14141432u: return RED_WATER;
+    case 0x23232323u: case 0x39393939u: case 0x52525252u:
+    case 0x23232339u: case 0x23392323u: case 0x23233923u:
+    case 0x2c2c2c2cu: return RED_FIELD;
+    default: return RED_NATIVE;
+    }
+}
