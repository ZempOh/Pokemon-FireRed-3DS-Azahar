+/* Recognize a complete roof and both wall ends. Unknown layouts retain their
+ * live flat textures instead of clearing ground under unmatched fragments. */
+static struct GbVoxelHouse gbVoxelHouseAt(const struct GbSnap* s, int x, int y) {
+    uint32_t first=gbVoxelSignature(s,x,y);
+    bool tall=first==0x38150605u;
+    if (!tall && first!=0x16150605u) return (struct GbVoxelHouse){0};
+    uint32_t middle=tall ? 0x12125353u : 0x17170707u;
+    uint32_t end=tall ? 0x19380908u : 0x19180908u;
+    int width;
+    for (width=1; width<12 && gbVoxelSignature(s,x+width,y)==middle; ++width) {}
+    if (width<2 || gbVoxelSignature(s,x+width,y)!=end) return (struct GbVoxelHouse){0};
+    int rows=2;
+    uint32_t left=gbVoxelSignature(s,x,y+1);
+    uint32_t right=gbVoxelSignature(s,x+width,y+1);
+    if (tall) {
+        rows=4;
+        if (left!=0x16153815u || right!=0x19181938u ||
+            gbVoxelSignature(s,x,y+2)!=0x220f2625u ||
+            gbVoxelSignature(s,x,y+3)!=0x1a4e0a0fu ||
+            gbVoxelSignature(s,x+width,y+3)!=0x4f1a1f0au) return (struct GbVoxelHouse){0};
+    } else if (left==0x175c2625u && right==0x5d172928u) {
+        rows=3;
+        if (gbVoxelSignature(s,x,y+2)!=0x1a4e220fu ||
+            gbVoxelSignature(s,x+width,y+2)!=0x4f1a1f22u) return (struct GbVoxelHouse){0};
+    } else if (left!=0x1a4e2625u || right!=0x4f1a2928u) {
+        return (struct GbVoxelHouse){0};
+    }
+    return (struct GbVoxelHouse){x,y,width+1,rows};
+}
