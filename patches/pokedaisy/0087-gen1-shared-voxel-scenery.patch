+/* Profiles use the live 2x2 tile signatures. The standard overworld
+ * tileset is checked as a family before its material rules are enabled.
+ * Other tilesets keep their source colors and gain the depth camera. */
+static uint32_t gbVoxelSignature(const struct GbSnap* s, int cx, int cy) {
+    int tx=cx*2, ty=cy*2;
+    return (uint32_t)gbTile(s,tx,ty) | ((uint32_t)gbTile(s,tx+1,ty)<<8)
+        | ((uint32_t)gbTile(s,tx,ty+1)<<16) | ((uint32_t)gbTile(s,tx+1,ty+1)<<24);
+}
