+// A four-unit thickness projects one pixel left and three pixels up.
+// Every rear sample carries its own world depth, so foreground terrain and
+// the original front face can occlude the exposed sides.
+static void voxelActorPixel(const struct VoxelView* v, int x, int y, int foot, int order, uint32_t color) {
+    if (foot >= v->top + 4) {
+        uint32_t side = voxelShade(color, 175);
+        voxelSpritePixel(v, x - 1, y - 3, foot - 4, order, side);
+        voxelSpritePixel(v, x - 1, y - 2, foot - 3, order, side);
+        voxelSpritePixel(v, x, y - 1, foot - 2, order, voxelShade(color, 213));
+    }
+    voxelSpritePixel(v, x, y, foot, order, color);
+}
