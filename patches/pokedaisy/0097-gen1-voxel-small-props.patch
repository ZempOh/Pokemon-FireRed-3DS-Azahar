+// Small opaque props share the field projection and terrain depth buffer.
+static void voxelPropBox(const struct VoxelView* v, int x, int y, int w, int d,
+                         int z, int h, uint32_t material) {
+    int front = y + d;
+    int limit = v->top + v->rows * VOXEL_TILE;
+    if (front < v->top || front >= limit) return;
+    int back = y < v->top ? v->top : y;
+    uint32_t side = voxelShade(material, 170);
+    uint32_t face = voxelShade(material, 208);
+    for (int wy = back; wy < front; ++wy) {
+        int sx = voxelX(v, x, wy);
+        int sy = voxelY(v, wy, z+h);
+        for (int i = 0; i < w; ++i) voxelPixel(v, sx+i, sy, wy, material);
+        for (int i = 1; i <= h; ++i) voxelPixel(v, sx, sy+i, wy, side);
+    }
+    int sx = voxelX(v, x, front);
+    int sy = voxelY(v, front, z+h);
+    for (int row = 0; row < h; ++row)
+        for (int col = 0; col < w; ++col)
+            voxelPixel(v, sx+col, sy+row, front, face);
+}
+
+static void voxelGrassTuft(const struct VoxelView* v, int x, int y, int z,
+                           uint32_t base, uint32_t tip) {
+    voxelPropBox(v, x-2, y-1, 2, 2, z, 4, base);
+    voxelPropBox(v, x-1, y-2, 2, 2, z, 7, tip);
+    voxelPropBox(v, x+1, y, 2, 2, z, 5, base);
+}
