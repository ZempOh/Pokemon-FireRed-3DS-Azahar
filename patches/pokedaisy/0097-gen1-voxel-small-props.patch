+/* Each pipe cell is made entirely from rail, joint and clear base art.
+ * Require the complete four-tile pattern so roofs and terrain stay intact. */
+static bool gbVoxelPipe(uint32_t signature) {
+    if (signature==0x23232323u) return false;
+    for (int i=0; i<4; ++i, signature>>=8) {
+        unsigned tile=signature & 255u;
+        if (tile!=0x10 && tile!=0x20 && tile!=0x21 && tile!=0x23) return false;
+    }
+    return true;
+}
+
+static void redPipe(const struct VoxelView* v, int x, int y, uint32_t signature, uint32_t color) {
+    for (int i=0; i<4; ++i, signature>>=8) {
+        int qx=x+(i%2)*8, qy=y+(i/2)*8;
+        unsigned tile=signature & 255u;
+        if (tile==0x10) voxelPropBox(v,qx+3,qy,2,8,4,2,color);
+        if (tile==0x20) voxelPropBox(v,qx,qy+3,8,2,4,2,color);
+        if (tile==0x21) {
+            voxelPropBox(v,qx+2,qy+2,4,4,0,7,color);
+            voxelPropBox(v,qx+3,qy+3,2,2,7,1,color);
+        }
+    }
+}
