+/* Original slate relief texture shared by the Gen 1 and GBA rasterizers. */
+#pragma once
+#include <stdint.h>
+
+#ifndef VOXEL_ROOF_TEXTURE_SIZE
+#define VOXEL_ROOF_TEXTURE_SIZE 256
+#endif
+
+/* Build the periodic material once on the field-render thread. Each shingle
+ * has a recessed joint, two bevels, and subtle grain across its exposed face.
+ * The texture stores prelit relief. The live roof supplies the color. */
+static const uint8_t* voxelRoofTexture(void) {
+    enum { size = VOXEL_ROOF_TEXTURE_SIZE };
+    static uint8_t atlas[size * size];
+    static int ready;
+    if (ready) return atlas;
+    for (unsigned y = 0; y < size; ++y) {
+        const unsigned v = (y * 256u + 128u) / size;
+        const unsigned row = v / 64u, localV = v & 63u;
+        for (unsigned x = 0; x < size; ++x) {
+            const unsigned u = ((x * 256u + 128u) / size + (row & 1u) * 32u) & 255u;
+            const unsigned column = u / 64u, localU = u & 63u;
+            unsigned light = 246u - (column * 11u + row * 17u) % 12u;
+            light -= (localU * 3u + localV / 4u) % 7u;
+            if (localV < 5u || localU < 5u) light = 193u;
+            else if (localV < 11u || localU < 10u) light = 220u;
+            else if (localV >= 55u || localU >= 58u) light = 255u;
+            atlas[y * size + x] = (uint8_t)light;
+        }
+    }
+    ready = 1;
+    return atlas;
+}
+
+/* A repeat covers 32×32 world units. Inputs have eight substeps per unit,
+ * independent of the atlas resolution; the 16-texel host control uses the
+ * same pattern and physical size as the runtime 256-texel texture. */
+static unsigned voxelRoofSample(const uint8_t* atlas, int x8, int y8) {
+    const unsigned x = ((unsigned)x8 & 255u) * VOXEL_ROOF_TEXTURE_SIZE / 256u;
+    const unsigned y = ((unsigned)y8 & 255u) * VOXEL_ROOF_TEXTURE_SIZE / 256u;
+    return atlas[y * VOXEL_ROOF_TEXTURE_SIZE + x];
+}
