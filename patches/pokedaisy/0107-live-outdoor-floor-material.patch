+        sceneryOutdoor(solidRom,s->group,s->num,(int)mapType)) {
+        uint8_t groundCells[sizeof(rises)];
+        for (int row=0; row<rows; ++row)
+            for (int col=0; col<cols; ++col)
+                groundCells[row*cols+col] = solidGroundMaterial(s,cellX+col,cellY+row);
