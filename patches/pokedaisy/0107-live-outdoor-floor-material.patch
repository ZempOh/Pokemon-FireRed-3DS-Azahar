diff --git a/app/src/main/cpp/pk_voxel_ground_material.h b/app/src/main/cpp/pk_voxel_ground_material.h
new file mode 100644
index 0000000..d254dc6
--- /dev/null
+++ b/app/src/main/cpp/pk_voxel_ground_material.h
@@ -0,0 +1,43 @@
+/* Original granular surface relief for reviewed outdoor floor cells. */
+#pragma once
+
+#ifndef VOXEL_GROUND_TEXTURE_SIZE
+#define VOXEL_GROUND_TEXTURE_SIZE 256
+#endif
+
+struct VoxelGroundMaterial {
+    const uint8_t* cells;
+    int offsetX, offsetY;
+};
+
+static unsigned voxelGroundGrain(unsigned x, unsigned y) {
+    uint32_t seed = (x & 31u) + ((y & 31u) << 5);
+    seed = (seed ^ (seed >> 5)) * 0x7feb352du;
+    seed = (seed ^ (seed >> 15)) * 0x846ca68bu;
+    return (seed ^ (seed >> 16)) >> 28;
+}
+
+/* Cache one periodic material. A coarse grain lattice gives the relief
+ * broader shapes than single-pixel noise even with nearest-neighbor display. */
+static const uint8_t* voxelGroundTexture(void) {
+    enum { size = VOXEL_GROUND_TEXTURE_SIZE };
+    static uint8_t atlas[size * size];
+    static int ready;
+    if (ready) return atlas;
+    for (unsigned y = 0; y < size; ++y) {
+        unsigned v = (y * 256u + 128u) / size, row = v >> 3, fy = v & 7u;
+        for (unsigned x = 0; x < size; ++x) {
+            unsigned u = (x * 256u + 128u) / size, col = u >> 3, fx = u & 7u;
+            unsigned a = voxelGroundGrain(col, row) * (8u - fx) + voxelGroundGrain(col + 1u, row) * fx;
+            unsigned b = voxelGroundGrain(col, row + 1u) * (8u - fx) + voxelGroundGrain(col + 1u, row + 1u) * fx;
+            atlas[y * size + x] = (uint8_t)(239u + (a * (8u - fy) + b * fy) / 64u);
+        }
+    }
+    ready = 1;
+    return atlas;
+}
+
+/* The 16-texel control uses the same relief and 64-world-pixel repeat. */
+static unsigned voxelGroundTexel(int coordinate4) {
+    return ((unsigned)coordinate4 & 255u) * VOXEL_GROUND_TEXTURE_SIZE / 256u;
+}
