+/* Start with the reviewed FireRed Pallet primary floor. Extend this gate
+ * from exact cartridge/tileset fixtures as additional floor art is reviewed. */
+static bool solidGroundMaterial(const struct Snap* s, int x, int y) {
+    if ((unsigned)(x - MAP_OFFSET) >= (unsigned)s->width ||
+        (unsigned)(y - MAP_OFFSET) >= (unsigned)s->height) return false;
+    int conn, id = blockIn(s,x,y,&conn,false);
+    if (conn >= 0) return false;
+    switch (id) {
+    case 0x008: case 0x009: case 0x011:
+    case 0x285: case 0x286: case 0x288: case 0x28c: case 0x28e:
+    case 0x28f: case 0x290: case 0x295: case 0x296: case 0x297:
+    case 0x29e: case 0x29f: case 0x2a6: case 0x2a7: case 0x2ae:
+    case 0x2af: case 0x2b6: case 0x2be: case 0x2bf: case 0x2c6:
+    case 0x2c7: case 0x2ce:
+        return true;
+    default:
+        return false;
+    }
+}
