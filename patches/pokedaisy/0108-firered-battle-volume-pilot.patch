+static void battleVolumeDraw(const uint32_t* frame, uint32_t* out, struct PkWideView v, uint32_t alpha) {
+    // Only the reviewed FireRed opponent front picture is enrolled.
+    if (!voxelEnabled || solidRom != 0xdd88761cu || lineIoFrames < 2 ||
+        lineOamN != 1 || linePalN != 1 || tintShown) return;
+    const uint16_t* oam = lineOamBuf[0];
+    const uint8_t* vram = (const uint8_t*)G->video.vram;
+    const uint8_t* art = NULL;
+    int target = -1, ox = 0, oy = 0, palette = 0;
+    for (int k = 0; k < 128; ++k) {
+        const uint16_t* a = oam + k * 4;
+        if ((a[0] & 0xff00) != 0x0100 || (a[1] & 0xc000) != 0xc000) continue;
+        int x = a[1] & 511, y = a[0] & 255;
+        int p = (a[2] >> 10) & 3, tile = a[2] & 1023;
+        if (x != 144 || y != 21 || p != 2 || tile > 960) continue;
+        const uint8_t* candidate = vram + 0x10000 + tile*32;
+        if (battleVolumeFingerprint(candidate, 2048) != 0x1e472829u) continue;
+        const uint16_t* matrix = oam + ((a[1] >> 9) & 31) * 16;
+        if (matrix[3] != 256 || matrix[7] || matrix[11] || matrix[15] != 256) return;
+        if (target >= 0) return;
+        target = k; ox = x; oy = y; palette = 256 + (a[2] >> 12)*16; art = candidate;
+    }
+    if (target < 0) return;
+    static struct BattleVolume mesh;
+    static bool built;
+    if (!built) {
+        battleVolumeBuild(&mesh, art, .44f, -.39f);
+        built = true;
+    }
+    uint8_t blocked[BATTLE_VOLUME_SIZE][BATTLE_VOLUME_SIZE] = {0};
+    battleVolumeProtect(oam,target,ox-BATTLE_VOLUME_MARGIN,oy-BATTLE_VOLUME_MARGIN,blocked);
+    bool safeLine[BATTLE_VOLUME_SIZE] = {0};
+    // Require ordinary mode-0 1D sprites and palette on the source lines.
+    for (int row = 0; row < BATTLE_VOLUME_SIZE; ++row) {
+        int y = oy + row - BATTLE_VOLUME_MARGIN;
+        if (y < 0 || y >= BATTLE_TEXT_TOP) continue;
+        useLine(y);
+        if ((io(0) & 0x10c7) != 0x1040 || io(0x50) & 0x00c0 || io(0x4c)) continue;
+        if ((io(0x08)|io(0x0a)|io(0x0c)|io(0x0e)) & 0x40) continue;
+        safeLine[row] = true;
+    }
+    for (int row = 0; row < BATTLE_VOLUME_SIZE; ++row) {
+        int y = oy + row - BATTLE_VOLUME_MARGIN;
+        if (!safeLine[row] || y < v.y || y >= v.y+v.h) continue;
+        useLine(y);
+        for (int col = 0; col < BATTLE_VOLUME_SIZE; ++col) {
+            const struct BattleVolumePixel* pixel = &mesh.pixels[row][col];
+            if (!pixel->ink) continue;
+            int x = ox + col - BATTLE_VOLUME_MARGIN;
+            if (x < 0 || x >= PK_WIDE_W || x < v.x || x >= v.x+v.w) continue;
+            int sx = x-ox, sy = y-oy;
+            unsigned live = (unsigned)sx < 64 && (unsigned)sy < 64 ? mesh.mask[sy][sx] : 0;
+            if (!live && pixel->face == 1) continue;
+            if ((windowLayers(x,y) & 0x18) != 0x18 || blocked[row][col]) continue;
+            int pal;
+            bool covered = false;
+            for (int b = 0; b < 3; ++b)
+                if ((io(0) & (0x100<<b)) && bgPixel(b,x,y,&pal)) covered = true;
+            if (covered || (io(0x0e)&3) < 2) continue;
+            unsigned arena = bgPixel(3,x,y,&pal);
+            if (!live && !arena) continue;
+            uint32_t expected = color(P[live ? palette + live : pal + arena],alpha);
+            const uint32_t native = frame[y*PK_WIDE_W+x];
+            if ((expected ^ native) & 0x00ffffffu) continue;
+            uint32_t ink = color(P[palette + pixel->ink],alpha);
+            // mGBA uses the high byte for internal pixel flags on this host.
+            out[(y-v.y)*v.w+x-v.x] = (native & 0xff000000u) | (voxelShade(ink,pixel->light) & 0x00ffffffu);
+        }
+    }
+    useLive();
+}
