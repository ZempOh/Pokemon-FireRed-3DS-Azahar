+/* Private FireRed fixture pilot. The native 2D pipeline is authoritative. */
+#pragma once
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+enum { BATTLE_VOLUME_ART = 64, BATTLE_VOLUME_SIZE = 68, BATTLE_VOLUME_MARGIN = 2 };
+
+struct BattleVolumePixel {
+    float depth;
+    uint8_t ink, light, face;
+};
+
+struct BattleVolume {
+    struct BattleVolumePixel pixels[BATTLE_VOLUME_SIZE][BATTLE_VOLUME_SIZE];
+    uint8_t mask[BATTLE_VOLUME_ART][BATTLE_VOLUME_ART];
+};
+
+struct BattleVolumeVertex { float x, y, z; };
+
+static uint32_t battleVolumeFingerprint(const uint8_t* data, unsigned size) {
+    uint32_t hash = 2166136261u;
+    for (unsigned i = 0; i < size; ++i) hash = (hash ^ data[i]) * 16777619u;
+    return hash;
+}
+
+static unsigned battleVolumeInk(const uint8_t* art, int x, int y) {
+    unsigned off = ((y / 8) * 8 + x / 8) * 32 + y % 8 * 4 + x % 8 / 2;
+    return (art[off] >> ((x & 1) * 4)) & 15;
+}
+
+static unsigned battleVolumeThickness(uint8_t depth[64][64], int x, int y) {
+    return (unsigned)x < 64 && (unsigned)y < 64 ? depth[y][x] : 0;
+}
+
+static unsigned battleVolumeDistance(uint8_t depth[64][64], int x, int y) {
+    unsigned neighbor = battleVolumeThickness(depth,x,y);
+    return neighbor ? neighbor + 1 : 2; // A visible rim even on straight edges.
+}
+
+static void battleVolumeTriangle(struct BattleVolume* mesh, struct BattleVolumeVertex a,
+        struct BattleVolumeVertex b, struct BattleVolumeVertex c, uint8_t ink, uint8_t light,
+        uint8_t face, float yaw, float pitch) {
+    struct BattleVolumeVertex v[3] = {a, b, c};
+    for (int i = 0; i < 3; ++i) {
+        v[i].x += BATTLE_VOLUME_MARGIN + v[i].z * yaw;
+        v[i].y += BATTLE_VOLUME_MARGIN + v[i].z * pitch;
+    }
+    a = v[0]; b = v[1]; c = v[2];
+    float det = (b.y-c.y)*(a.x-c.x) + (c.x-b.x)*(a.y-c.y);
+    if (fabsf(det) < .0001f) return;
+    int x0 = (int)floorf(fminf(a.x, fminf(b.x,c.x)));
+    int y0 = (int)floorf(fminf(a.y, fminf(b.y,c.y)));
+    int x1 = (int)ceilf(fmaxf(a.x, fmaxf(b.x,c.x)));
+    int y1 = (int)ceilf(fmaxf(a.y, fmaxf(b.y,c.y)));
+    for (int y = y0; y < y1; ++y) for (int x = x0; x < x1; ++x) {
+        if ((unsigned)x >= BATTLE_VOLUME_SIZE || (unsigned)y >= BATTLE_VOLUME_SIZE) continue;
+        float u = ((b.y-c.y)*(x+.5f-c.x) + (c.x-b.x)*(y+.5f-c.y)) / det;
+        float w = ((c.y-a.y)*(x+.5f-c.x) + (a.x-c.x)*(y+.5f-c.y)) / det;
+        float r = 1.f-u-w;
+        if (u < -.0001f || w < -.0001f || r < -.0001f) continue;
+        float z = u*a.z + w*b.z + r*c.z;
+        struct BattleVolumePixel* pixel = &mesh->pixels[y][x];
+        if (!pixel->ink || z < pixel->depth)
+            *pixel = (struct BattleVolumePixel){ z, ink, light, face };
+    }
+}
+
+static void battleVolumeQuad(struct BattleVolume* mesh, struct BattleVolumeVertex a,
+        struct BattleVolumeVertex b, struct BattleVolumeVertex c, struct BattleVolumeVertex d,
+        uint8_t ink, uint8_t light, uint8_t face, float yaw, float pitch) {
+    battleVolumeTriangle(mesh, a, b, c, ink, light, face, yaw, pitch);
+    battleVolumeTriangle(mesh, a, c, d, ink, light, face, yaw, pitch);
+}
+
+static void battleVolumeBuild(struct BattleVolume* mesh, const uint8_t* art, float yaw, float pitch) {
+    uint8_t depths[64][64];
+    memset(mesh, 0, sizeof(*mesh));
+    for (int y = 0; y < 64; ++y) for (int x = 0; x < 64; ++x) {
+        mesh->mask[y][x] = (uint8_t)battleVolumeInk(art, x, y);
+        depths[y][x] = mesh->mask[y][x] ? 5 : 0;
+    }
+    for (int y = 0; y < 64; ++y) for (int x = 0; x < 64; ++x) {
+        unsigned left = battleVolumeDistance(depths,x-1,y), above = battleVolumeDistance(depths,x,y-1);
+        if (left < depths[y][x]) depths[y][x] = left;
+        if (above < depths[y][x]) depths[y][x] = above;
+    }
+    for (int y = 63; y >= 0; --y) for (int x = 63; x >= 0; --x) {
+        unsigned right = battleVolumeDistance(depths,x+1,y), below = battleVolumeDistance(depths,x,y+1);
+        if (right < depths[y][x]) depths[y][x] = right;
+        if (below < depths[y][x]) depths[y][x] = below;
+        if (!depths[y][x]) continue;
+    }
+    for (int y = 0; y < 64; ++y) for (int x = 0; x < 64; ++x) {
+        uint8_t ink = mesh->mask[y][x], size = depths[y][x];
+        if (!size) continue;
+        struct BattleVolumeVertex a = {x,y,0}, b = {x+1,y,0};
+        struct BattleVolumeVertex c = {x+1,y+1,0}, d = {x,y+1,0};
+        uint8_t light = 237 + size*3;
+        battleVolumeQuad(mesh,a,b,c,d,ink,light,1,yaw,pitch);
+        struct BattleVolumeVertex A={x,y,size}, B={x+1,y,size};
+        struct BattleVolumeVertex C={x+1,y+1,size}, D={x,y+1,size};
+        battleVolumeQuad(mesh,A,B,C,D,ink,170,5,yaw,pitch);
+        unsigned east = battleVolumeThickness(depths,x+1,y), north = battleVolumeThickness(depths,x,y-1);
+        unsigned west = battleVolumeThickness(depths,x-1,y), south = battleVolumeThickness(depths,x,y+1);
+        if (size > east) {
+            b.z = c.z = east;
+            battleVolumeQuad(mesh,b,c,C,B,ink,175,2,yaw,pitch);
+        }
+        if (size > north) {
+            a.z = b.z = north;
+            battleVolumeQuad(mesh,a,b,B,A,ink,254,3,yaw,pitch);
+        }
+        if (size > west) {
+            a.z = d.z = west;
+            battleVolumeQuad(mesh,a,d,D,A,ink,202,4,yaw,pitch);
+        }
+        if (size > south) {
+            c.z = d.z = south;
+            battleVolumeQuad(mesh,c,d,D,C,ink,154,6,yaw,pitch);
+        }
+    }
+}
