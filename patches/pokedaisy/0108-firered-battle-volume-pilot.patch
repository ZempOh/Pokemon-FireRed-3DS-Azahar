+static void battleVolumeProtect(const uint16_t* oam, int candidate, int ox, int oy,
+        uint8_t blocked[BATTLE_VOLUME_SIZE][BATTLE_VOLUME_SIZE]) {
+    for (int k = 0; k < 128; ++k) {
+        const uint16_t* a = oam + k * 4;
+        int affine = (a[0] >> 8) & 3;
+        int shape = a[0] >> 14, size = a[1] >> 14;
+        if (k == candidate || affine == 2 || shape > 2) continue;
+        int x = a[1] & 511, y = a[0] & 255;
+        int width = OBJ_DIMS[shape][size][0], height = OBJ_DIMS[shape][size][1];
+        if (affine == 3) { width *= 2; height *= 2; }
+        if (x >= 256) x -= 512;
+        if (y >= PK_WIDE_H) y -= 256;
+        int left = clampi(x-ox,0,BATTLE_VOLUME_SIZE);
+        int right = clampi(x+width-ox,0,BATTLE_VOLUME_SIZE);
+        int top = clampi(y-oy,0,BATTLE_VOLUME_SIZE);
+        int bottom = clampi(y+height-oy,0,BATTLE_VOLUME_SIZE);
+        for (int row = top; row < bottom; ++row)
+            memset(&blocked[row][left],1,(size_t)(right-left));
+    }
+}
