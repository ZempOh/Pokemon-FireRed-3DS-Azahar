+static bool gbPalletWaterTile(const struct GbSnap* snap, int tx, int ty) {
+    // This is an exact Pallet Town source window in world 8x8 tile units.
+    return tx >= 20 && tx < 28 && ty >= 40 && ty < 48 && gbTile(snap,tx,ty)==0x14;
+}
+
+static void gbPalletWater(const struct GbSnap* snap, const struct VoxelView* view,
+                          const uint32_t* art, uint32_t* floor, int width, int height) {
+    for (int top=0;top<height;top+=8) for(int left=0;left<width;left+=8) {
+        int tx=(view->left+left)/8, ty=(view->top+top)/8;
+        if (!gbPalletWaterTile(snap,tx,ty)) continue;
+        int east=1,west=1,north=1,south=1;
+        while(east<4 && gbPalletWaterTile(snap,tx+east,ty)) ++east;
+        while(west<4 && gbPalletWaterTile(snap,tx-west,ty)) ++west;
+        while(north<4 && gbPalletWaterTile(snap,tx,ty-north)) ++north;
+        while(south<4 && gbPalletWaterTile(snap,tx,ty+south)) ++south;
+        for(int y=0;y<8;++y) for(int x=0;x<8;++x) {
+            int bank=(north-1)*8+y;
+            int edge=waterNearer(waterNearer(west*8-8+x,east*8-1-x),
+                                 waterNearer(bank,south*8-1-y));
+            int at=(top+y)*width+left+x, mirror=top+y-2*bank-1;
+            uint32_t reflected=(unsigned)mirror<(unsigned)height ? art[mirror*width+left+x] : 0x00aaaaaau;
+            floor[at]=waterSurfacePixel(floor[at],reflected,tx*8+x,ty*8+y,edge,bank);
+        }
+    }
 }
 
