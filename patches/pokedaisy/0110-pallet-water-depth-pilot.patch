+static void fireRedPalletWater(const struct Snap* s, const struct VoxelView* view,
+                               int cellX, int cellY, uint32_t* texture) {
+    if (solidRom!=0xdd88761cu || s->group!=3 || s->num || s->primary!=0x082d4a94u ||
+        s->secondary!=0x082d4aacu || s->width!=24 || s->height!=20) return;
+    // Confirm the complete pure-water 2x2 patch before shading. Adjacent mixed
+    // wave/shore metatiles may have foreground art and keep their original pixels.
+    const int waterX=MAP_OFFSET+8, waterY=MAP_OFFSET+18;
+    for(int y=0;y<2;++y)for(int x=0;x<2;++x) {
+        int conn;
+        if(blockIn(s,waterX+x,waterY+y,&conn,false)!=0x12b || conn>=0) return;
+    }
+    for(int y=0;y<32;++y)for(int x=0;x<32;++x) {
+        int dx=(waterX-cellX)*16+x,dy=(waterY-cellY)*16+y;
+        if((unsigned)dx>=(unsigned)view->stride || (unsigned)dy>=(unsigned)(view->rows*16))continue;
+        int edge=waterNearer(waterNearer(x,31-x),waterNearer(y,31-y));
+        // Reflect the visible north bank/town art across the intervening shore.
+        const int bankStart=(waterY-cellY-1)*16;
+        int sample=bankStart-1-y;
+        uint32_t bank=(unsigned)sample<(unsigned)(view->rows*16)
+            ? texture[sample*view->stride+dx] : 0x00aaaaaau;
+        uint32_t* pixel=&texture[dy*view->stride+dx];
+        *pixel=waterSurfacePixel(*pixel,bank,waterX*16+x,waterY*16+y,edge,y);
+    }
+}
