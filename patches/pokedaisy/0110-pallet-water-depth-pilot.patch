--- /dev/null
+++ b/app/src/main/cpp/pk_water_surface.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <stdint.h>
+
+static int waterNearer(int a, int b) {
+    return a < b ? a : b;
+}
+
+static unsigned waterMix(unsigned a, unsigned b, unsigned weight) {
+    return (a * (256 - weight) + b * weight + 128) >> 8;
+}
+
+/* Water is admitted by an exact source profile before this function runs.
+ * Keep original animated wave contrast and all depth/terrain ownership. */
+static uint32_t waterSurfacePixel(uint32_t live, uint32_t bank, int x, int y,
+                                  int edge, int mirror) {
+    if (edge < 2) return live;
+    unsigned ramp = (unsigned)waterNearer(edge - 1, 8) * 16;
+    unsigned depth = (unsigned)waterNearer(edge, 18);
+    unsigned ripple = (unsigned)(y + (x >> 2)) & 15u;
+    unsigned reflected = mirror > 2 && mirror < 15 ? (unsigned)(15 - mirror) * 5u : 0;
+    reflected += ripple < 3 ? (3u - ripple) * 5u : 0;
+    unsigned lum = ((bank & 255) + 2 * ((bank >> 8) & 255) + ((bank >> 16) & 255)) >> 2;
+    unsigned r = live & 255, g = (live >> 8) & 255, b = (live >> 16) & 255;
+    unsigned deepR = r * (238 - depth * 4) >> 8;
+    unsigned deepG = g * (252 - depth * 2) >> 8;
+    unsigned deepB = waterMix(b, 162, depth * 2);
+    return (live & 0xff000000u)
+        | waterMix(r, waterMix(deepR, 86 + lum / 4, reflected), ramp)
+        | waterMix(g, waterMix(deepG, 143 + lum / 5, reflected), ramp) << 8
+        | waterMix(b, waterMix(deepB, 170 + lum / 5, reflected), ramp) << 16;
+}
