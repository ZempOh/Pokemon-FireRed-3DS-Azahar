+static void solidWinterCanopy(struct SolidTree* tree, const uint16_t* leaves[4], unsigned opacity) {
+    for (int v=8; v<=24; ++v) {
+        int y=v*32/48, row=y&15, inQuad=y/16*2;
+        uint32_t known=leaves[inQuad][row] | (uint32_t)leaves[inQuad+1][row]<<16;
+        if (!known) continue;
+        for (int u=8; u<=24; ++u) {
+            uint32_t bit=1u<<u;
+            if (known & bit) continue;
+            uint32_t left=known & (bit-1u), right=known & ~(bit-1u);
+            int before=left ? 31-__builtin_clz(left) : -32;
+            int after=right ? __builtin_ctz(right) : 64;
+            int sample=u-before <= after-u ? before : after;
+            uint32_t* texel=tree->art+v*32;
+            texel[u]=climateMix(texel[u],texel[sample],opacity);
+        }
+    }
+}
