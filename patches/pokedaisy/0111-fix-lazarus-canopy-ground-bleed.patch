+/* Use the reviewed leaf identity for the winter contribution only, so the
+ * exact original transitions at the two ends of winter stay continuous. */
+static uint32_t climateKnownWinterLeaf(uint32_t c, int groundMode) {
+    int season = voxelClimate.season;
+    unsigned blend = voxelClimate.seasonBlend;
+    unsigned previous = voxelClimate.seasonTransition;
+    uint32_t snow = climateMix(c,climateLeafTarget(c,3),blend);
+    if (season == 3)
+        return previous ? climateMix(snow,climateGroundColor(c,groundMode,2,blend),previous) : snow;
+    return climateMix(climateGroundColor(c,groundMode,season,blend),snow,previous);
+}
