+static bool sceneryWaterMap(const struct Snap* s, unsigned mapType) {
+    for (size_t i=0;i<sizeof(sceneryWaterMaps)/sizeof(*sceneryWaterMaps);++i) {
+        const struct SceneryWaterMap* profile=&sceneryWaterMaps[i];
+        if (profile->rom==solidRom && profile->group==s->group && profile->map==s->num &&
+            profile->primary==s->primary && profile->secondary==s->secondary &&
+            profile->width==s->width && profile->height==s->height && profile->type==mapType)
+            return true;
+    }
+    return false;
+}
+
+static bool sceneryWaterCell(const struct Snap* s, int x, int y) {
+    int col=x-MAP_OFFSET,row=y-MAP_OFFSET;
+    if ((unsigned)col>=(unsigned)s->width || (unsigned)row>=(unsigned)s->height) return false;
+    int conn;
+    return blockIn(s,x,y,&conn,false)==0x12b && conn<0;
+}
+
+static int sceneryWaterReach(const struct Snap* s, int x, int y, int dx, int dy) {
+    int hop=1;
+    while(hop<3 && sceneryWaterCell(s,x+hop*dx,y+hop*dy)) ++hop;
+    return hop;
+}
+
+struct WaterDeepTint { uint32_t key, rgb; };
+
+static void sceneryWaterDeep(int x, int row, int col, int stride, uint32_t* texture,
+                             struct WaterDeepTint cache[128]) {
+    for (int py=0;py<16;++py) for (int px=0;px<16;++px) {
+        uint32_t* pixel=&texture[(row*16+py)*stride+col*16+px];
+        uint32_t color=*pixel&0x00ffffffu;
+        unsigned phase=(unsigned)waterNearer((py+x*4+px/4)&15,3);
+        uint32_t key=(color | phase<<24)+1;
+        unsigned slot=(color ^ (color>>8) ^ (color>>16) ^ (phase*29)) & 127;
+        struct WaterDeepTint* value=&cache[slot];
+        if (value->key!=key) {
+            value->key=key;
+            value->rgb=waterSurfacePixel(color,0x00aaaaaau,0,(int)phase,18,16);
+        }
+        *pixel=(*pixel&0xff000000u)|value->rgb;
+    }
+}
+static void sceneryWaterDraw(const struct Snap* s, const struct VoxelView* view,
+                             int cellX, int cellY, uint32_t* texture) {
+    struct WaterDeepTint deep[128]={0};
+    for (int row=0;row<view->rows;++row) for (int col=0;col<view->cols;++col) {
+        int x=cellX+col,y=cellY+row;
+        if (!sceneryWaterCell(s,x,y)) continue;
+        bool covered=false;
+        for (int py=0;py<16 && !covered;++py)
+            covered=memchr(holeBuf[row*16+py]+col*16,1,16)!=NULL;
+        if (covered) continue;
+        int west=sceneryWaterReach(s,x,y,-1,0),east=sceneryWaterReach(s,x,y,1,0);
+        int north=sceneryWaterReach(s,x,y,0,-1),south=sceneryWaterReach(s,x,y,0,1);
+        if (west==3 && east==3 && north==3 && south==3) {
+            sceneryWaterDeep(x,row,col,view->stride,texture,deep);
+            continue;
+        }
+        for (int py=0;py<16;++py) for (int px=0;px<16;++px) {
+            int upper=(north-1)*16+py;
+            int lower=south*16-1-py;
+            int horizontal=waterNearer((west-1)*16+px,east*16-1-px);
+            int edge=waterNearer(horizontal,waterNearer(upper,lower));
+            if (edge<2) continue;
+            int srcX=col*16+px,srcY=row*16+py;
+            int mirror=srcY-2*upper-1;
+            uint32_t bank=0x00aaaaaau;
+            // Sample the original adjacent bank within the visible source
+            // window, never a previously touched water texel or a PPU hole.
+            if (y>MAP_OFFSET && upper<15 && (unsigned)mirror<(unsigned)(view->rows*16) &&
+                !holeBuf[mirror][srcX])
+                bank=texture[mirror*view->stride+srcX];
+            uint32_t* pixel=&texture[srcY*view->stride+srcX];
+            *pixel=waterSurfacePixel(*pixel,bank,x*16+px,y*16+py,edge,upper);
+        }
+    }
+}
