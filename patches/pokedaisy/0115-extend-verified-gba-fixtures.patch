+/* A freestanding sign is a timber post and an extruded live face. The
+ * source mask keeps cut corners and holes in hand-authored sign artwork. */
+static void solidSignDraw(const struct VoxelView* view, const struct SolidTree* surface,
+                          const struct SceneryFixture* profile) {
+    const struct SceneryFixtureArt* art=&sceneryFixtureArt[profile->art];
+    int x=surface->x, y=surface->y+9, z=surface->rise;
+    int width=art->box[2], height=art->box[3];
+    voxelPropBox(view,x+profile->x[0]-1,y-2,3,3,z,8,surface->art[0]);
+    for (int depth=2; depth>=0; --depth) {
+        int front=y+1-depth;
+        int sx=voxelX(view,x+art->box[0],front);
+        int sy=voxelY(view,front,z+4+height);
+        for (int row=0; row<height; ++row)
+            for (int col=0; col<width; ++col) {
+                if (!(art->mask[row]&(1u<<col))) continue;
+                uint32_t ink=surface->art[2+row*width+col];
+                voxelPixel(view,sx+col,sy+row,front,depth ? voxelShade(ink,188) : ink);
+            }
+    }
+}
