+/* Cast a soft contact shadow in the same grounded surface coordinates
+ * used by the live actor. Draw afterward to keep the original occlusion. */
+static void solidActorContactShadows(const struct VoxelView* v, const uint8_t* groundCells,
+                                      uint32_t* texture) {
+    static const uint8_t darkness[5][9] = {
+        {0,0,2,5,7,5,2,0,0},
+        {0,4,11,18,23,18,11,4,0},
+        {3,10,23,36,42,36,23,10,3},
+        {0,4,11,18,23,18,11,4,0},
+        {0,0,2,5,7,5,2,0,0},
+    };
+    const struct Piece* objects = pieces[shown];
+    for (int i = 0; i < npieces[shown]; ++i) {
+        const struct Piece* p = &objects[i];
+        if (!p->world || !p->actor || p->vegetation || p->copy || p->mode || p->rot) continue;
+        int x = p->x + p->w / 2;
+        int foot = p->y + p->h - 1;
+        int surface = voxelRiseAt(v, x, foot);
+        for (int dy = 0; dy < 5; ++dy) {
+            int y = foot + dy - 1 - v->top;
+            if ((unsigned)y >= (unsigned)v->rows * VOXEL_TILE) continue;
+            int row = y / VOXEL_TILE;
+            for (int dx = 0; dx < 9; ++dx) {
+                unsigned shade = darkness[dy][dx];
+                int pixel = x + dx - 4 - v->left;
+                if (!shade || (unsigned)pixel >= (unsigned)v->cols * VOXEL_TILE) continue;
+                int col = pixel / VOXEL_TILE;
+                if (!groundCells[row * v->cols + col] || voxelRise(v, col, row) != surface) continue;
+                uint32_t* target = texture + y * v->stride + pixel;
+                *target = voxelShade(*target, 256u - shade);
+            }
+        }
+    }
+}
