+/* Check the live deck, shore and water words, including original collision
+ * and elevation bits, before replacing any projected cliff-style face. */
+static const struct SceneryBridgeProfile* solidBridgeProfile(const struct Snap* s) {
+    for (unsigned i=0; i<sizeof(sceneryBridgeProfiles)/sizeof(*sceneryBridgeProfiles); ++i) {
+        const struct SceneryBridgeProfile* p=&sceneryBridgeProfiles[i];
+        if (p->crc!=solidRom || p->group!=s->group || p->map!=s->num ||
+            p->primary!=s->primary || p->secondary!=s->secondary) continue;
+        if (p->x+p->width>s->width || p->y+3>s->height ||
+            p->x+p->width+MAP_OFFSET>s->vw || p->y+3+MAP_OFFSET>s->vh) continue;
+        bool match=true;
+        for (unsigned y=0; y<3 && match; ++y) {
+            const uint16_t* live=s->vmap+(p->y+y+MAP_OFFSET)*s->vw+p->x+MAP_OFFSET;
+            match=!memcmp(live,p->cells[y],p->width*sizeof(*live));
+        }
+        if (match) return p;
+    }
+    return NULL;
+}
+
+static const struct VoxelBridgeSpan* solidBridgePrepare(const struct Snap* s,
+                                                         const struct SceneryBridgeProfile* p,
+                                                         int cx, int cy, uint32_t alpha,
+                                                         struct VoxelBridgeSpan* bridge) {
+    int x=p->x+1+MAP_OFFSET, y=p->y+1+MAP_OFFSET;
+    bridge->x=x*VOXEL_TILE-cx; bridge->y=y*VOXEL_TILE-cy;
+    bridge->width=(p->width-2)*VOXEL_TILE;
+    bridge->rise=terrainRise(s,x,y); bridge->spacing=p->pierSpacing;
+    int mid=p->cells[1][1] & C[PK_WIDE_METATILE_MASK];
+    bridge->beam=solidMaterialPixel(s,mid,p->inkX,p->inkY,alpha);
+    for (int y=0; y<VOXEL_TILE; ++y) for (int x=0; x<VOXEL_TILE; ++x)
+        bridge->water[y*VOXEL_TILE+x]=voxelShade(solidMaterialPixel(s,p->water,x,y,alpha),224);
+    return bridge;
+}
