+/* Add a short projected apron only below the verified native fascia.
+ * The deck stays on its original plane, as do local actors and collisions. */
+static void redBoardwalkApron(const struct VoxelView* view, int x, int y, int width, uint32_t wood) {
+    for (int sy=voxelY(view,y,0); sy<voxelY(view,y+8,0); ++sy) {
+        if ((unsigned)sy >= (unsigned)view->height) continue;
+        int worldY=voxelWorldY(view,sy,0);
+        int dy=worldY-y;
+        if ((unsigned)dy>=8u || worldY<view->top || worldY>=view->top+view->rows*VOXEL_TILE) continue;
+        int left=voxelX(view,x,worldY);
+        uint32_t floorDepth=(uint32_t)(worldY-view->top+1)*512u;
+        for (int dx=0; dx<width; ++dx) {
+            int sx=left+dx;
+            if ((unsigned)sx >= (unsigned)view->width) continue;
+            int at=sy*view->width+sx;
+            if (view->depth[at]!=floorDepth) continue;
+            if (dy<2) {
+                view->out[at]=voxelShade(wood,dy==0 ? 222u : 178u);
+                continue;
+            }
+            unsigned post=(unsigned)(dx-9)&31u;
+            if (post<5u && dy<7)
+                view->out[at]=voxelShade(wood,post<2u ? 166u : 201u);
+            else if (post<8u && dy>=5)
+                view->out[at]=voxelShade(view->out[at],214u);
+        }
+    }
+}
