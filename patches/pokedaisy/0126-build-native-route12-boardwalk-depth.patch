+static void redRoute12Boardwalks(const struct GbSnap* snap, const struct VoxelView* view, uint32_t alpha) {
+    enum { collar=6 };
+    if (!gbRoute12BoardwalkProfile || snap->w!=10 || snap->h!=54 ||
+        gbRam(gbCfg[GB_YCOORD]-3)!=0x17) return;
+    for (unsigned i=0; i<sizeof(gen1Route12Boardwalks)/sizeof(*gen1Route12Boardwalks); ++i) {
+        const struct Gen1Boardwalk* b=&gen1Route12Boardwalks[i];
+        bool matches=true;
+        for (int row=0; row<3 && matches; ++row)
+            for (int col=0; col<b->width; ++col)
+                if (gbVoxelSignature(snap,collar+b->x+col,collar+b->deck+row)!=b->rows[row][col]) {
+                    matches=false;
+                    break;
+                }
+        if (matches)
+            redBoardwalkApron(view,(collar+b->x)*VOXEL_TILE,(collar+b->deck+1)*VOXEL_TILE+8,
+                             b->width*VOXEL_TILE,alpha|RED_COLOR(148,128,92));
+    }
+}
