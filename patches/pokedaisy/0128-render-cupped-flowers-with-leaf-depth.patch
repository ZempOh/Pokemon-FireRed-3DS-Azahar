+/* A petal has its own cupped top, edge and underside. Place the stem and
+ * blossom at their registered ground anchor and shade their sides with the live ink. */
+static void flowerPetal(const struct VoxelView* v,const struct SolidTree* t,
+                       float x,float y,float z,float dx,float dy,
+                       float length,float width,float curl,int ink,unsigned shade) {
+    const float u=ink+.5f, w=.5f;
+    struct SolidVertex root={x,y,z,u,w};
+    struct SolidVertex left={x+dx*length*.6f-dy*width,y+dy*length*.6f+dx*width,z+curl*.48f,u,w};
+    struct SolidVertex tip={x+dx*length,y+dy*length,z+curl,u,w};
+    struct SolidVertex right={x+dx*length*.6f+dy*width,y+dy*length*.6f-dx*width,z+curl*.48f,u,w};
+    struct SolidVertex shape[4]={root,left,tip,right};
+    propFace(v,t,root,left,tip,right,shade);
+    struct SolidVertex base=root;
+    base.z-=1.35f;
+    for (int i=0;i<4;++i)
+        solidTriangle(v,t,shape[i],shape[(i+1)&3],base,shade-38,0);
+}
+
+static void flowerBloom(const struct VoxelView* v,const struct SolidTree* t,
+                       float x,float y,float z,int bloom) {
+    static const float dx[5]={0,.95106f,.58779f,-.58779f,-.95106f};
+    static const float dy[5]={-1,-.30902f,.80902f,.80902f,-.30902f};
+    static const unsigned light[5]={240,226,201,188,218};
+    const float height=bloom ? 9.0f : 7.3f;
+    const int direction=bloom ? 1 : -1;
+    const float tilt=direction*.65f;
+    propBlade(v,t,x,y,z,height,tilt,0,0);
+    flowerPetal(v,t,x,y,z+1.8f,direction*.92f,.39f,2.8f,.8f,1.6f,0,210);
+    flowerPetal(v,t,x,y,z+3.1f,-direction*.87f,-.5f,2.4f,.72f,1.3f,0,235);
+    for(int i=0;i<5;++i) {
+        float curl=1.55f+(i==1 || i==4 ? .75f : 0);
+        flowerPetal(v,t,x+tilt,y+.6f,z+height-.5f,dx[i]*direction,dy[i],
+                    4.0f,1.86f,curl,1,light[i]);
+    }
+    propMound(v,t,x+tilt,y+.6f,z+height-.35f,1.43f,1.40f,0,2,0);
+}
