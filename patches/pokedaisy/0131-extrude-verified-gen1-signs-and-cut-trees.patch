+/* The board's face uses the original field artwork. Only its backing
+ * and support use new geometry. */
+static void redLiveSign(const struct VoxelView* view, int x, int y, uint32_t alpha) {
+    int front=y+10;
+    voxelPropBox(view,x+7,y+7,3,3,0,8,alpha|RED_COLOR(107,82,60));
+    voxelPropBox(view,x+1,y+7,14,3,5,9,alpha|RED_COLOR(177,147,104));
+    int sx=voxelX(view,x+1,front), sy=voxelY(view,front,14);
+    for (int row=0; row<9; ++row) {
+        const uint32_t* glyph=view->texture+(y+row+3-view->top)*view->stride+x+1-view->left;
+        for (int col=0; col<14; ++col)
+            voxelPixel(view,sx+col,sy+row,front,redTint(glyph[col],&redStyles[RED_SIGN]));
+    }
+}
+
+static void redCutTree(const struct VoxelView* view, int x, int y, uint32_t alpha) {
+    uint32_t bark=alpha|RED_COLOR(117,91,61);
+    uint32_t leaves=climateLeafColor(alpha|RED_COLOR(95,147,89));
+    uint32_t tips=climateLeafColor(alpha|RED_COLOR(133,180,104));
+    voxelPropBox(view,x+7,y+9,3,4,0,10,bark);
+    voxelPropBox(view,x+2,y+7,6,5,6,4,leaves);
+    voxelPropBox(view,x+8,y+7,6,5,6,4,leaves);
+    voxelPropBox(view,x+5,y+5,7,6,8,4,tips);
+    voxelPropBox(view,x+7,y+6,3,3,12,2,tips);
+}
+
+/* These cuttable tree blocks all reveal tile 0x2c in the native Cut table.
+ * Sample the same live pattern and palette used by an already-cut cell. */
+static void redCutTreeFloor(uint32_t floor[64], uint32_t alpha) {
+    uint8_t attr=gbAttrSeen[0x2c] ? gbTileAttr[0x2c] : gbAttrDefault;
+    uint32_t base=gbBgTileBase(0x2c,attr);
+    for (int y=0; y<8; ++y) for (int x=0; x<8; ++x) {
+        int pixel=gbTilePixel(base,(attr&0x20) ? 7-x : x,(attr&0x40) ? 7-y : y);
+        uint32_t source=gbBgColor(attr,pixel,alpha,true);
+        floor[y*8+x]=climateGround(redTint(source,&redStyles[RED_FIELD]),2);
+    }
+}
