+// Restore the front face only where a physical surface hid a native-visible pixel.
+// Keep the surface depth so other actors and UI retain their ordinary depth tests.
+static void voxelRestoreNativeActorPixel(const struct VoxelView* v, int x, int y, uint32_t color) {
