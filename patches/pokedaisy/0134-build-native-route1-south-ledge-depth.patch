+static bool scenerySouthLedgeMap(const struct Snap* s) {
+    if (!F.mapHeader || r8(F.mapHeader+0x17)!=3 || r8(F.mapHeader+0x16)!=2) return false;
+    for (size_t n=0; n<sizeof(scenerySouthLedgeMaps)/sizeof(*scenerySouthLedgeMaps); ++n) {
+        const struct ScenerySouthLedgeMap* m=&scenerySouthLedgeMaps[n];
+        if (m->rom==solidRom && m->group==s->group && m->map==s->num &&
+            m->primary==s->primary && m->secondary==s->secondary &&
+            m->width==s->width && m->height==s->height && m->layout==r32(F.mapHeader)) return true;
+    }
+    return false;
+}
+
+static void scenerySouthLedgeVolume(const struct Snap* s, const struct VoxelView* view, int cellX, int cellY) {
+    for (int row=0; row<view->rows; ++row) for (int col=0; col<view->cols; ++col) {
+        int x=cellX+col, y=cellY+row;
+        if ((unsigned)(x-MAP_OFFSET)>=(unsigned)s->width ||
+            y<=MAP_OFFSET || y>=MAP_OFFSET+s->height-1 ||
+            (unsigned)x>=(unsigned)s->vw || y+1>=s->vh) continue;
+        const uint16_t* block=s->vmap+y*s->vw+x;
+        if ((*block>>10)!=1 || (block[-s->vw]>>10)!=12 || (block[s->vw]>>10)!=12) continue;
+        const struct ScenerySouthLedgeShape* shape=NULL;
+        for (size_t n=0; n<sizeof(scenerySouthLedgeShapes)/sizeof(*scenerySouthLedgeShapes); ++n) {
+            if ((*block&1023)==scenerySouthLedgeShapes[n].tile) {
+                shape=&scenerySouthLedgeShapes[n];
+                break;
+            }
+        }
+        if (!shape) continue;
+        bool covered=false;
+        for (int dy=0; dy<16 && !covered; ++dy)
+            covered=memchr(holeBuf[row*16+dy]+col*16,1,16)!=NULL;
+        if (covered) continue;
+        int z=voxelRise(view,col,row);
+        for (int u=0; u<16; ++u) {
+            int front=shape->fronts[u];
+            if (front<0) continue;
+            int height=shape->heights[u];
+            int worldX=view->left+col*16+u;
+            const uint32_t* texel=view->texture+(row*16+front)*view->stride+col*16+u;
+            for (int inset=2; inset>=0; --inset) {
+                int worldY=view->top+row*16+front-inset;
+                int sx=voxelX(view,worldX,worldY);
+                int sy=voxelY(view,worldY,z+height);
+                uint32_t material=texel[-inset*view->stride];
+                voxelPixel(view,sx,sy,worldY,material);
+                if (!inset) for (int v=1; v<=height; ++v) {
+                    uint32_t face=climateMix(texel[-2*view->stride],material,40u*(unsigned)v);
+                    voxelPixel(view,sx,sy+v,worldY,voxelShade(face,235u));
+                }
+            }
+        }
+    }
+}
