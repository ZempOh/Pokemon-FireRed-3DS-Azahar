+enum RedTerrainDetail { RED_DETAIL_NONE, RED_DETAIL_DOOR, RED_LEDGE_SOUTH, RED_LEDGE_WEST, RED_LEDGE_EAST };
+
+/* Only native Overworld jump signatures with a matching approach get relief.
+ * The standing tile is the bottom-left quadrant of the source cell. */
+static enum RedTerrainDetail redTerrainDetail(const struct GbSnap* snap, uint32_t signature,
+                                              int map, int cx, int cy) {
+    if (signature==0x1c1b0c0bu) {
+        /* One imitation of this door on Route 2 has no native warp. */
+        return map==13 && cx==9 && cy==21 ? RED_DETAIL_NONE : RED_DETAIL_DOOR;
+    }
+    unsigned stand;
+    switch (signature) {
+    case 0x37372c2cu: case 0x34372c2cu: case 0x37373939u: case 0x37363939u:
+        stand=(gbVoxelSignature(snap,cx,cy-1)>>16)&0xffu;
+        return (stand==0x39 || (stand==0x2c && ((signature>>16)&0xffu)==0x37))
+            ? RED_LEDGE_SOUTH : RED_DETAIL_NONE;
+    case 0x2c272c27u:
+        stand=(gbVoxelSignature(snap,cx+1,cy)>>16)&0xffu;
+        return stand==0x2c || stand==0x39 ? RED_LEDGE_WEST : RED_DETAIL_NONE;
+    case 0x241d241du: case 0x240d240du:
+        stand=(gbVoxelSignature(snap,cx-1,cy)>>16)&0xffu;
+        return (stand==0x2c || (stand==0x39 && signature==0x240d240du))
+            ? RED_LEDGE_EAST : RED_DETAIL_NONE;
+    default:
+        return RED_DETAIL_NONE;
+    }
+}
+
+static void redDoorSill(const struct VoxelView* view, const uint32_t* art, int x, int y) {
+    const uint32_t* source=art+(y+12-view->top)*view->stride+x-view->left;
+    int front=y+16;
+    for (int dx=2; dx<14; ++dx) {
+        uint32_t color=redTint(source[dx],&redStyles[RED_WALL]);
+        voxelPixel(view,voxelX(view,x+dx,front),voxelY(view,front,2),front,voxelShade(color,244));
+        voxelPixel(view,voxelX(view,x+dx,front),voxelY(view,front,1),front,voxelShade(color,181));
+    }
+}
+
+/* Use the same live terrain colors for the raised lip and exposed face.
+ * Depth remains in the source cell, independent of the jump animation. */
+static void redLedgeRiser(const struct VoxelView* view, const uint32_t* floor, int x, int y,
+                          enum RedTerrainDetail detail) {
+    int start=detail==RED_LEDGE_SOUTH ? 0 : detail==RED_LEDGE_WEST ? 2 : 7;
+    int width=detail==RED_LEDGE_SOUTH ? 16 : 3;
+    int firstRow=detail==RED_LEDGE_SOUTH ? 11 : 2;
+    int lastRow=detail==RED_LEDGE_SOUTH ? 12 : 14;
+    for (int row=firstRow; row<lastRow; ++row) {
+        int worldY=y+row;
+        const uint32_t* source=floor+(worldY-view->top)*view->stride+x-view->left;
+        int left=voxelX(view,x+start,worldY);
+        int top=voxelY(view,worldY,3);
+        int face=voxelY(view,worldY,1);
+        for (int col=0; col<width; ++col) {
+            uint32_t color=source[start+col];
+            voxelPixel(view,left+col,top,worldY,voxelShade(color,241));
+            voxelPixel(view,left+col,face,worldY,voxelShade(color,183));
+        }
+    }
+}
