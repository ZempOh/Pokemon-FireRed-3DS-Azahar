+static enum RedTerrainDetail redHomeStair(const struct GbSnap* snap, int map, int cx, int cy) {
+    if (snap->w!=4 || snap->h!=4 || cx!=13 || cy!=7) return RED_DETAIL_NONE;
+    if (map==37 && snap->tileset==1 && gbVoxelSignature(snap,cx,cy)==0x1d1c0d0cu)
+        return RED_STAIR_UP;
+    if (map==38 && snap->tileset==4 && gbVoxelSignature(snap,cx,cy)==0x1b1a0b0au)
+        return RED_STAIR_DOWN;
+    return RED_DETAIL_NONE;
+}
+
+static void redStairTreads(const struct VoxelView* view, int x, int y, bool goingUp) {
+    /* The stock stairs run diagonally, with a distinct rail around the
+     * treads. Keep each projected tread inside the existing staircase. */
+    for (int step=0; step<4; ++step) {
+        int tx=x+2+step*3, ty=y+11-step*3;
+        const uint32_t tone=view->texture[(ty+1-view->top)*view->stride+tx+1-view->left];
+        voxelPropBox(view,tx,ty,3,3,0,goingUp ? step+1 : 4-step,voxelShade(tone,225));
+    }
+}
+
 static void redDoorSill(const struct VoxelView* view, const uint32_t* art, int x, int y) {
     const uint32_t* source=art+(y+12-view->top)*view->stride+x-view->left;
     int front=y+16;
