+    {37, 1, 0, 0, 1, 2, RED_FURNITURE_BOOKCASE, {0x31302926u, 0x33322322u}},
+    {37, 1, 1, 0, 1, 2, RED_FURNITURE_BOOKCASE, {0x31302926u, 0x33322322u}},
+    {37, 1, 2, 4, 1, 1, RED_FURNITURE_CHAIR, {0x13120302u}},
