+static void redCutTreeFloor(uint32_t floor[64], uint32_t alpha) {
+    redLiveTile(floor,0x2c,alpha);
+    for (int i=0; i<64; ++i)
+        floor[i]=climateGround(redTint(floor[i],&redStyles[RED_FIELD]),2);
+}
