+enum RedFurnitureKind { RED_FURNITURE_BOOKCASE, RED_FURNITURE_CHAIR,
+                        RED_FURNITURE_TABLE, RED_FURNITURE_BED };
+struct RedFurnitureProfile {
+    uint8_t map, tileset, x, y, width, height, kind;
+    uint32_t cells[4];
+};
+#include "pk_gen1_home_furniture_profiles.h"
+
+static int redHomeFurnitureAt(const struct GbSnap* snap, int map,
+                              const struct RedFurnitureProfile** props) {
+    if (snap->w!=4 || snap->h!=4 || (map!=37 && map!=38)) return 0;
+    int count=0;
+    for (unsigned i=0; i<sizeof(redHomeFurniture)/sizeof(*redHomeFurniture); ++i) {
+        const struct RedFurnitureProfile* row=&redHomeFurniture[i];
+        if (row->map!=map || row->tileset!=snap->tileset) continue;
+        bool matches=true;
+        for (int y=0; y<row->height && matches; ++y)
+            for (int x=0; x<row->width; ++x)
+                if (gbVoxelSignature(snap,6+row->x+x,6+row->y+y)!=row->cells[y*row->width+x]) {
+                    matches=false;
+                    break;
+                }
+        if (matches) props[count++]=row;
+    }
+    return count;
+}
+
+/* Only verified furniture cells swap to their matching adjacent native
+ * background. Cabinet tops are set into the original striped wall. */
+static int redFurnitureBackground(const struct RedFurnitureProfile* const* props, int count,
+                                  int x, int y) {
+    for (int i=0; i<count; ++i) {
+        const struct RedFurnitureProfile* row=props[i];
+        if ((unsigned)(x-row->x)<row->width && (unsigned)(y-row->y)<row->height)
+            return row->kind==RED_FURNITURE_BOOKCASE && y==row->y ? 0 : 1;
+    }
+    return -1;
+}
+
+static uint32_t redFurnitureInk(const struct VoxelView* view, int x, int y, uint32_t fallback) {
+    int sy=y-view->top, sx=x-view->left;
+    if ((unsigned)sy>=(unsigned)(view->rows*VOXEL_TILE) || (unsigned)sx>=(unsigned)view->stride)
+        return fallback;
+    return redTint(view->texture[sy*view->stride+sx],&redStyles[RED_WALL]);
+}
+
+static void redFurnitureChair(const struct VoxelView* view, int x, int y, uint32_t wood) {
+    for (int leg=0; leg<4; ++leg)
+        voxelPropBox(view,x+3+(leg%2)*7,y+6+(leg/2)*6,2,2,0,4,wood);
+    voxelPropBox(view,x+2,y+5,11,9,4,2,voxelShade(wood,248));
+    voxelPropBox(view,x+2,y+4,11,2,5,7,wood);
+}
+
+static void redFurnitureBooks(const struct VoxelView* view, int x, int y, uint32_t wood) {
+    int front=y+27;
+    if (front<view->top || front>=view->top+view->rows*VOXEL_TILE) return;
+    voxelPropBox(view,x+1,y+15,14,12,0,16,wood);
+    int sx=voxelX(view,x+2,front), sy=voxelY(view,front,15);
+    for (int row=0; row<14; ++row)
+        for (int col=0; col<12; ++col) {
+            uint32_t ink=redFurnitureInk(view,x+2+col,y+4+row*25/14,wood);
+            voxelPixel(view,sx+col,sy+row,front,voxelShade(ink,229));
+        }
+}
+
+static void redFurnitureTable(const struct VoxelView* view, int x, int y, uint32_t wood) {
+    for (int leg=0; leg<4; ++leg)
+        voxelPropBox(view,x+3+(leg%2)*23,y+4+(leg/2)*22,3,3,0,7,wood);
+    voxelPropBox(view,x+1,y+2,30,27,7,2,voxelShade(wood,249));
+    for (int row=3; row<28; ++row) {
+        int depth=y+row;
+        if (depth<view->top || depth>=view->top+view->rows*VOXEL_TILE) continue;
+        int sx=voxelX(view,x+3,depth), sy=voxelY(view,depth,9);
+        for (int col=0; col<26; ++col) {
+            uint32_t ink=redFurnitureInk(view,x+3+col,y+3+(row-3)*21/25,wood);
+            voxelPixel(view,sx+col,sy,depth,ink);
+        }
+    }
+}
+
+static void redFurnitureBed(const struct VoxelView* view, int x, int y, uint32_t wood, uint32_t alpha) {
+    voxelPropBox(view,x+1,y+2,14,27,0,4,wood);
+    voxelPropBox(view,x+2,y+4,12,23,4,2,alpha|RED_COLOR(238,229,213));
+    voxelPropBox(view,x+2,y+11,12,15,6,2,alpha|RED_COLOR(152,177,154));
+    voxelPropBox(view,x+4,y+5,8,5,6,2,alpha|RED_COLOR(250,244,226));
+    voxelPropBox(view,x+1,y+1,14,3,0,10,wood);
+    voxelPropBox(view,x+1,y+27,14,3,0,6,wood);
+}
+
+static void redRenderFurniture(const struct VoxelView* view, const struct RedFurnitureProfile* prop,
+                               uint32_t alpha) {
+    int x=(6+prop->x)*VOXEL_TILE, y=(6+prop->y)*VOXEL_TILE;
+    uint32_t wood=alpha|RED_COLOR(115,86,63);
+    switch (prop->kind) {
+    case RED_FURNITURE_BOOKCASE: redFurnitureBooks(view,x,y,wood); break;
+    case RED_FURNITURE_CHAIR: redFurnitureChair(view,x,y,wood); break;
+    case RED_FURNITURE_TABLE: redFurnitureTable(view,x,y,wood); break;
+    case RED_FURNITURE_BED: redFurnitureBed(view,x,y,wood,alpha); break;
+    }
+}
