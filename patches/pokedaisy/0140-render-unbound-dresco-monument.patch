+static bool drescoMonumentPrepare(const struct Snap* s, const struct VoxelView* view,
+                                  int cellX, int cellY, int href, int vref, uint32_t alpha,
+                                  uint32_t* texture, struct DrescoMonument* monument) {
+    if (solidRom!=0x4b3d4957u || s->group!=3 || s->num!=71 ||
+        s->primary!=0x082d4a94u || s->secondary!=0x082d4af4u ||
+        s->width!=55 || s->height!=47 || !F.mapHeader || r32(F.mapHeader)!=0x08779994u ||
+        r8(F.mapHeader+0x17)!=1 || !solidGroundAligned(href,vref)) return false;
+    const int gridX=MAP_OFFSET+32, gridY=MAP_OFFSET+20;
+    int col=gridX-cellX,row=gridY-cellY;
+    if (col<0 || row<0 || col+4>view->cols || row+4>view->rows ||
+        gridX+4>s->vw || gridY+4>s->vh) return false;
+    for (int ty=0; ty<4; ++ty) for (int tx=0; tx<4; ++tx) {
+        if (s->vmap[(gridY+ty)*s->vw+gridX+tx]!=drescoMonumentCells[ty*4+tx]) return false;
+    }
+    for (int y=0; y<64; ++y)
+        if (memchr(holeBuf[row*16+y]+col*16,1,64)) return false;
+    monument->col=col; monument->row=row;
+    for (int y=0; y<64; ++y) {
+        uint64_t bits=drescoMonumentMasks[y];
+        while (bits) {
+            unsigned x=(unsigned)__builtin_ctzll(bits);
+            bits&=bits-1;
+            uint32_t* surface=texture+(row*16+y)*view->stride+col*16+x;
+            monument->ink[y*64+x]=*surface;
+            int tile=drescoMonumentCells[(y/16)*4+(x/16)]&1023;
+            uint32_t ground=solidPlantGroundPixel(s,tile,(int)(x&15u),y&15,alpha,1);
+            // All admitted lower-layer texels are owned ground, including
+            // path under the open wings and turf under the masonry base.
+            *surface=climateGround(ground,2);
+        }
+    }
+    return true;
+}
