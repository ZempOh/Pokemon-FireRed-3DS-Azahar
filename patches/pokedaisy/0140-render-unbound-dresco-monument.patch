+static void drescoMonumentDraw(const struct VoxelView* view, const struct DrescoMonument* shape) {
+    enum { maskWidth=92, maskHeight=76 };
+    uint8_t stencil[maskWidth*maskHeight]={0};
+    int originX=view->left+16*shape->col, originY=view->top+16*shape->row;
+    int maskX=voxelX(view,originX,originY)-4,maskY=voxelY(view,originY,8)-16;
+    for (int pass=0; pass<2; ++pass) for (int y=0; y<64; ++y) {
+        uint64_t bits=drescoMonumentMasks[y];
+        while (bits) {
+            unsigned x=(unsigned)__builtin_ctzll(bits);
+            bits&=bits-1;
+            int rx=originX+(int)x,ry=originY+y;
+            int base=voxelRise(view,shape->col+(int)(x/16),shape->row+y/16);
+            int center=(int)x-32;
+            if (center<0) center=-center;
+            bool pedestal=y>=43;
+            int depth=pedestal ? 6 : center<9 ? 7 : center<20 ? 5 : 4;
+            int lift=pedestal ? 0 : 1+(43-y)/19;
+            int sx=voxelX(view,rx,ry),sy=voxelY(view,ry,base)-lift;
+            uint32_t stone=shape->ink[y*64+x];
+            if (!pass) {
+                // Keep every native-facing stone texel in front of the side
+                // shell, without pushing its depth past a native-visible NPC.
+                int a=sx-maskX,b=sy-maskY;
+                if ((unsigned)a<maskWidth && (unsigned)b<maskHeight) stencil[b*maskWidth+a]=1;
+                voxelPixel(view,sx,sy,ry,stone);
+                continue;
+            }
+            for (int z=depth; z>0; --z) {
+                int behind=ry-z;
+                int a=sx+voxelX(view,rx,behind)-voxelX(view,rx,ry);
+                int b=sy+voxelY(view,behind,0)-voxelY(view,ry,0);
+                int mx=a-maskX,my=b-maskY;
+                if ((unsigned)mx>=maskWidth || (unsigned)my>=maskHeight || stencil[my*maskWidth+mx])
+                    continue;
+                voxelPixel(view,a,b,behind,voxelShade(stone,205u+4u*(unsigned)(depth-z)));
+            }
+        }
+    }
+}
