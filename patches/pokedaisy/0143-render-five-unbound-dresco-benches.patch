+
+static int drescoBenchPrepare(const struct Snap* s, const struct VoxelView* view,
+                              int cellX, int cellY, int href, int vref, uint32_t alpha,
+                              uint32_t* texture, struct DrescoBench* benches) {
+    if (solidRom!=0x4b3d4957u || s->group!=3 || s->num!=71 ||
+        s->primary!=0x082d4a94u || s->secondary!=0x082d4af4u ||
+        s->width!=55 || s->height!=47 || !F.mapHeader || r32(F.mapHeader)!=0x08779994u ||
+        r8(F.mapHeader+0x17)!=1 || !solidGroundAligned(href,vref)) return 0;
+    int count=0;
+    for (size_t i=0; i<sizeof(drescoBenchPlacements)/sizeof(*drescoBenchPlacements); ++i) {
+        const struct DrescoBenchPlacement* place=&drescoBenchPlacements[i];
+        int x=MAP_OFFSET+place->x,y=MAP_OFFSET+place->y;
+        int col=x-cellX,row=y-cellY;
+        if (col<0 || row<0 || col>=view->cols || row+1>=view->rows ||
+            x>=s->vw || y+1>=s->vh || !sceneryCellVisible(col,row) || !sceneryCellVisible(col,row+1)) continue;
+        if (s->vmap[y*s->vw+x]!=place->upper || s->vmap[(y+1)*s->vw+x]!=place->lower) continue;
+        struct DrescoBench* b=&benches[count++];
+        b->col=col; b->row=row; b->leftBack=place->leftBack;
+        uint32_t* top=texture+row*16*view->stride+col*16;
+        b->seat=top[9*view->stride+(b->leftBack?7:6)];
+        b->back=top[4*view->stride+(b->leftBack?3:12)];
+        b->leg=top[28*view->stride+(b->leftBack?6:4)];
+        for (int py=0; py<32; ++py) {
+            unsigned bits=drescoBenchMasks[b->leftBack][py];
+            int id=(py<16?place->upper:place->lower)&1023;
+            while (bits) {
+                int px=__builtin_ctz(bits);
+                bits&=bits-1;
+                uint32_t floor=solidPlantGroundPixel(s,id,px,py&15,alpha,1);
+                top[py*view->stride+px]=climateGround(floor,2);
+            }
+        }
+    }
+    return count;
+}
+
+static void drescoBenchDraw(const struct VoxelView* view, const struct DrescoBench* b) {
+    int x=view->left+16*b->col, y=view->top+16*b->row;
+    int seatX=x+(b->leftBack?5:1), backX=x+(b->leftBack?2:11);
+    int z=voxelRise(view,b->col,b->row+1);
+    // Low frame, open legs, separate seat slats and a taller backrest.
+    for (int legY=y+10; legY<=y+28; legY+=18) {
+        voxelPropBox(view,seatX,legY,2,3,z,4,b->leg);
+        voxelPropBox(view,seatX+7,legY,2,3,z,4,b->leg);
+        voxelPropBox(view,backX,legY,2,3,z,7,b->leg);
+    }
+    voxelPropBox(view,seatX,y+8,9,23,z+3,1,b->leg);
+    for (int slat=0; slat<3; ++slat)
+        voxelPropBox(view,seatX+slat*3,y+8,2,23,z+4,1,
+                     voxelShade(b->seat,slat==1?225u:256u));
+    voxelPropBox(view,backX,y+9,3,21,z+5,2,b->back);
+    voxelPropBox(view,backX,y+9,3,21,z+7,1,voxelShade(b->back,239u));
+}
