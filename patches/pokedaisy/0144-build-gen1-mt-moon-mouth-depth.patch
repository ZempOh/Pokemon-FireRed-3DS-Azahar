+/* Keep the projected native opening and the dirt approach available to the
+ * depth buffer. Added rock is clipped to the rim and adjacent cliff art. */
+static void redCaveRimPixel(const struct VoxelView* view, int sx, int sy, int depth,
+                            int x, int y, uint32_t color) {
+    int wy=voxelWorldY(view,sy,0), dy=wy-y;
+    int dx=sx-voxelX(view,x,wy);
+    if ((unsigned)dx>=16u || dy < -5 || dy>=16 || (dy>=2 && dx>=2 && dx<14)) return;
+    voxelPixel(view,sx,sy,depth,color);
+}
+
+static void redCaveMouth(const struct VoxelView* view, int x, int y, uint32_t alpha) {
+    uint32_t stone=alpha|RED_COLOR(126,133,126);
+    uint32_t light=alpha|RED_COLOR(176,177,157);
+    uint32_t rockTop=voxelShade(light,224);
+    uint32_t crest=climateMix(rockTop,climateGround(rockTop,2),96);
+    for (int row=0; row<15; ++row) {
+        int wy=y+row, sx=voxelX(view,x,wy);
+        int rise=row<4 ? 4 : row<9 ? 3 : 2;
+        uint32_t cap=row<3 ? crest : (row/3)%2 ? voxelShade(light,219) : stone;
+        int inset=row<4 ? 4-row : 0;
+        for (int col=inset; col<16-inset; ++col) {
+            if (row>=4 && col>=3 && col<13) continue;
+            int sy=voxelY(view,wy,rise);
+            redCaveRimPixel(view,sx+col,sy,wy,x,y,cap);
+            redCaveRimPixel(view,sx+col,sy+1,wy,x,y,voxelShade(cap,188));
+        }
+    }
+}
