+/* Original painted timber relief. The exact live facade supplies the color. */
+#pragma once
+#include <stdint.h>
+
+#ifndef VOXEL_BOARD_TEXTURE_SIZE
+#define VOXEL_BOARD_TEXTURE_SIZE 256
+#endif
+
+static const uint8_t* voxelBoardTexture(void) {
+    enum { size = VOXEL_BOARD_TEXTURE_SIZE };
+    static uint8_t atlas[size * size];
+    static bool ready;
+    if (ready) return atlas;
+    for (unsigned y = 0; y < size; ++y) {
+        const unsigned v = (y * 256u + 128u) / size;
+        const unsigned course = v >> 5, edge = v & 31u;
+        for (unsigned x = 0; x < size; ++x) {
+            const unsigned u = (x * 256u + 128u) / size;
+            const unsigned joint = (u + course * 61u) & 255u;
+            const unsigned grain = (v * 37u + (u >> 4) * 13u + (u >> 6) * v * 3u) & 15u;
+            unsigned light = 255u - grain / 2u;
+            if (edge < 4u) light -= 9u;
+            if (edge > 24u) light -= 12u;
+            if (joint < 8u) light -= 22u;
+            else if (joint < 16u) light -= 9u;
+            atlas[y * size + x] = (uint8_t)light;
+        }
+    }
+    ready = true;
+    return atlas;
+}
+
+/* A repeat covers 32×32 source-art units, as in the roof texture control. */
+static unsigned voxelBoardSample(const uint8_t* atlas, int u8, int v8) {
+    const unsigned u = ((unsigned)u8 & 255u) * VOXEL_BOARD_TEXTURE_SIZE / 256u;
+    const unsigned v = ((unsigned)v8 & 255u) * VOXEL_BOARD_TEXTURE_SIZE / 256u;
+    return atlas[v * VOXEL_BOARD_TEXTURE_SIZE + u];
+}
