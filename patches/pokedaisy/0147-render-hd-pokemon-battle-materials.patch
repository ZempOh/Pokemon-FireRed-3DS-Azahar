+/* The two buffers share an allocation. The optional texture follows the ordinary
+ * frame and the caller continues using the ordinary viewport in game coordinates. */
+static struct BattleDetailOutput {
+    struct PkWideView view;
+    uint32_t* native;
+    uint32_t* detailed;
+    bool ready;
+} battleDetail;
+
+bool pk_wide_battle_detail_requested(void) {
+    return battleDetail.detailed != NULL;
+}
+
+void pk_wide_battle_detail_pixel(int x, int y, const uint32_t samples[4]) {
+    struct PkWideView view=battleDetail.view;
+    int col=x-view.x, row=y-view.y;
+    if (!battleDetail.detailed || (unsigned)col >= (unsigned)view.w ||
+        (unsigned)row >= (unsigned)view.h) return;
+    const int stride=view.w*2;
+    if (!battleDetail.ready) {
+        for (int py=0; py<view.h; ++py) {
+            uint32_t* upper=battleDetail.detailed+py*2*stride;
+            const uint32_t* src=battleDetail.native+py*view.w;
+            for (int px=0; px<view.w; ++px)
+                upper[px*2]=upper[px*2+1]=src[px];
+            memcpy(upper+stride,upper,(size_t)stride*sizeof(*upper));
+        }
+        battleDetail.ready=true;
+    }
+    uint32_t* dst=battleDetail.detailed+row*2*stride+col*2;
+    dst[0]=samples[0]; dst[1]=samples[1];
+    dst[stride]=samples[2]; dst[stride+1]=samples[3];
+}
+
+bool pk_wide_view_sprite_detail(struct mCore* core, const uint32_t* frame, uint32_t* out,
+                                struct PkWideView view, size_t capacityPixels) {
+    battleDetail=(struct BattleDetailOutput){0};
+    if (!out || view.w<=0 || view.h<=0 ||
+        view.w>PK_WIDE_MAX_VIEW_W || view.h>PK_WIDE_MAX_VIEW_H) return false;
+    size_t nativePixels=(size_t)view.w*view.h;
+    if (nativePixels>capacityPixels) return false;
+    if (view.w<=PK_WIDE_MAX_VIEW_W/2 && view.h<=PK_WIDE_MAX_VIEW_H/2 &&
+        nativePixels<=capacityPixels/5)
+        battleDetail=(struct BattleDetailOutput){view,out,out+nativePixels,false};
+    pk_wide_view(core,frame,out,view,NULL);
+    bool ready=battleDetail.ready && !pk_wide_fault();
+    battleDetail=(struct BattleDetailOutput){0};
+    return ready;
+}
