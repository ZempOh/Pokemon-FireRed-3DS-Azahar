+static void battleVolumeBuild(struct BattleVolume* mesh, const uint8_t* art, float yaw, float pitch) {
+    battleVolumeRaster(&mesh->pixels[0][0],1,mesh->mask,art,yaw,pitch);
+}
+
+static uint8_t battleVolumeNeighbor(const uint8_t mask[BATTLE_VOLUME_ART][BATTLE_VOLUME_ART], int x, int y) {
+    return (unsigned)x < BATTLE_VOLUME_ART && (unsigned)y < BATTLE_VOLUME_ART ? mask[y][x] : 0;
+}
+
+/* Slope a small relief ramp at the original ink boundaries. The live palette still owns
+ * every color. Four texels span a source pixel so the lighting does not step with the game grid. */
+static inline void battleVolumeDetailBuild(struct BattleVolumeDetail* detail, const uint8_t* art, float yaw, float pitch) {
+    uint8_t mask[BATTLE_VOLUME_ART][BATTLE_VOLUME_ART];
+    battleVolumeRaster(&detail->pixels[0][0],BATTLE_DETAIL_SCALE,mask,art,yaw,pitch);
+    for (int y=0; y<BATTLE_VOLUME_ART; ++y) for (int x=0; x<BATTLE_VOLUME_ART; ++x) {
+        unsigned ink=mask[y][x];
+        int left=battleVolumeNeighbor(mask,x-1,y)!=ink;
+        int right=battleVolumeNeighbor(mask,x+1,y)!=ink;
+        int top=battleVolumeNeighbor(mask,x,y-1)!=ink;
+        int bottom=battleVolumeNeighbor(mask,x,y+1)!=ink;
+        for (int v=0; v<4; ++v) for (int u=0; u<4; ++u)
+            detail->material[y*4+v][x*4+u]=(uint8_t)(128 + left*(3-u)*2 - right*u*2 +
+                                                    top*(3-v)*4 - bottom*v*4);
+    }
+}
+
+static inline bool battleVolumeDetailCovers(const struct BattleVolumeDetail* detail,int x,int y) {
+    return detail->pixels[y*2][x*2].ink || detail->pixels[y*2][x*2+1].ink ||
+           detail->pixels[y*2+1][x*2].ink || detail->pixels[y*2+1][x*2+1].ink;
+}
+
+static inline unsigned battleVolumeDetailLight(const struct BattleVolumeDetail* detail,
+        const struct BattleVolumePixel* pixel, int x, int y) {
+    int u=(x-BATTLE_VOLUME_MARGIN*BATTLE_DETAIL_SCALE)*2+1;
+    int v=(y-BATTLE_VOLUME_MARGIN*BATTLE_DETAIL_SCALE)*2+1;
+    if ((unsigned)u>=BATTLE_DETAIL_MATERIAL_SIZE || (unsigned)v>=BATTLE_DETAIL_MATERIAL_SIZE)
+        return pixel->light;
+#ifdef PK_BATTLE_RELIEF_CONTROL
+    /* Comparison build: fetch one material texel per source pixel. */
+    u=(u&~3)+1; v=(v&~3)+1;
+#endif
+    int light=(int)pixel->light + detail->material[v][u] - 128;
+    return light < 0 ? 0 : light > 255 ? 255 : (unsigned)light;
+}
