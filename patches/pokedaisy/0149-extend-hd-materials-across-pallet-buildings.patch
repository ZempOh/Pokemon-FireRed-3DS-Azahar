+/* Original shallow limestone pits. Native mortar and brick borders remain in
+ * the source art. An irregular grain only modulates the sampled stone face. */
+static const uint8_t* voxelAshlarTexture(void) {
+    enum { size = VOXEL_BOARD_TEXTURE_SIZE };
+    static uint8_t atlas[size * size];
+    static bool ready;
+    if (ready) return atlas;
+    for (unsigned y=0;y<size;++y) for (unsigned x=0;x<size;++x) {
+        const unsigned u=(x*256u+128u)/size,v=(y*256u+128u)/size;
+        const unsigned coarse=(u>>3)*13411u+(v>>3)*19013u;
+        const unsigned fine=(u*139u+v*313u)^(u*v*17u);
+        const unsigned shade=((coarse^(coarse>>4))&15u)/2u+(fine&7u)/2u;
+        const unsigned pit=(coarse^(coarse>>7))%19u == 0 && (u&7u)>1 && (v&7u)>1 ? 16u:0u;
+        atlas[y*size+x]=(uint8_t)(255u-shade-pit);
+    }
+    ready=true;
+    return atlas;
+}
