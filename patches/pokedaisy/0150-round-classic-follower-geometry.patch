+/* A native opaque silhouette yields thin details and a fuller curved core.
+ * Read the live indexed art so each native turn and animation frame has its
+ * own shell. Palette index zero remains transparent. */
+struct FieldActorShell { uint32_t rim[32], core[32]; int dx[3], dy[3]; };
+
+static void fieldActorShell(const struct Piece* sprite, const struct VoxelView* view,
+                            const uint8_t* vram, int foot, int rise, struct FieldActorShell* shell) {
+    uint32_t silhouette[32]={0};
+    memset(shell,0,sizeof(*shell));
+    for (int y=0;y<32;++y) for (int x=0;x<sprite->w;++x) {
+        unsigned tile=sprite->tile+(y/8)*(sprite->w/8)+x/8;
+        unsigned off=(tile*32+(y&7)*4+(x&7)/2)&0x7fffu;
+        unsigned index=(vram[0x10000+off]>>((x&1)*4))&15;
+        if (index) silhouette[y]|=1u<<x;
+    }
+    for (int y=1;y<31;++y) {
+        uint32_t row=silhouette[y];
+        shell->rim[y]=row&(row<<1)&(row>>1)&silhouette[y-1]&silhouette[y+1];
+    }
+    for (int y=2;y<30;++y) {
+        uint32_t row=shell->rim[y];
+        shell->core[y]=row&(row<<1)&(row>>1)&shell->rim[y-1]&shell->rim[y+1];
+    }
+    for (int layer=0;layer<3;++layer) {
+        int back=foot-2*(layer+1);
+        shell->dx[layer]=voxelX(view,sprite->x,back)-voxelX(view,sprite->x,foot);
+        shell->dy[layer]=voxelY(view,back,rise)-voxelY(view,foot,rise);
+    }
+}
+
+static void fieldActorPixel(const struct VoxelView* view,const struct FieldActorShell* shell,
+                             int x,int y,int foot,int order,int px,int py,uint32_t color) {
+    static const unsigned shade[3]={216,173,142};
+    uint32_t bit=1u<<px;
+    int depth=(shell->core[py]&bit) ? 3 : (shell->rim[py]&bit) ? 2 : 1;
+    while (depth>0) {
+        int back=foot-2*depth;
+        --depth;
+        if (back<view->top) continue;
+        voxelSpritePixel(view,x+shell->dx[depth],y+shell->dy[depth],back,order,voxelShade(color,shade[depth]));
+    }
+    voxelSpritePixel(view,x,y,foot,order,color);
+}
