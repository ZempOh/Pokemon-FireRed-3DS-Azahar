+static const struct SceneryRegionalFacade* solidBuildingRegionalMaterial(const struct SceneryBuildingProfile* p) {
+    for (unsigned i=0;i<sizeof(sceneryRegionalFacades)/sizeof(*sceneryRegionalFacades);++i) {
+        const struct SceneryRegionalFacade* row=&sceneryRegionalFacades[i];
+        if (row->crc==p->crc && row->primary==p->primary && row->secondary==p->secondary &&
+            row->width==p->width && row->height==p->height && row->firstCell==p->cells[0]) return row;
+    }
+    return 0;
+}
+
+static bool solidBuildingFacadeOwns(const struct SolidBuildingContext* ctx,int u,int v) {
+    uint32_t owned;
+    if (ctx->regional) {
+        const struct SceneryRegionalFacade* region=ctx->regional;
+        if ((unsigned)(v-region->top)>=region->rows) return false;
+        owned=region->mask[(v-region->top)*region->words+(u>>5)];
+    } else {
+        if ((unsigned)(v-48)>=32u) return false;
+        owned=ctx->material==FACADE_BOARDS ? voxelPalletBoardMask[v-48][u>>5] : voxelPalletAshlarMask[v-48][u>>5];
+    }
+    return (owned & (1u<<(u&31)))!=0;
 }
