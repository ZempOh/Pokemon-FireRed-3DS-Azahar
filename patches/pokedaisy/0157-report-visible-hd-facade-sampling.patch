+#ifdef __ANDROID__
+/* Count actual sampled surface pixels in the renderer's viewport. Emit the
+ * first occurrence for each cartridge/material and then every 256 draws. */
+static void voxelFacadeProbe(uint32_t crc,unsigned material,int width,int height,unsigned samples) {
+    static uint32_t previous[4];
+    static unsigned draws[4];
+    if (!samples || material==0 || material>=4) return;
+    if (previous[material]!=crc) {
+        previous[material]=crc;
+        draws[material]=0;
+    }
+    if (draws[material]++ & 255u) return;
+    __android_log_print(ANDROID_LOG_INFO,"pokedaisy",
+        "voxel facade atlas crc=%08x material=%u source=%ux%u target=%dx%d samples=%u",
+        crc,material,(unsigned)VOXEL_BOARD_TEXTURE_SIZE,(unsigned)VOXEL_BOARD_TEXTURE_SIZE,width,height,samples);
+}
+#endif
