+static void sceneryRoute212GardenFrost(const struct Snap* s,const struct VoxelView* v,
+                                      int cellX,int cellY,uint32_t* texture,uint32_t alpha) {
+    if (solidRom!=0x2be557a3u || s->group!=0 || s->num!=30 || s->width!=40 || s->height!=80 ||
+        s->primary!=0x083df704u || s->secondary!=0x083df77cu || !F.mapHeader ||
+        r32(F.mapHeader)!=0x089d90c0u || voxelClimate.season!=3 || !voxelClimate.seasonBlend) return;
+    static const uint16_t cells[2][4]={{0x314b,0x354c,0x354c,0x314d},{0x3113,0x3114,0x3114,0x3115}};
+    static const uint8_t masks[2][4]={{0,1,1,2},{3,4,4,5}};
+    const int west=29+MAP_OFFSET,north=58+MAP_OFFSET;
+    if (west+3>=s->vw || north+1>=s->vh) return;
+    for (int y=0;y<2;++y) for (int x=0;x<4;++x)
+        if (s->vmap[(north+y)*s->vw+west+x]!=cells[y][x]) return;
+    for (int y=0;y<2;++y) for (int x=0;x<4;++x) {
+        int col=west+x-cellX,row=north+y-cellY;
+        if ((unsigned)col>=(unsigned)v->cols || (unsigned)row>=(unsigned)v->rows ||
+            !sceneryCellVisible(col,row)) continue;
+        int id=cells[y][x]&1023;
+        const uint16_t* soil=route212PlotSoil[masks[y][x]];
+        for (int py=0;py<16;++py) for (int px=0;px<16;++px) {
+            uint32_t original=solidMaterialPixel(s,id,px,py,alpha);
+            uint32_t winter=climateGround(original,2);
+            // A light dusting preserves the native soil color and its planting cues.
+            texture[(row*16+py)*v->stride+col*16+px]=soil[py]&(1u<<px)
+                ?climateMix(original,winter,104):winter;
+        }
+    }
+}
