+++ b/app/src/main/cpp/pk_voxel_ledge_material.h
@@ -0,0 +1,33 @@
+/* Original shallow sediment and chips for source-owned ledge faces. */
+#pragma once
+#include <stdint.h>
+
+#ifndef VOXEL_LEDGE_TEXTURE_SIZE
+#define VOXEL_LEDGE_TEXTURE_SIZE 256
+#endif
+
+#if VOXEL_LEDGE_TEXTURE_SIZE
+static const uint8_t* voxelLedgeTexture(void) {
+    enum { size = VOXEL_LEDGE_TEXTURE_SIZE };
+    static uint8_t atlas[size * size];
+    static bool ready;
+    if (ready) return atlas;
+    for (unsigned y=0; y<size; ++y) for (unsigned x=0; x<size; ++x) {
+        const unsigned u=(x*256u+128u)/size, v=(y*256u+128u)/size;
+        const unsigned fault=(u>>3)*17u ^ (u>>5)*29u;
+        const unsigned layer=(v+(fault&15u))&31u;
+        const unsigned grit=(u*1667u+v*607u)^(u*v*23u);
+        const unsigned strata=layer<4 ? 22u : layer<9 ? 10u : 0u;
+        atlas[y*size+x]=(uint8_t)(255u-strata-((grit^(grit>>11))&7u));
+    }
+    ready=true;
+    return atlas;
+}
+
+static inline unsigned voxelLedgeFaceShade(const uint8_t* atlas, int worldX, int depth) {
+    enum { size = VOXEL_LEDGE_TEXTURE_SIZE };
+    const unsigned u=((unsigned)worldX*8u&255u)*size/256u;
+    const unsigned v=(unsigned)(depth-1)*24u*size/256u;
+    return (235u*atlas[v*size+u]+128u)/256u;
+}
+#endif
