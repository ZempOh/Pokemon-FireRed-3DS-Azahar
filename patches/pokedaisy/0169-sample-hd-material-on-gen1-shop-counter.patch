diff --git a/app/src/main/cpp/pk_voxel_interior_material.h b/app/src/main/cpp/pk_voxel_interior_material.h
new file mode 100644
--- /dev/null
+++ b/app/src/main/cpp/pk_voxel_interior_material.h
@@ -0,0 +1,69 @@
+/* Original light limestone relief for recognized shop interiors. */
+#pragma once
+
+#ifndef VOXEL_INTERIOR_STONE_SIZE
+#define VOXEL_INTERIOR_STONE_SIZE 256
+#endif
+
+#if VOXEL_INTERIOR_STONE_SIZE > 0
+static const uint8_t* voxelInteriorStone(void) {
+    enum { size = VOXEL_INTERIOR_STONE_SIZE };
+    static uint8_t atlas[size * size];
+    static bool ready;
+    if (ready) return atlas;
+    for (unsigned y = 0; y < size; ++y) {
+        unsigned v = (y * 256u + 128u) / size;
+        for (unsigned x = 0; x < size; ++x) {
+            unsigned u = (x * 256u + 128u) / size;
+            unsigned ridge = (u + 2 * v + (v >> 4) * 19u) & 63u;
+            unsigned speck = (u * 6959u + v * 4519u) ^ (u * v * 547u);
+            unsigned pits = speck % 17u == 0 ? 10u : 0u;
+            unsigned seam = ridge < 3u ? 13u : ridge < 6u ? 6u : 0u;
+            atlas[y * size + x] = (uint8_t)(255u - seam - pits - ((speck >> 5) & 3u));
+        }
+    }
+    ready = true;
+    return atlas;
+}
+
+/* Convert a world-space phase to the material's own resolution. */
+static uint32_t voxelInteriorStoneShade(const uint8_t* atlas, uint32_t color,
+                                        unsigned u8, unsigned v8) {
+    enum { size = VOXEL_INTERIOR_STONE_SIZE };
+    unsigned u = (u8 & 255u) * size / 256u;
+    unsigned v = (v8 & 255u) * size / 256u;
+    unsigned relief = atlas[v * size + u];
+#ifdef PK_INTERIOR_MATERIAL_VERIFY
+    if (relief < 229u) abort();
+#endif
+    return voxelShade(color, relief);
+}
+
+static void voxelInteriorStoneBox(const struct VoxelView* v, const uint8_t* atlas,
+                                 int x, int y, int w, int d, int z, int h,
+                                 uint32_t material) {
+    int front = y + d;
+    if (front < v->top || front >= v->top + v->rows * VOXEL_TILE) return;
+    int back = y < v->top ? v->top : y;
+    uint32_t side = voxelShade(material, 170);
+    uint32_t face = voxelShade(material, 208);
+    for (int wy = back; wy < front; ++wy) {
+        int sx = voxelX(v, x, wy);
+        int sy = voxelY(v, wy, z + h);
+        unsigned phase = (unsigned)(wy - y) * 15u + 5u;
+        for (int col = 0; col < w; ++col)
+            voxelPixel(v, sx + col, sy, wy,
+                       voxelInteriorStoneShade(atlas, material, (unsigned)col * 17u + 3u, phase));
+        for (int dz = 1; dz <= h; ++dz)
+            voxelPixel(v, sx, sy + dz, wy,
+                       voxelInteriorStoneShade(atlas, side, phase, (unsigned)(z + dz) * 19u + 11u));
+    }
+    int sx = voxelX(v, x, front);
+    int sy = voxelY(v, front, z + h);
+    for (int row = 0; row < h; ++row)
+        for (int col = 0; col < w; ++col)
+            voxelPixel(v, sx + col, sy + row, front,
+                       voxelInteriorStoneShade(atlas, face, (unsigned)col * 17u + 3u,
+                                               (unsigned)(z + row) * 19u + 11u));
+}
+#endif
