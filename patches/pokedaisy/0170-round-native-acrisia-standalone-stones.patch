+
+/* Only the source-scoped standalone placements own a whole turf floor.
+ * The connected outcrops and adjoining retaining walls use different layers. */
+static int sceneryAcrisiaStonesPrepare(const struct Snap* s,const struct VoxelView* view,
+                                       int cellX,int cellY,uint32_t alpha,uint32_t* texture,
+                                       struct SceneryStone* stones) {
+    if (solidRom!=0x558ae42fu || s->group!=0 || s->num!=57 ||
+        !F.mapHeader || r32(F.mapHeader)!=0x08f638a4u ||
+        s->primary!=0x08e3e21cu || s->secondary!=0x08e3e92cu ||
+        s->width!=50 || s->height!=36) return 0;
+    int count=0;
+    for (size_t i=0; i<sizeof(acrisiaStonePlacements)/sizeof(*acrisiaStonePlacements); ++i) {
+        const struct SceneryStonePlacement* p=&acrisiaStonePlacements[i];
+        int mx=MAP_OFFSET+p->x,my=MAP_OFFSET+p->y;
+        int col=mx-cellX,row=my-cellY;
+        if ((unsigned)col>=(unsigned)view->cols || (unsigned)row>=(unsigned)view->rows ||
+            (unsigned)mx>=(unsigned)s->vw || (unsigned)my>=(unsigned)s->vh ||
+            s->vmap[my*s->vw+mx]!=p->native || !sceneryCellVisible(col,row)) continue;
+        struct SceneryStone* stone=&stones[count++];
+        stone->shape=&sceneryStoneShapes[p->shape];
+        stone->x=view->left+col*16;
+        stone->y=view->top+row*16;
+        stone->rise=voxelRise(view,col,row);
+        stone->tile=p->native&1023;
+        for (int y=0; y<16; ++y) for (int x=0; x<16; ++x) {
+            uint32_t floor=solidPlantGroundPixel(s,stone->tile,x,y,alpha,1);
+            unsigned weight=(x>=stone->shape->twoEdges[y][0] && x<=stone->shape->twoEdges[y][1])?218u:256u;
+            texture[(row*16+y)*view->stride+col*16+x]=voxelShade(climateGround(floor,2),weight);
+        }
+    }
+    return count;
+}
+
+static unsigned sceneryStoneHeight(const struct SceneryStoneShape* shape,int x,int y) {
+    if ((unsigned)x>=16 || (unsigned)y>=16) return 0;
+    int west=shape->twoEdges[y][0],east=shape->twoEdges[y][1];
+    if (x<west || x>east) return 0;
+    int distance=x-west;
+    if (east-x<distance) distance=east-x;
+    if (y<distance) distance=y;
+    if (15-y<distance) distance=15-y;
+    if (distance==0) return 1;
+    unsigned rise=2u+(unsigned)distance;
+    return rise<shape->peak?rise:shape->peak;
+}
+
+static void sceneryStoneDraw(const struct Snap* s,const struct VoxelView* view,
+                             const struct SceneryStone* stone,uint32_t alpha) {
+    for (int y=0; y<16; ++y) for (int x=0; x<16; ++x) {
+        unsigned height=sceneryStoneHeight(stone->shape,x,y);
+        if (!height) continue;
+        int wy=stone->y+y,wx=stone->x+x;
+        int rx=voxelX(view,wx,wy), cap=voxelY(view,wy,stone->rise+(int)height);
+        uint32_t ink=solidMaterialPixel(s,stone->tile,x,y,alpha);
+        unsigned west=sceneryStoneHeight(stone->shape,x-1,y);
+        unsigned south=sceneryStoneHeight(stone->shape,x,y+1);
+        unsigned edge=west<south?west:south;
+        for (unsigned z=edge; z<height; ++z) {
+            int front=voxelY(view,wy,stone->rise+(int)z);
+            voxelPixel(view,rx,front,wy,voxelShade(ink,z==0?160u:203u));
+        }
+        voxelPixel(view,rx,cap,wy,voxelShade(ink,west<height?233u:256u));
+    }
+}
