     struct DrescoBench drescoBenches[sizeof(drescoBenchPlacements)/sizeof(*drescoBenchPlacements)];
     int drescoBenchCount=drescoBenchPrepare(s,&voxel,cellX,cellY,href,vref,alpha,texture,drescoBenches);
+    struct SceneryStone stones[sizeof(acrisiaStonePlacements)/sizeof(*acrisiaStonePlacements)];
+    int stoneCount=solidGroundAligned(href,vref)
+        ? sceneryAcrisiaStonesPrepare(s,&voxel,cellX,cellY,alpha,texture,stones) : 0;
     if (groundMask && aligned) {
         uint8_t groundCells[sizeof(rises)];
         for (int row=0; row<rows; ++row)
@@ -6245,6 +6319,7 @@ static bool drawVoxel(const struct Snap* s, int cx, int cy, int href, int vref,
         const struct VoxelGroundMaterial groundMaterial = {groundCells,cx,cy};
         voxelTerrainSurfaces(&voxel,texture,&groundMaterial,span);
     } else voxelTerrainSurfaces(&voxel,texture,NULL,span);
