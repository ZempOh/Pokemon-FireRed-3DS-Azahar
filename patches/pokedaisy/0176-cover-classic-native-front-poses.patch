+/* Classic adds four bytes to each BattlePokemon. The exact ROM symbol table has
+ * four 0x5c entries; the second entry is this single battle's opponent. */
+static const struct ClassicBattleFront* battleClassicFront(void) {
+    if (r8(0x020230e0u)!=2 || r8(0x020230ebu)!=1) return NULL;
+    unsigned species=r16(0x02023154u);
+    return species && species<sizeof(classicBattleFronts)/sizeof(*classicBattleFronts)
+        ? &classicBattleFronts[species] : NULL;
+}
+
+static bool battleKnownClassicPose(const struct ClassicBattleFront* front,
+        uint32_t art, int y, const uint16_t* colors) {
+    if (y!=front->y || (art!=front->frame[0] && art!=front->frame[1] && art!=front->frame[2]))
+        return false;
+    uint32_t palette=battleVolumeFingerprint((const uint8_t*)(colors+1),30);
+    return palette==front->normal || palette==front->shiny;
+}
