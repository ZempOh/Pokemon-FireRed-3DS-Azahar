         for (int x = 0; x < cols; x++)
             rises[y * cols + x] = (uint8_t) terrainRise(s, cellX + x, cellY + y);
 
+    uint8_t hiddenSouthFaces[sizeof(rises)];
     struct VoxelView voxel = { out, depth, texture, v.w, v.h, v.x + v.w / 2, v.y + v.h / 2,
-                               left, top, cols, rows, w, rises };
+                               left, top, cols, rows, w, rises,
+                               sceneryRoute212SouthFaces(s,cellX,cellY,cols,rows,hiddenSouthFaces) };
     SCENERY_FRAME_MARK(cost0);
     drawRegion(s, cx, cy, href, vref, left, top, right, bottom, false, texture, w, alpha, true);
     rawView = v;
