+/* Here the native rocky lip occupies the next cell below the higher
+ * grass shelf. The upper edge is ordinary turf and has no separate wall. */
+static const uint8_t* sceneryRoute212SouthFaces(const struct Snap* s,int cellX,int cellY,
+                                                int cols,int rows,uint8_t* hidden) {
+    if (solidRom!=0x2be557a3u || s->group!=0 || s->num!=30 ||
+        !F.mapHeader || r32(F.mapHeader)!=0x089d90c0u ||
+        s->primary!=0x083df704u || s->secondary!=0x083df77cu ||
+        s->width!=40 || s->height!=80) return NULL;
+
+    static const struct { uint8_t x,y; uint16_t upper,lower; } transitions[] = {
+        {21,69,0x5004,0x0001},
+        {16,70,0x500d,0x0487},
+        {17,70,0x500d,0x0487},
+        {18,70,0x500d,0x0487},
+        {19,70,0x500d,0x04d6},
+        {20,70,0x500d,0x0001},
+    };
+    memset(hidden,0,(size_t)cols*rows);
+    for (size_t i=0; i<sizeof(transitions)/sizeof(*transitions); ++i) {
+        int x=MAP_OFFSET+transitions[i].x, y=MAP_OFFSET+transitions[i].y;
+        int col=x-cellX,row=y-cellY;
+        if ((unsigned)col>=(unsigned)cols || (unsigned)row>=(unsigned)(rows-1) ||
+            (unsigned)x>=(unsigned)s->vw || (unsigned)(y+1)>=(unsigned)s->vh) continue;
+        const uint16_t* cell=s->vmap+y*s->vw+x;
+        if (*cell==transitions[i].upper && cell[s->vw]==transitions[i].lower)
+            hidden[row*cols+col]=1;
+    }
+    return hidden;
+}
