diff --git a/app/src/main/cpp/pk_gen1_battle_back.h b/app/src/main/cpp/pk_gen1_battle_back.h
new file mode 100644
index 0000000..1d8caea
--- /dev/null
+++ b/app/src/main/cpp/pk_gen1_battle_back.h
@@ -0,0 +1,141 @@
+#pragma once
+
+/* The signed-address battle window places the player above the dialogue box.
+ * Same rear art can be shared across hardware palettes and cartridge layouts. */
+enum { GEN1_BACK_X=8, GEN1_BACK_Y=40, GEN1_BACK_SIZE=56, GEN1_BACK_FIRST_TILE=0x31 };
+enum Gen1BackArtId { GEN1_BACK_SQUIRTLE, GEN1_BACK_PIKACHU };
+
+static const struct {
+    uint32_t fingerprint;
+    uint8_t species;
+} gen1BattleBackArt[] = {
+    [GEN1_BACK_SQUIRTLE]={0xbb337c4du,0xb1},
+    [GEN1_BACK_PIKACHU]={0x710bc78du,0x54}
+};
+
+struct Gen1BattleBackProfile {
+    uint32_t crc;
+    uint16_t player;
+    uint8_t art, attribute;
+};
+static const struct Gen1BattleBackProfile gen1BattleBackProfiles[] = {
+    {0x9f7fdd53u,0xd014,GEN1_BACK_SQUIRTLE,0},
+    {0xd6da8a1au,0xd014,GEN1_BACK_PIKACHU,0},
+    {0x7d527d62u,0xd013,GEN1_BACK_PIKACHU,2}
+};
+
+static const struct Gen1BattleBackProfile* gbGen1BattleBack;
+static bool gbGen1BackArmed, gbGen1BackInvalid;
+static uint32_t gbGen1BackFrame;
+static uint8_t gbGen1BackInk[GEN1_BACK_SIZE][GEN1_BACK_SIZE];
+
+static void gbGen1BackConfigure(uint32_t crc) {
+    gbGen1BattleBack=NULL;
+    gbGen1BackArmed=false;
+    gbGen1BackInvalid=true;
+    for (size_t i=0;i<sizeof(gen1BattleBackProfiles)/sizeof(*gen1BattleBackProfiles);++i)
+        if (gen1BattleBackProfiles[i].crc==crc) {
+            gbGen1BattleBack=&gen1BattleBackProfiles[i];
+            return;
+        }
+}
+
+static unsigned gbGen1BackTile(int x, int y) {
+    return GEN1_BACK_FIRST_TILE+(unsigned)(x/8*7+y/8);
+}
+
+static void gbGen1BackObserve(struct GBVideoRenderer* renderer, int start, int end, int y) {
+    if (!gbGen1BackArmed || y<GEN1_BACK_Y || y>=GEN1_BACK_Y+GEN1_BACK_SIZE) return;
+    if (y==GEN1_BACK_Y && start==0) {
+        gbGen1BackFrame=gbB->video.frameCounter;
+        gbGen1BackInvalid=false;
+        memset(gbGen1BackInk,0xff,sizeof(gbGen1BackInk));
+    }
+    if (end<=GEN1_BACK_X || start>=GEN1_BACK_X+GEN1_BACK_SIZE || gbGen1BackInvalid ||
+        gbGen1BackFrame!=gbB->video.frameCounter) return;
+
+    const struct GBVideoSoftwareRenderer* r=(const struct GBVideoSoftwareRenderer*)renderer;
+    const struct Gen1BattleOwnership* layout=gbGen1BattleBatchLayout;
+    if (r->model!=layout->model || r->sgbBorders || renderer->sgbRenderMode ||
+        r->lcdc!=layout->lcdc || !r->hasWindow || renderer->disableWIN || renderer->highlightWIN ||
+        r->wx+r->currentWx!=7 || r->wy+r->currentWy!=0 || r->offsetWx || r->offsetWy) {
+        gbGen1BackInvalid=true;
+        return;
+    }
+    int from=start<GEN1_BACK_X ? GEN1_BACK_X : start;
+    int to=end>GEN1_BACK_X+GEN1_BACK_SIZE ? GEN1_BACK_X+GEN1_BACK_SIZE : end;
+    unsigned attribute=gbGen1BattleBack->attribute;
+    unsigned paletteBase=(attribute&7u)*4u;
+    for (int x=from;x<to;++x) {
+        unsigned mapAddress=0x1c00+(y/8)*32+x/8;
+        int px=x-GEN1_BACK_X, py=y-GEN1_BACK_Y;
+        if (renderer->vram[mapAddress]!=gbGen1BackTile(px,py) ||
+            r->row[x]<paletteBase || r->row[x]>paletteBase+3 ||
+            (layout->model==GB_MODEL_CGB && renderer->vram[mapAddress+0x2000]!=attribute)) {
+            gbGen1BackInvalid=true;
+            return;
+        }
+        gbGen1BackInk[py][px]=(uint8_t)(r->row[x]-paletteBase);
+    }
+}
+
+static void gbGen1BackArm(bool active) {
+    bool next=active && gbGen1BattleBack && gbGen1BattleBatchLayout &&
+        pk_wide_battle_detail_requested() &&
+        gbRam(gbGen1BattleBack->player)==gen1BattleBackArt[gbGen1BattleBack->art].species;
+    if (next!=gbGen1BackArmed) gbGen1BackInvalid=true;
+    gbGen1BackArmed=next;
+}
+
+static void gbGen1BackVolume(const uint32_t* frame, const uint32_t* out, struct PkWideView v) {
+    if (!gbGen1BackArmed || gbGen1BackInvalid || gbGen1BackFrame+1!=gbB->video.frameCounter) return;
+    if (gbR->sgbBorders || gbR->d.sgbRenderMode) return;
+    const struct Gen1BattleOwnership* layout=gbGen1BattleBatchLayout;
+    if (gbRam(layout->battle)!=1 || gbRam(layout->menu)!=14 ||
+        gbRam(layout->menu+1)!=layout->menuX || gbRam(layout->menu+2)!=0) return;
+
+    uint32_t fingerprint=2166136261u, palette[4]={0};
+    unsigned seen=0;
+    for (int y=0;y<GEN1_BACK_SIZE;++y) for (int x=0;x<GEN1_BACK_SIZE;++x) {
+        unsigned ink=gbGen1BackInk[y][x];
+        if (ink>3) return;
+        fingerprint=(fingerprint^gbGen1BackTile(x,y))*16777619u;
+        fingerprint=(fingerprint^ink)*16777619u;
+        uint32_t color=frame[(y+GEN1_BACK_Y)*GBW+x+GEN1_BACK_X]&0x00ffffffu;
+        if ((seen&(1u<<ink)) && palette[ink]!=color) return;
+        palette[ink]=color;
+        seen|=1u<<ink;
+    }
+    if (fingerprint!=gen1BattleBackArt[gbGen1BattleBack->art].fingerprint ||
+        seen!=15 || palette[0]==palette[1] || palette[0]==palette[2] || palette[0]==palette[3]) return;
+
+    static struct BattleVolumeDetail detail;
+    static uint32_t meshFingerprint;
+    if (meshFingerprint!=fingerprint) {
+        uint8_t art[2048]={0};
+        for (int y=0;y<GEN1_BACK_SIZE;++y) for (int x=0;x<GEN1_BACK_SIZE;++x) {
+            unsigned slot=((y/8)*8+x/8)*32+(y%8)*4+(x%8)/2;
+            art[slot]|=(uint8_t)(gbGen1BackInk[y][x]<<((x&1)*4));
+        }
+        battleVolumeDetailBuild(&detail,art,-.44f,-.39f);
+        meshFingerprint=fingerprint;
+    }
+    for (int y=0;y<GEN1_BACK_SIZE;++y) for (int x=0;x<GEN1_BACK_SIZE;++x) {
+        int screenX=x+GEN1_BACK_X, screenY=y+GEN1_BACK_Y;
+        if ((unsigned)(screenX-v.x)>=(unsigned)v.w || (unsigned)(screenY-v.y)>=(unsigned)v.h) continue;
+        int row=y+BATTLE_VOLUME_MARGIN, col=x+BATTLE_VOLUME_MARGIN;
+        if (!battleVolumeDetailCovers(&detail,col,row)) continue;
+        uint32_t base=out[(screenY-v.y)*v.w+screenX-v.x];
+        uint32_t native=frame[screenY*GBW+screenX];
+        uint32_t samples[4]={base,base,base,base};
+        bool painted=false;
+        for (int sy=0;sy<2;++sy) for (int sx=0;sx<2;++sx) {
+            const struct BattleVolumePixel* sub=&detail.pixels[row*2+sy][col*2+sx];
+            if (!sub->ink || (!gbGen1BackInk[y][x] && sub->face==1)) continue;
+            unsigned light=battleVolumeDetailLight(&detail,sub,col*2+sx,row*2+sy);
+            samples[sy*2+sx]=voxelShade((native&0xff000000u)|palette[sub->ink],light);
+            painted=true;
+        }
+        if (painted) pk_wide_battle_detail_pixel(screenX,screenY,samples);
+    }
+}
