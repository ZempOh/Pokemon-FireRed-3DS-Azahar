 }
+/* Native night palettes can turn green foliage too teal for terrain hue
+ * detection. A verified source mask can keep its seasonal colors on those pixels. */
+static uint32_t climateSourceFoliage(uint32_t c,int groundMode) {
+    unsigned r=c&255,g=(c>>8)&255,b=(c>>16)&255;
+    if (!voxelClimate.seasonBlend || (g>r+8 && g>b+8)) return climateGround(c,groundMode);
+    const int season=voxelClimate.season,previous=(season+3)&3;
+    const unsigned blend=voxelClimate.seasonBlend,transition=voxelClimate.seasonTransition;
+    uint32_t color=season==3 ? climateGroundColor(c,2,3,blend)
+        : climateMix(c,climateLeafTarget(c,season),blend);
+    if (transition) {
+        uint32_t start=previous==3 ? climateGroundColor(c,2,3,blend)
+            : climateMix(c,climateLeafTarget(c,previous),blend);
+        color=climateMix(color,start,transition);
+    }
+    return color;
+}
