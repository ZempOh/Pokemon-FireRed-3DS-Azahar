+/* A short west-wall penumbra for the three source-verified Pallet houses.
+ * Shade only native ground. Keep geometry and actor depth entirely intact. */
+static void redHouseContactShadow(const struct GbSnap* snap,const struct VoxelView* v,
+                                  const uint8_t* materials,const uint8_t* details,int x,int y,int h) {
+    static const unsigned strength[] = {205,219,233,243,250};
+    int start=voxelY(v,y+5,0),stop=voxelY(v,y+h-5,0);
+    if (start<0) start=0;
+    if (stop>v->height) stop=v->height;
+    for (int py=start;py<stop;++py) {
+        int wy=voxelWorldY(v,py,0);
+        int row=voxelFloor(wy-v->top,VOXEL_TILE);
+        if ((unsigned)row>=(unsigned)v->rows) continue;
+        int end=wy-y-4,other=y+h-4-wy;
+        if (other<end) end=other;
+        uint32_t groundDepth=(uint32_t)(wy-v->top+1)*512u;
+        for (int distance=1;distance<=5 && distance<end;++distance) {
+            int wx=x-distance,col=voxelFloor(wx-v->left,VOXEL_TILE);
+            if ((unsigned)col>=(unsigned)v->cols) continue;
+            int source=row*v->cols+col;
+            if (materials[source]!=RED_FIELD || details[source]!=RED_DETAIL_NONE ||
+                gbPalletWaterTile(snap,wx/8,wy/8)) continue;
+            int px=voxelX(v,wx,wy);
+            if ((unsigned)px>=(unsigned)v->width) continue;
+            int at=py*v->width+px;
+            if (v->depth[at]==groundDepth)
+                v->out[at]=voxelShade(v->out[at],strength[distance-1]);
         }
     }
 }
