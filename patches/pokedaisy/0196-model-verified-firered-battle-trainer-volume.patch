 #ifdef PK_BATTLE_BACK_DETAIL
 #include "pk_battle_back_family.h"
 
@@ -5204,8 +5208,41 @@ static void battleBackVolumeDraw(const uint32_t* frame, uint32_t* out, struct Pk
         back=(struct BattleVolumeTarget){art,profile->art,k,40,y,palette,true};
     }
     if (back.object<0) return;
