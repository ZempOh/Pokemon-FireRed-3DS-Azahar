diff --git a/app/src/main/cpp/pk_scenery_rock_material_profiles.h b/app/src/main/cpp/pk_scenery_rock_material_profiles.h
new file mode 100644
index 0000000..c8da2e0
--- /dev/null
+++ b/app/src/main/cpp/pk_scenery_rock_material_profiles.h
@@ -0,0 +1,22 @@
+// Exact native frames with verified FireRed rock artwork and palette.
+#pragma once
+
+static bool sceneryFireRedRockMaterial(uint32_t rom,uint32_t images) {
+    switch (rom) {
+    case 0x63478921u: // ash-gray
+        return images==0x83a1698u || images==0x83a16b8u;
+    case 0x5e704d77u: // fakemon
+        return images==0x83a1698u || images==0x83a16b8u;
+    case 0xdd88761cu: // firered
+        return images==0x83a1698u || images==0x83a16b8u;
+    case 0x964763c0u: // frlgplus
+        return images==0x8417f88u || images==0x8417fa8u;
+    case 0xb9465c5au: // gaia
+        return images==0x83a1698u || images==0x83a16b8u;
+    case 0x25c3d89fu: // letsgo
+        return images==0x8812094u;
+    case 0xf2d16ebdu: // rocket
+        return images==0x83a1698u;
+    default: return false;
+    }
+}
