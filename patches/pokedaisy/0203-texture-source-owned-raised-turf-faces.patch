+/* The vertical extrusion belongs to the upper turf cell, independently of
+ * the authored shore/rim on the lower tile. Match both full metatile words. */
+static const uint8_t* sceneryTurfSouthFaces(const struct Snap* s,int cellX,int cellY,
+                                           int cols,int rows,uint8_t* cells) {
+    if (!F.mapHeader) return NULL;
+    for (size_t m=0; m<sizeof(sceneryTurfFaceMaps)/sizeof(*sceneryTurfFaceMaps); ++m) {
+        const struct SceneryTurfFaceMap* map=&sceneryTurfFaceMaps[m];
+        if (map->rom!=solidRom || map->group!=s->group || map->map!=s->num ||
+            map->layout!=r32(F.mapHeader) || map->primary!=s->primary ||
+            map->secondary!=s->secondary || map->width!=s->width || map->height!=s->height)
+            continue;
+        memset(cells,0,(size_t)cols*rows);
+        for (unsigned n=0; n<map->count; ++n) {
+            const struct SceneryTurfFaceRun* run=&map->runs[n];
+            const int y=MAP_OFFSET+run->y, row=y-cellY;
+            if ((unsigned)row>=(unsigned)(rows-1) || (unsigned)(y+1)>=(unsigned)s->vh) continue;
+            for (int x=run->first; x<=run->last; ++x) {
+                const int mx=MAP_OFFSET+x, col=mx-cellX;
+                if ((unsigned)col>=(unsigned)cols || (unsigned)mx>=(unsigned)s->vw) continue;
+                const unsigned end=x==run->first ? 0u : x==run->last ? 2u : 1u;
+                const uint16_t* upper=s->vmap+y*s->vw+mx;
+                if (*upper==run->upper && upper[s->vw]==run->lower[end])
+                    cells[row*cols+col]=1;
+            }
+        }
+        return cells;
+    }
+    return NULL;
+}
