diff --git a/app/src/main/cpp/pk_scenery_marine_rocks.h b/app/src/main/cpp/pk_scenery_marine_rocks.h
new file mode 100644
--- /dev/null
+++ b/app/src/main/cpp/pk_scenery_marine_rocks.h
@@ -0,0 +1,104 @@
+/* Exact isolated Gaia sea rocks. Preserve native mixed shorelines and clusters. */
+#pragma once
+
+#ifndef SCENERY_GAIA_MARINE_ROCKS
+#define SCENERY_GAIA_MARINE_ROCKS 1
+#endif
+
+#if SCENERY_GAIA_MARINE_ROCKS
+struct MarineRockShape {
+    uint16_t words[4];
+    uint8_t relief[32][16];
+};
+
+struct MarineRockPlacement {
+    uint8_t x, y, shape;
+};
+
+#include "pk_scenery_marine_rock_profiles.h"
+
+struct MarineRock {
+    const struct MarineRockShape* shape;
+    int x, y;
+};
+
+static unsigned marineRockHeight(const struct MarineRockShape* shape, int x, int y) {
+    if ((unsigned)x >= 32 || (unsigned)y >= 32) return 0;
+    return (shape->relief[y][x / 2] >> ((x & 1) * 4)) & 15u;
+}
+
+static bool marineRockPlacementMatches(const struct Snap* s, int x, int y,
+                                      const struct MarineRockShape* shape) {
+    if (x <= 0 || y <= 0 || x + 2 >= s->vw || y + 2 >= s->vh) return false;
+    const uint16_t* source=s->vmap+y*s->vw+x;
+    for (int i=0; i<2; ++i) {
+        if (source[-s->vw+i]!=0x112b || source[2*s->vw+i]!=0x112b ||
+            source[i*s->vw-1]!=0x112b || source[i*s->vw+2]!=0x112b)
+            return false;
+        for (int j=0; j<2; ++j)
+            if (source[i*s->vw+j]!=shape->words[i*2+j]) return false;
+    }
+    return true;
+}
+
+static int sceneryMarineRocksPrepare(const struct Snap* s, const struct VoxelView* view,
+                                     int cellX, int cellY, uint32_t alpha,
+                                     uint8_t* rises, uint32_t* texture,
+                                     struct MarineRock* rocks) {
+    if (solidRom!=0xb9465c5au || s->group!=3 || s->num!=3 ||
+        !F.mapHeader || r32(F.mapHeader)!=0x08a8a2a4u ||
+        s->primary!=0x082d4a94u || s->secondary!=0x082d4af4u ||
+        s->width!=80 || s->height!=52) return 0;
+
+    int count=0;
+    for (size_t i=0; i<sizeof(marineRockPlacements)/sizeof(*marineRockPlacements); ++i) {
+        const struct MarineRockPlacement* p=&marineRockPlacements[i];
+        const struct MarineRockShape* shape=&marineRockShapes[p->shape];
+        int mx=MAP_OFFSET+p->x, my=MAP_OFFSET+p->y;
+        int col=mx-cellX, row=my-cellY;
+        // Include the complete neighborhood before changing either terrain
+        // or rock surface, including the off-screen source safety margin.
+        if (col<0 || row<0 || col+1>=view->cols || row+1>=view->rows ||
+            !marineRockPlacementMatches(s,mx,my,shape)) continue;
+
+        bool overlap=false;
+        for (int y=0; y<32 && !overlap; ++y)
+            for (int x=0; x<32; ++x)
+                if (marineRockHeight(shape,x,y) && holeBuf[row*16+y][col*16+x]) {
+                    overlap=true;
+                    break;
+                }
+        if (overlap) continue;
+        rocks[count++]=(struct MarineRock){shape,view->left+col*16,view->top+row*16};
+
+        for (int y=0; y<2; ++y) for (int x=0; x<2; ++x)
+            rises[(row+y)*view->cols+col+x]=0;
+        for (int y=0; y<32; ++y) for (int x=0; x<32; ++x) {
+            if (!marineRockHeight(shape,x,y)) continue;
+            int tile=shape->words[y/16*2+x/16]&1023;
+            size_t at=(size_t)(row*16+y)*view->stride+col*16+x;
+            // Read the same cell's live animated lower layer. Blue corner and
+            // wake details outside the opaque rock mask stay in the native frame.
+            texture[at]=solidPlantGroundPixel(s,tile,x&15,y&15,alpha,1);
+        }
+    }
+    return count;
+}
+
+static void sceneryMarineRockDraw(const struct Snap* s, const struct VoxelView* view,
+                                 const struct MarineRock* rock, uint32_t alpha) {
+    const struct MarineRockShape* shape=rock->shape;
+    for (int y=0; y<32; ++y) for (int x=0; x<32; ++x) {
+        unsigned height=marineRockHeight(shape,x,y);
+        if (!height) continue;
+        int tile=shape->words[y/16*2+x/16]&1023;
+        uint32_t ink=solidMaterialPixel(s,tile,x&15,y&15,alpha);
+        unsigned west=marineRockHeight(shape,x-1,y), south=marineRockHeight(shape,x,y+1);
+        unsigned seam=west<south?west:south;
+        int wy=rock->y+y, rx=voxelX(view,rock->x+x,wy);
+        for (unsigned z=seam; z<height; ++z)
+            voxelPixel(view,rx,voxelY(view,wy,(int)z),wy,voxelShade(ink,z?205u:159u));
+        voxelPixel(view,rx,voxelY(view,wy,(int)height),wy,voxelShade(ink,west<height?236u:256u));
+    }
+}
+#endif
