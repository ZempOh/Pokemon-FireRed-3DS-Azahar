diff --git a/app/src/main/cpp/pk_scenery_marine_cluster.h b/app/src/main/cpp/pk_scenery_marine_cluster.h
new file mode 100644
--- /dev/null
+++ b/app/src/main/cpp/pk_scenery_marine_cluster.h
@@ -0,0 +1,84 @@
+/* One complete source-owned Aerous City marine outcrop. */
+#pragma once
+
+#ifndef SCENERY_GAIA_MARINE_CLUSTER
+#define SCENERY_GAIA_MARINE_CLUSTER 1
+#endif
+
+#if SCENERY_GAIA_MARINE_CLUSTER
+struct MarineClusterEdge { int8_t x,y; uint16_t word; };
+#include "pk_scenery_marine_cluster_profile.h"
+
+struct MarineCluster {
+    int x, y;
+    bool active;
+};
+
+static unsigned marineClusterHeight(int x,int y) {
+    if ((unsigned)x>=marineClusterCols*16u || (unsigned)y>=marineClusterRows*16u) return 0;
+    return (marineClusterRelief[y][x/2]>>((x&1)*4))&15u;
+}
+
+static uint16_t marineClusterSourceWord(const struct Snap* s,int x,int y) {
+    if ((unsigned)x>=(unsigned)s->vw || (unsigned)y>=(unsigned)s->vh) return 0;
+    return s->vmap[y*s->vw+x];
+}
+
+static struct MarineCluster sceneryMarineClusterPrepare(const struct Snap* s,const struct VoxelView* v,
+                                                        int cellX,int cellY,uint32_t alpha,
+                                                        uint8_t* rises,uint32_t* texture) {
+    struct MarineCluster cluster={0};
+    if (solidRom!=0xb9465c5au || s->group!=3 || s->num!=3 ||
+        !F.mapHeader || r32(F.mapHeader)!=0x08a8a2a4u ||
+        s->primary!=0x082d4a94u || s->secondary!=0x082d4af4u ||
+        s->width!=80 || s->height!=52) return cluster;
+    int mx=MAP_OFFSET+marineClusterX,my=MAP_OFFSET+marineClusterY;
+    int col=mx-cellX,row=my-cellY;
+    if (col>=v->cols || row>=v->rows || col+marineClusterCols<=0 || row+marineClusterRows<=0)
+        return cluster;
+    for (size_t i=0;i<sizeof(marineClusterEdges)/sizeof(*marineClusterEdges);++i) {
+        const struct MarineClusterEdge* e=&marineClusterEdges[i];
+        if (marineClusterSourceWord(s,mx+e->x,my+e->y)!=e->word) return cluster;
+    }
+    // Confirm every selected cell and its original in-rectangle water before
+    // changing any part of the cluster. The virtual window can clip its edge.
+    for (int dy=0;dy<marineClusterRows;++dy) for (int dx=0;dx<marineClusterCols;++dx) {
+        uint16_t word=marineClusterWords[dy][dx];
+        if (marineClusterSourceWord(s,mx+dx,my+dy)!=(word?word:0x112bu)) return cluster;
+        if (!word || (unsigned)(col+dx)>=(unsigned)v->cols ||
+            (unsigned)(row+dy)>=(unsigned)v->rows) continue;
+        for (int y=0;y<16;++y) for (int x=0;x<16;++x)
+            if (marineClusterHeight(dx*16+x,dy*16+y) && holeBuf[(row+dy)*16+y][(col+dx)*16+x])
+                return cluster;
+    }
+    for (int dy=0;dy<marineClusterRows;++dy) for (int dx=0;dx<marineClusterCols;++dx) {
+        if (!marineClusterWords[dy][dx] || (unsigned)(col+dx)>=(unsigned)v->cols ||
+            (unsigned)(row+dy)>=(unsigned)v->rows) continue;
+        rises[(row+dy)*v->cols+col+dx]=0;
+        for (int y=0;y<16;++y) for (int x=0;x<16;++x) {
+            if (!marineClusterHeight(dx*16+x,dy*16+y)) continue;
+            size_t at=(size_t)((row+dy)*16+y)*v->stride+(col+dx)*16+x;
+            // Core reef tiles contain native rock in both layers. Sample
+            // the live adjacent water metatile at the same world phase.
+            texture[at]=solidPlantGroundPixel(s,0x12b,x,y,alpha,1);
+        }
+    }
+    return (struct MarineCluster){v->left+col*16,v->top+row*16,true};
+}
+
+static void sceneryMarineClusterDraw(const struct Snap* s,const struct VoxelView* v,
+                                    const struct MarineCluster* cluster,uint32_t alpha) {
+    for (int y=0;y<marineClusterRows*16;++y) {
+        int wy=cluster->y+y;
+        if (voxelY(v,wy,0)<0 || voxelY(v,wy,13)>=v->height) continue;
+        for (int x=0;x<marineClusterCols*16;++x) {
+            unsigned height=marineClusterHeight(x,y);
+            if (!height) continue;
+            int wx=cluster->x+x;
+            if ((unsigned)voxelX(v,wx,wy)>=(unsigned)v->width) continue;
+            uint32_t ink=solidMaterialPixel(s,marineClusterWords[y/16][x/16]&1023,x&15,y&15,alpha);
+            marineRockDrawSample(v,wx,wy,height,marineClusterHeight(x-1,y),marineClusterHeight(x,y+1),ink);
+        }
+    }
+}
+#endif
