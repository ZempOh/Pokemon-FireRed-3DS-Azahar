diff --git a/app/src/main/cpp/pk_gen1_battle_trainer.h b/app/src/main/cpp/pk_gen1_battle_trainer.h
new file mode 100644
index 0000000..897b3be
--- /dev/null
+++ b/app/src/main/cpp/pk_gen1_battle_trainer.h
@@ -0,0 +1,48 @@
+#pragma once
+
+// The native Youngster acknowledgement uses the same picture and dialogue
+// in these three English cartridges. Each layout binds its own WRAM fields.
+struct Gen1TrainerLayout {
+    uint32_t crc;
+    uint16_t trainerClass, picPointer, currentOpponent, firstSpecies, partySlot, linkState;
+};
+
+static const struct Gen1TrainerLayout gen1YoungsterLayouts[] = {
+    {0x9f7fdd53u,0xd031,0xd033,0xd059,0xcfd8,0xcfe8,0xd12b},
+    {0xd6da8a1au,0xd031,0xd033,0xd059,0xcfd8,0xcfe8,0xd12b},
+    {0x7d527d62u,0xd030,0xd032,0xd058,0xcfd7,0xcfe7,0xd12a},
+};
+
+static const struct Gen1TrainerLayout* gbGen1TrainerLayout;
+static bool gbGen1TrainerArmed;
+static const uint32_t gen1YoungsterInk = 0x103169a8u;
+
+static void gbGen1TrainerConfigure(uint32_t crc) {
+    gbGen1TrainerLayout=NULL;
+    gbGen1TrainerArmed=false;
+    for (size_t i=0; i<sizeof gen1YoungsterLayouts/sizeof *gen1YoungsterLayouts; ++i)
+        if (gen1YoungsterLayouts[i].crc==crc) {
+            gbGen1TrainerLayout=&gen1YoungsterLayouts[i];
+            return;
+        }
+}
+
+static bool gbGen1TrainerStanding(const struct Gen1BattleOwnership* ownership) {
+    const struct Gen1TrainerLayout* layout=gbGen1TrainerLayout;
+    if (!ownership || !layout || gbR->d.sgbRenderMode || gbR->sgbBorders ||
+        gbRam(ownership->battle)!=2 ||
+        gbRam(layout->trainerClass)!=1 || gbRam(layout->currentOpponent)!=201 ||
+        gbRam16(layout->picPointer)!=0x4000 || gbRam(layout->linkState) ||
+        gbRam(layout->firstSpecies) || gbRam(layout->partySlot)!=255)
+        return false;
+
+    // These are the native text tiles for “YOUNGSTER wants / to fight!”.
+    // It is rendered after the intro slide and before the first Pokémon.
+    static const uint8_t first[] = {0x98,0x8e,0x94,0x8d,0x86,0x92,0x93,0x84,0x91,0x7f,0xb6,0xa0,0xad,0xb3,0xb2};
+    static const uint8_t second[] = {0xb3,0xae,0x7f,0xa5,0xa8,0xa6,0xa7,0xb3,0xe7};
+    for (size_t i=0; i<sizeof first; ++i)
+        if (gbRam(0xc3a0+14*20+1+i)!=first[i]) return false;
+    for (size_t i=0; i<sizeof second; ++i)
+        if (gbRam(0xc3a0+16*20+1+i)!=second[i]) return false;
+    return true;
+}
