@@ -0,0 +1,83 @@
+#pragma once
+
+/* Exact cartridge object owners and ordinary, verified field poses. The ROM
+ * frame table remains the authority for every tile. No graphics are bundled. */
+struct NativeFieldActorProfile {
+    uint32_t crc, images;
+    uint16_t poses;
+    uint8_t local, graphics, group, map, width, palette;
+};
+
+static const struct NativeFieldActorProfile nativeFieldActors[] = {
+    {0xdd88761cu,0x083a00a0u,0x1ffu,255,0,0,0,16,0}, // FireRed player
+    {0xdd88761cu,0x083a07c0u,0x086u,2,27,3,0,16,5},  // Pallet NPC
+    {0xe4deb9beu,0x088669f4u,0x1ffu,255,0,0,0,32,1}, // Classic player
+    {0xe4deb9beu,0x0885e86cu,0x084u,3,1,6,0,32,4},   // Pallet NPC
+    {0x263a1187u,0x08801f78u,0x1ffu,255,0,0,0,16,1}, // Modern Emerald player
+    {0x263a1187u,0x08802818u,0x126u,1,0,0,0,16,2},   // Petalburg NPC
+};
+
+static uint8_t nativeFieldActorSource(const struct Snap* snap,const uint8_t* event,uint32_t images) {
+    for (unsigned i=0;i<sizeof nativeFieldActors/sizeof *nativeFieldActors;++i) {
+        const struct NativeFieldActorProfile* p=&nativeFieldActors[i];
+        if (p->crc==solidRom && p->images==images &&
+            p->local==event[8] && p->graphics==event[5] &&
+            (p->local==255 || (p->group==snap->group && p->map==snap->num)))
+            return (uint8_t)(i+1);
+    }
+    return 0;
+}
+
+static bool nativeFieldActorOam(const struct Piece* p,const uint16_t* oam) {
+    int matches=0;
+    for (int k=0;k<128;++k) {
+        const uint16_t* o=&oam[k*4];
+        unsigned shape=o[0]>>14, size=o[1]>>14;
+        if (shape>2 || (o[0]&0x3f00) || (o[1]&0x2000) ||
+            (o[0]&255)!=(unsigned)p->y || (o[1]&511)!=(unsigned)p->x ||
+            ((o[1]&0x1000)!=0)!=p->hflip ||
+            OBJ_DIMS[shape][size][0]!=p->w || OBJ_DIMS[shape][size][1]!=p->h ||
+            o[2]!=(p->tile | p->prio<<10 | p->pal<<12)) continue;
+        ++matches;
+    }
+    return matches==1;
+}
+
+static bool nativeFieldActorWindow(const struct Piece* p) {
+    const int top=p->y>6 ? p->y-6 : 0;
+    int layers=-1;
+    bool open=true;
+    for (int y=top;y<p->y+p->h;++y) {
+        useLine(y);
+        const int at=windowLayers(p->x-3,y);
+        if ((io(0)&0x9000)!=0x1000 || !(at&0x10) ||
+            (layers>=0 && at!=layers) || !windowsUniform(p->x-3,p->w+6)) {
+            open=false;
+            break;
+        }
+        layers=at;
+    }
+    useLive();
+    return open;
+}
+
+
+static int nativeFieldActorPose(const struct Piece* p,const uint8_t* vram,const uint16_t* oam) {
+    if (!p->nativeActor || p->h!=32 || p->vflip ||
+        p->x<0 || p->y<0 || p->x+p->w>PK_WIDE_W || p->y+p->h>PK_WIDE_H) return -1;
+    const struct NativeFieldActorProfile* bind=&nativeFieldActors[p->nativeActor-1];
+    unsigned bytes=bind->width*16u, offset=p->tile*32u;
+    if (p->w!=bind->width || p->pal!=bind->palette || offset+bytes>0x8000u ||
+        !nativeFieldActorOam(p,oam) || !nativeFieldActorWindow(p)) return -1;
+    const uint8_t* live=vram+0x10000u+offset;
+    for (unsigned i=0;i<9;++i) {
+        if (!(bind->poses&(1u<<i))) continue;
+        const uint8_t* frame=mem(bind->images+i*8u,8);
+        if (!frame || le16(frame+4)!=bytes) continue;
+        uint32_t art=le32(frame);
+        if (art<0x08000000u || art+bytes>0x0a000000u) continue;
+        const uint8_t* ink=mem(art,bytes);
+        if (ink && !memcmp(live,ink,bytes)) return (int)i;
+    }
+    return -1;
+}
