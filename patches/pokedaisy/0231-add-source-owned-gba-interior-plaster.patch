diff --git a/app/src/main/cpp/pk_scenery_indoor_walls.h b/app/src/main/cpp/pk_scenery_indoor_walls.h
new file mode 100644
--- /dev/null
+++ b/app/src/main/cpp/pk_scenery_indoor_walls.h
@@ -0,0 +1,77 @@
+/* Material detail for exact native north-wall panels in reviewed interiors. */
+#pragma once
+
+#ifndef VOXEL_INDOOR_WALL_TEXTURE_SIZE
+#define VOXEL_INDOOR_WALL_TEXTURE_SIZE 256
+#endif
+
+#if VOXEL_INDOOR_WALL_TEXTURE_SIZE && VOXEL_GROUND_TEXTURE_SIZE == 256
+#include "pk_scenery_indoor_wall_profiles.h"
+
+static unsigned indoorWallTexel(unsigned coordinate) {
+    enum { step=256 / VOXEL_INDOOR_WALL_TEXTURE_SIZE };
+    return (coordinate&255u)/step*step+step/2;
+}
+
+static void sceneryIndoorWallPanels(const struct Snap* s,const struct VoxelView* v,
+                                    int cellX,int cellY,int href,int vref,unsigned mapType,
+                                    uint32_t* texture) {
+    if (mapType!=8 || !F.mapHeader || !solidGroundAligned(href,vref)) return;
+    const struct IndoorWallProfile* profile=NULL;
+    uint32_t layout=r32(F.mapHeader);
+    for (size_t i=0;i<sizeof(indoorWallProfiles)/sizeof(*indoorWallProfiles);++i) {
+        const struct IndoorWallProfile* p=&indoorWallProfiles[i];
+        if (p->rom==solidRom && p->layout==layout && p->primary==s->primary &&
+            p->secondary==s->secondary && p->group==s->group && p->map==s->num &&
+            p->width==s->width && p->height==s->height) {
+            profile=p;
+            break;
+        }
+    }
+    if (!profile) return;
+
+    const uint8_t* atlas=voxelGroundTexture();
+#ifdef __ANDROID__
+    unsigned sampled=0;
+#endif
+    for (unsigned i=0;i<profile->count;++i) {
+        const struct IndoorWallPanel* panel=&profile->panels[i];
+        int my=MAP_OFFSET+panel->row,row=my-cellY;
+        if ((unsigned)row>=(unsigned)v->rows || my>=s->vh) continue;
+        for (int x=0;x<s->width;++x) {
+            if (!(panel->columns&(1u<<x))) continue;
+            int mx=MAP_OFFSET+x,col=mx-cellX;
+            if ((unsigned)col>=(unsigned)v->cols || mx>=s->vw ||
+                s->vmap[my*s->vw+mx]!=panel->word) continue;
+            for (int y=panel->first;y<=panel->last;++y) {
+                int sy=row*16+y;
+                unsigned texY=indoorWallTexel((panel->row*16u+(unsigned)y)*profile->vPitch);
+                const uint8_t* strip=atlas+256u*texY;
+                for (int u=0;u<16;++u) {
+                    int sx=col*16+u;
+                    if (holeBuf[sy][sx]) continue;
+                    unsigned texX=indoorWallTexel((unsigned)(x*16+u)*5u);
+                    uint32_t* base=&texture[sy*v->stride+sx];
+                    *base=voxelShade(*base,2u*strip[texX]-256u);
+#ifdef __ANDROID__
+                    ++sampled;
+#endif
+                }
+            }
+        }
+    }
+#ifdef __ANDROID__
+    static const struct IndoorWallProfile* previous;
+    static unsigned draws;
+    if (previous!=profile) {
+        previous=profile;
+        draws=0;
+    }
+    if (sampled && !(draws++ & 255u))
+        __android_log_print(ANDROID_LOG_INFO,"pokedaisy",
+            "voxel indoor wall atlas crc=%08x map=%u/%u source=%ux%u target=%dx%d samples=%u",
+            solidRom,(unsigned)s->group,(unsigned)s->num,(unsigned)VOXEL_INDOOR_WALL_TEXTURE_SIZE,
+            (unsigned)VOXEL_INDOOR_WALL_TEXTURE_SIZE,v->width,v->height,sampled);
+#endif
+}
+#endif
