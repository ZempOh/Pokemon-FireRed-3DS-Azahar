+struct IndoorWallPanel { uint32_t columns; uint16_t word; uint8_t row, first, last; };
+struct IndoorWallProfile {
+    uint32_t rom, layout, primary, secondary;
+    uint8_t group, map, width, height, count, vPitch;
+    const struct IndoorWallPanel* panels;
+};
+static const struct IndoorWallPanel panels_modern_emerald[] = {
+    {0x000003d0u,0x0605u,0,8,15},
+    {0x000000d0u,0x060du,1,0,8},
+};
+static const struct IndoorWallPanel panels_seaglass[] = {
+    {0x000003d0u,0x0605u,0,8,15},
+    {0x000000d0u,0x060du,1,0,8},
+};
+static const struct IndoorWallPanel panels_better_emerald_2[] = {
+    {0x00001f37u,0x0738u,0,8,15},
+    {0x00000130u,0x0740u,1,0,7},
+};
+static const struct IndoorWallPanel panels_unbound[] = {
+    {0x00049249u,0x0468u,0,2,5},
+    {0x00092492u,0x049bu,0,2,5},
+    {0x00124924u,0x046au,0,2,5},
+};
+static const struct IndoorWallProfile indoorWallProfiles[] = {
+    {0x263a1187u,0x8c74f24u,0x8bb3c48u,0x8bb3f30u,2,0,10,9,2,9,panels_modern_emerald},
+    {0x14465a33u,0x8ae387cu,0x8a2e82cu,0x8a2eb14u,2,0,10,9,2,9,panels_seaglass},
+    {0x2be557a3u,0x842a8d4u,0x83df884u,0x83dfb6cu,11,10,13,8,2,9,panels_better_emerald_2},
+    {0x4b3d4957u,0x8731a50u,0x82d4bb4u,0x82d4c74u,4,8,21,11,3,17,panels_unbound},
+};
